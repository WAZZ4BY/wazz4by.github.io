---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerPageHeader from '../../components/InnerPageHeader.astro';
import IndexListRow from '../../components/IndexListRow.astro';
import { getVisibleProjects, getProjectHoverMedia } from '../../lib/projects';
import { getSiteSettings } from '../../lib/siteSettings';
import type { Project } from '../../lib/projects';

const base = import.meta.env.BASE_URL;
const { indexLayout } = getSiteSettings();
const isGroupedIndex = indexLayout === 'grouped';
const bodyClass = isGroupedIndex ? 'page-index page-index--grouped' : 'page-index';

const projectMediaById: Record<string, ReturnType<typeof getProjectHoverMedia>> = {};
for (const p of getVisibleProjects()) {
  projectMediaById[p.id] = getProjectHoverMedia(p);
}
const projectMediaJson = JSON.stringify(projectMediaById);

function getProjectSortTimestamp(project: { sortDate?: string; year?: string }) {
  const sortDate = String(project.sortDate || '').trim();
  if (/^\d{4}-\d{2}-\d{2}$/.test(sortDate)) {
    const ts = Date.parse(sortDate + 'T00:00:00Z');
    if (!Number.isNaN(ts)) return ts;
  }
  const year = parseInt(String(project.year || ''), 10) || 0;
  return Date.UTC(year, 0, 1);
}

const projects = getVisibleProjects()
  .slice()
  .sort((a, b) => {
    return getProjectSortTimestamp(b) - getProjectSortTimestamp(a); // newest first
  });

const participationProjects = projects.filter((p) => p.indexGroup === 'participation');
const conceptProjects = projects.filter((p) => p.indexGroup !== 'participation');

function splitProjectTitle(project: { title?: string; shortTitle?: string }) {
  const full = String(project.title || '').trim();
  const short = String(project.shortTitle || '').trim();
  let tail = '';
  if (short && full.toLowerCase().startsWith(short.toLowerCase())) {
    tail = full.slice(short.length);
  } else if (short && full !== short) {
    tail = full;
  }
  tail = tail.replace(/^[\s.:;\-—–]+/, '').trim();
  return { short: short || full, tail };
}

function rowProps(p: Project) {
  const titleParts = splitProjectTitle(p);
  return {
    href: `${base}project/${p.id}/`,
    year: p.year || '',
    sortDate: p.sortDate || '',
    cover: p.cover || '',
    projectId: p.id,
    indexGroup: (p.indexGroup === 'participation' ? 'participation' : 'concept') as 'participation' | 'concept',
    shortName: titleParts.short,
    tail: titleParts.tail,
    type: p.type || '',
  };
}
---

<BaseLayout title="Index" variant="inner" bodyClass={bodyClass} hideHeader>
  <div class="inner-page">
    <div id="indexHoverScatter" class="index-hover-scatter" aria-hidden="true"></div>
    <div class="index2__grid" data-index-layout={indexLayout}>
      <InnerPageHeader activePage="index" />
      {!isGroupedIndex && (
        <>
          <div class="name index-labels-name">Name</div>
          <div class="type index-labels-type">Type</div>
          <button type="button" class="year index-labels-year year-sort-btn" id="yearSort" aria-label="Сортировка по году">Year</button>
        </>
      )}
      <div class="index-list-wrap" id="indexListWrap">
        {isGroupedIndex ? (
          <>
            {participationProjects.length > 0 && (
              <section class="index-section index-section--participation">
                <div class="index-section__label">Participation</div>
                <div class="index-list" data-index-list>
                  {participationProjects.map((p) => <IndexListRow {...rowProps(p)} />)}
                </div>
              </section>
            )}
            {conceptProjects.length > 0 && (
              <section class="index-section index-section--concepts">
                <div class="index-section__label">Concepts</div>
                <div class="index-list" data-index-list>
                  {conceptProjects.map((p) => <IndexListRow {...rowProps(p)} />)}
                </div>
              </section>
            )}
          </>
        ) : (
          <div class="index-list" id="indexList" data-index-list>
            {projects.map((p) => <IndexListRow {...rowProps(p)} />)}
          </div>
        )}
        <div class="index-list-preview" id="indexListPreview" aria-hidden="true">
          <img id="indexListPreviewImg" alt="" />
        </div>
      </div>
      <div class="index-footer__schk"><a href="https://t.me/schtab_kvartira" target="_blank" rel="noopener noreferrer">SCHK</a></div>
      <p class="index-footer__text">The combination of robust classical typography with a clear vision of the path and experimental visualization is a true balance between chaotic trash art and an academic approach.</p>
      <div class="index-footer__name">Vasilii Aleev</div>
      <div class="index-footer__links"><a href="https://www.instagram.com/wazz4by" target="_blank" rel="noopener noreferrer">Ig</a><br/><a href="https://t.me/waz4by" target="_blank" rel="noopener noreferrer">Tg</a><br/><a href="https://www.behance.net/wazz4by/" target="_blank" rel="noopener noreferrer">Be</a></div>
    </div>
  </div>
  <script type="application/json" id="indexProjectMediaData" set:html={projectMediaJson} />
</BaseLayout>

<style>
  /* Index: 12 колонок, 4 ряда — шапка → Name/Type/Year → список → футер */
  :global(body.page-index .index2__grid) {
    display: grid;
    /* 1fr (не minmax(0,1fr)) — иначе кол. 11–12 сжимают имя/ссылки в футере */
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: auto auto 1fr auto;
    gap: 0 var(--grid-gutter);
    position: relative;
    flex: 1;
    min-height: calc(100vh - var(--page-header-height));
  }

  :global(body.page-index .inner-page) {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  :global(body.page-index .index2__grid .page-header) {
    grid-column: 1 / -1;
    grid-row: 1;
    z-index: 100;
  }
  :global(body.page-index .index2__grid .index-list-wrap) {
    grid-column: 1 / -1;
    grid-row: 3;
    display: grid;
    grid-template-columns: subgrid;
    align-content: start;
    position: relative;
    z-index: 0;
    padding-top: 0;
    padding-left: 0;
    padding-right: 0;
    min-height: 0;
    min-width: 0;
  }
  :global(body.page-index .index2__grid .index-list) {
    grid-column: 1 / -1;
    position: relative;
    z-index: 0;
    padding-top: 0;
    min-width: 0;
  }
  :global(body.page-index .index2__grid .index-list-preview) {
    position: absolute;
    left: calc(10 * (100% - 11 * var(--grid-gutter)) / 12 + 10 * var(--grid-gutter));
    width: calc(2 * (100% - 11 * var(--grid-gutter)) / 12 + var(--grid-gutter));
    max-height: 40vh;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
    opacity: 0;
  }
  :global(body.page-index .index2__grid .index-list-preview.index-list-preview--visible) {
    opacity: 1;
  }
  :global(body.page-index .index2__grid .index-list-preview img) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  /* Футер: кол. 1 — SCHK, 7–11 — текст (4–11 на узком), 11 — имя, 12 — ссылки */
  :global(body.page-index .index2__grid .index-footer__schk) {
    grid-column: 1;
    grid-row: 4;
    margin-top: 50px;
    margin-bottom: 30px;
    font-family: 'SuisseIntl', sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: black;
    line-height: 1;
  }
  :global(body.page-index .index2__grid .index-footer__schk a) {
    color: inherit;
    text-decoration: none;
  }
  :global(body.page-index .index2__grid .index-footer__text) {
    grid-column: 7 / 11;
    grid-row: 4;
    margin-top: 50px;
    margin-bottom: 30px;
    font-family: 'SuisseIntl', sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: black;
    opacity: 1;
    line-height: 1;
    min-width: 0;
  }
  :global(body.page-index .index2__grid .index-footer__name) {
    grid-column: 11;
    grid-row: 4;
    margin-top: 50px;
    margin-bottom: 30px;
    font-family: 'SuisseIntl', sans-serif;
    font-size: 16pt;
    font-weight: 500;
    color: black;
    line-height: 1;
    white-space: nowrap;
  }
  :global(body.page-index .index2__grid .index-footer__links) {
    grid-column: 12;
    grid-row: 4;
    margin-top: 50px;
    margin-bottom: 30px;
    font-family: 'SuisseIntl', sans-serif;
    font-size: 16pt;
    font-weight: 500;
    color: black;
    text-align: right;
    line-height: 1;
    white-space: nowrap;
  }

  /* Year — кол. 1, Name на одной линии с названиями (год 24px + отступ 20), Type — кол. 7 */
  :global(body.page-index .index2__grid .index-labels-name) {
    grid-column: 1;
    grid-row: 2;
    margin-top: 220px;
    /* transform, не margin — иначе колонка 1 раздувается и ломает футер */
    transform: translateX(calc(20px + 4.88em));
  }
  :global(body.page-index .index2__grid .index-labels-type) {
    grid-column: 7;
    grid-row: 2;
    margin-top: 220px;
  }
  :global(body.page-index .index2__grid .index-labels-year) {
    grid-column: 1;
    grid-row: 2;
    justify-self: start;
    margin-top: 220px;
  }

  .name, .type, .year,
  :global(body.page-index .index-section__label) {
    font-family: 'SuisseIntl', sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: black;
    opacity: 1;
  }

  /* Grouped: Participation / Concepts вместо Year Name Type */
  :global(body.page-index--grouped .index2__grid) {
    grid-template-rows: auto 1fr auto;
  }
  :global(body.page-index--grouped .index2__grid .index-list-wrap) {
    grid-row: 2;
  }
  :global(body.page-index--grouped .index2__grid .index-footer__schk),
  :global(body.page-index--grouped .index2__grid .index-footer__text),
  :global(body.page-index--grouped .index2__grid .index-footer__name),
  :global(body.page-index--grouped .index2__grid .index-footer__links) {
    grid-row: 3;
  }
  :global(body.page-index--grouped .index-section) {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-content: start;
  }
  :global(body.page-index--grouped .index-section__label) {
    grid-column: 1 / -1;
    line-height: 1;
    margin: 0;
  }
  :global(body.page-index--grouped .index-section--participation .index-section__label) {
    margin-top: 220px;
  }
  /* 15px margin-bottom у последней строки + 5px = 20px, как Year → список */
  :global(body.page-index--grouped .index-section--concepts) {
    margin-top: 5px;
  }
  /* Если Participation пуст — Concepts занимает место Year */
  :global(body.page-index--grouped .index-section--concepts:first-child .index-section__label) {
    margin-top: 220px;
  }
  :global(body.page-index--grouped .index-section--concepts:first-child) {
    margin-top: 0;
  }
  :global(body.page-index--grouped .index-list) {
    grid-column: 1 / -1;
  }

  .year {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-align: left;
  }
  .year:hover { opacity: 0.5; }

  :global(body.page-index .index-list) {
    display: grid;
    grid-template-columns: subgrid;
    align-content: start;
  }

  /* Те же 12 колонок, что у страницы: год в 1, название в 1–3, доп. имя в 4–6, тип в 7–9 */
  :global(body.page-index .index-list__row) {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: start;
    text-decoration: none;
    color:#B29893;
    min-width: 0;
    position: relative;
  }

  :global(body.page-index .index-list__lead) {
    grid-column: 1 / 4;
    display: flex;
    align-items: baseline;
    gap: 20px;
    width: max-content;
    max-width: none;
    min-width: max-content;
    white-space: nowrap;
    justify-self: start;
    z-index: 1;
  }
  :global(body.page-index .index-list__row .index-list__year) {
    flex: 0 0 auto;
    text-align: left;
    white-space: nowrap;
  }
  :global(body.page-index .index-list__row .index-list__name) {
    flex: 0 0 auto;
    white-space: nowrap;
  }
  :global(body.page-index .index-list__row .index-list__name-tail) {
    position: absolute;
    grid-column: 1 / -1;
    grid-row: 1;
    left: var(--index-tail-left, 0);
    width: var(--index-tail-width, auto);
    top: 0;
    min-width: 0;
    box-sizing: border-box;
    z-index: 0;
    pointer-events: none;
    white-space: nowrap;
    overflow: visible;
  }
  :global(body.page-index .index-list__row .index-list__type) {
    grid-column: 7 / 13;
    min-width: 0;
  }

  :global(body.page-index .index-list__row:hover) {
    color: black;
  }
  :global(body.page-index .index-list__row:hover .index-list__name),
  :global(body.page-index .index-list__row:hover .index-list__type),
  :global(body.page-index .index-list__row:hover .index-list__year) {
    color: black;
    opacity: 1;
  }

  :global(body.page-index .index-list__name),
  :global(body.page-index .index-list__name-tail),
  :global(body.page-index .index-list__type),
  :global(body.page-index .index-list__year) {
    font-family: 'SuisseIntl', sans-serif;
    font-size: 24px;
    font-weight: 500;
    line-height: 95%;
    padding-bottom: 0;
  }

  :global(body.page-index .index-list__type) {
    overflow-wrap: break-word;
    word-wrap: break-word;
  }

  :global(body.page-index .index-list__name) { text-align: left; }
  :global(body.page-index .index-list__name-tail) {
    opacity: 0.25;
    transition: opacity 0.05s ease;
  }
  :global(body.page-index .index-list__row:hover .index-list__name-tail) {
    opacity: 1;
  }
  :global(body.page-index .index-list__type) { text-align: left; }
  :global(body.page-index .index-list__year) { text-align: left; }

  :global(body.page-index .index-hover-scatter) {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }
  :global(body.page-index .index-hover-scatter__item) {
    position: fixed;
    width: var(--index-hover-col-w, 120px);
    max-width: min(
      var(--index-hover-col-w, 120px),
      calc((2 * (100vw - 11 * var(--grid-gutter, 20px)) / 12) + var(--grid-gutter, 20px))
    );
    max-height: 45vh;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    overflow: hidden;
  }
  :global(body.page-index .index-hover-scatter__item--ready) {
    visibility: visible;
    animation: index-hover-float-in 0.1s cubic-bezier(0.33, 0, 0.2, 1) forwards;
  }
  :global(body.page-index .index-hover-scatter__item--hiding) {
    visibility: visible;
    animation: none;
    transition: opacity 0.1s cubic-bezier(0.33, 0, 0.2, 1);
  }
  :global(body.page-index .index-hover-scatter__item img) {
    width: 100%;
    height: auto;
    max-height: 45vh;
    object-fit: contain;
    display: block;
  }
  :global(body.page-index .index-hover-scatter__item--video) {
    aspect-ratio: 16 / 9;
    height: auto;
  }
  :global(body.page-index .index-hover-scatter__item--video iframe),
  :global(body.page-index .index-hover-scatter__item--video video) {
    width: 100%;
    height: 100%;
    display: block;
    border: 0;
    object-fit: contain;
    background: #000;
  }
  @keyframes index-hover-float-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (max-width: 768px) {
    :global(body.page-index .index2__grid .page-header) {
      display: none;
    }

    :global(body.page-index .index2__grid .index-labels-type) {
      display: none;
    }

    :global(body.page-index .index2__grid .index-labels-name),
    :global(body.page-index .index2__grid .index-labels-year) {
      grid-column: 1;
      justify-self: start;
    }

    :global(body.page-index--grouped .index-section--participation .index-section__label),
    :global(body.page-index--grouped .index-section--concepts:first-child .index-section__label) {
      margin-top: 90px;
    }

    :global(body.page-index--grouped .index-section),
    :global(body.page-index .index2__grid .index-list-wrap),
    :global(body.page-index .index-list),
    :global(body.page-index .index-list__row) {
      display: flex;
      flex-direction: column;
      grid-template-columns: none;
    }

    :global(body.page-index .index-list),
    :global(body.page-index .index-list__row) {
      grid-column: auto;
      width: 100%;
    }

    :global(body.page-index .index-list__lead) {
      grid-column: 1;
      width: 100%;
      min-width: 0;
      max-width: 100%;
      white-space: normal;
    }

    :global(body.page-index .index-list__row .index-list__name) {
      flex: 1 1 auto;
      min-width: 0;
      white-space: normal;
    }

    :global(body.page-index .index-list__row .index-list__type),
    :global(body.page-index .index-list__row .index-list__name-tail) {
      display: none;
    }

    :global(body.page-index .index-list__row .index-list__year) {
      white-space: nowrap;
    }

    :global(body.page-index .index-hover-scatter),
    :global(body.page-index .index-list-preview) {
      display: none !important;
    }

    :global(body.page-index .index2__grid .index-footer__text) {
      grid-column: 4 / 11;
    }
  }
</style>

<script define:vars={{ base }}>
  (function () {
    const wrap = document.getElementById('indexListWrap');
    const lists = wrap ? wrap.querySelectorAll('[data-index-list]') : [];
    const list = lists[0] || document.getElementById('indexList');
    const yearBtn = document.getElementById('yearSort');
    const preview = document.getElementById('indexListPreview');
    const previewImg = document.getElementById('indexListPreviewImg');
    const scatterEl = document.getElementById('indexHoverScatter');
    const mediaDataEl = document.getElementById('indexProjectMediaData');
    const isGroupedIndex = document.body.classList.contains('page-index--grouped');
    if (!wrap || !list) return;
    if (!isGroupedIndex && !yearBtn) return;

    function isNarrowIndex() {
      return window.matchMedia('(max-width: 768px)').matches;
    }

    function getIndexRows() {
      return wrap.querySelectorAll('.index-list__row');
    }

    const INDEX_NAME_TAIL_GAP = 20;

    function getNameTextRight(el) {
      if (!el) return 0;
      if (!el.firstChild) return el.getBoundingClientRect().right;
      const range = document.createRange();
      range.selectNodeContents(el);
      const rect = range.getBoundingClientRect();
      range.detach();
      return rect.right || el.getBoundingClientRect().right;
    }

    // Укорачиваем хвост по одной букве справа, пока не влезет в maxWidth (без overflow-clip).
    function fitTailByChars(el, fullText, maxWidth) {
      if (!el) return;
      const full = fullText == null ? '' : String(fullText);
      if (maxWidth <= 0) {
        el.textContent = '';
        return;
      }
      el.textContent = full;
      if (el.scrollWidth <= maxWidth) return;

      let lo = 0;
      let hi = full.length;
      while (lo < hi) {
        const mid = (lo + hi + 1) >> 1;
        el.textContent = full.slice(0, mid);
        if (el.scrollWidth <= maxWidth) lo = mid;
        else hi = mid - 1;
      }
      el.textContent = full.slice(0, lo).replace(/\s+$/, '');
    }

    function syncIndexTailPosition() {
      const rows = getIndexRows();
      if (isNarrowIndex()) {
        rows.forEach(function (row) {
          row.style.removeProperty('--index-tail-left');
          row.style.removeProperty('--index-tail-width');
          const tail = row.querySelector('.index-list__name-tail');
          if (tail && tail.dataset.full != null) tail.textContent = tail.dataset.full;
        });
        return;
      }

      const wrapRect = wrap.getBoundingClientRect();
      const gutter =
        parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--grid-gutter')) || 20;
      const col = (wrapRect.width - 11 * gutter) / 12;
      const col4 = 3 * (col + gutter);
      const col7 = 6 * (col + gutter);

      // Едет вместе с 4-й колонкой; у каждой строки упор — правый край глифов её названия + 20.
      // Без смены режима: короткие названия просто раньше перестают ехать, длинные — позже.
      rows.forEach(function (row) {
        const nameEl = row.querySelector('.index-list__name');
        const tail = row.querySelector('.index-list__name-tail');
        const nameEndRel = getNameTextRight(nameEl) - wrapRect.left;
        const tailLeft = Math.max(col4, nameEndRel + INDEX_NAME_TAIL_GAP);
        const width = Math.max(0, col7 - tailLeft);
        const widthPx = Math.round(width);
        row.style.setProperty('--index-tail-left', Math.round(tailLeft) + 'px');
        row.style.setProperty('--index-tail-width', widthPx + 'px');
        if (tail) {
          const full = tail.dataset.full != null ? tail.dataset.full : (tail.textContent || '');
          if (tail.dataset.full == null) tail.dataset.full = full;
          fitTailByChars(tail, full, widthPx);
        }
      });
    }

    let projectMediaMap = {};
    if (mediaDataEl && mediaDataEl.textContent) {
      try {
        projectMediaMap = JSON.parse(mediaDataEl.textContent) || {};
      } catch (e) {
        projectMediaMap = {};
      }
    }

    function twoColumnsWidthPx() {
      const root = document.documentElement;
      const gutter = parseFloat(getComputedStyle(root).getPropertyValue('--grid-gutter')) || 20;
      const w = root.clientWidth || window.innerWidth;
      const col = (w - 11 * gutter) / 12;
      return Math.max(120, 2 * col + gutter);
    }

    function shuffle(arr) {
      const copy = arr.slice();
      for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        const t = copy[i];
        copy[i] = copy[j];
        copy[j] = t;
      }
      return copy;
    }

    function shufflePick(arr, n) {
      return shuffle(arr).slice(0, n);
    }

    function pickScatterMedia(items, count) {
      const videos = items.filter(function (item) { return item.type === 'video' || item.type === 'video-file'; });
      const images = items.filter(function (item) { return item.type === 'image'; });
      const picked = [];
      if (videos.length) {
        picked.push(shufflePick(videos, 1)[0]);
      }
      const imageCount = Math.max(0, count - picked.length);
      if (imageCount > 0 && images.length) {
        picked.push.apply(picked, shufflePick(images, Math.min(imageCount, images.length)));
      }
      return shuffle(picked);
    }

    function revealScatterItem(wrap) {
      if (!wrap || wrap.classList.contains('index-hover-scatter__item--ready')) return;
      if (wrap.classList.contains('index-hover-scatter__item--hiding')) return;
      wrap.classList.add('index-hover-scatter__item--ready');
    }

    function hideScatterItem(wrap) {
      if (wrap && wrap.parentNode) wrap.parentNode.removeChild(wrap);
    }

    function fadeOutScatterItem(wrap) {
      if (!wrap || !wrap.parentNode) return;
      if (wrap.classList.contains('index-hover-scatter__item--hiding')) return;
      const current = getComputedStyle(wrap).opacity;
      wrap.classList.remove('index-hover-scatter__item--ready');
      wrap.classList.add('index-hover-scatter__item--hiding');
      wrap.style.animation = 'none';
      wrap.style.visibility = 'visible';
      wrap.style.opacity = current;
      void wrap.offsetWidth;
      wrap.style.opacity = '0';
      wrap.addEventListener('transitionend', function onEnd(e) {
        if (e.propertyName && e.propertyName !== 'opacity') return;
        wrap.removeEventListener('transitionend', onEnd);
        hideScatterItem(wrap);
      });
    }

    function randomInt(a, b) {
      return a + Math.floor(Math.random() * (b - a + 1));
    }

    let scatterSession = null;
    const SCATTER_STAGGER_MS = 70;

    function hideScatter() {
      const session = scatterSession;
      scatterSession = null;
      if (!session) return;
      session.hiding = true;
      if (session.revealTimer) {
        clearTimeout(session.revealTimer);
        session.revealTimer = null;
      }
      if (session.hideTimer) {
        clearTimeout(session.hideTimer);
        session.hideTimer = null;
      }

      const toHide = [];
      session.wraps.forEach(function (wrap, i) {
        if (!wrap) return;
        if (session.revealed[i]) toHide.push(wrap);
        else hideScatterItem(wrap);
      });

      let i = 0;
      function hideNext() {
        if (i >= toHide.length) return;
        fadeOutScatterItem(toHide[i]);
        i++;
        if (i < toHide.length) {
          session.hideTimer = setTimeout(hideNext, SCATTER_STAGGER_MS);
        }
      }
      hideNext();
    }

    function revealScatterLoop(session) {
      if (!session || session.hiding) return;
      const idx = session.nextRevealIndex;
      if (idx >= session.wraps.length) return;
      if (!session.loaded[idx]) return;

      const wrap = session.wraps[idx];
      if (wrap && !session.revealed[idx]) {
        revealScatterItem(wrap);
        session.revealed[idx] = true;
      }
      session.nextRevealIndex++;

      if (session.nextRevealIndex < session.wraps.length) {
        session.revealTimer = setTimeout(function () {
          session.revealTimer = null;
          revealScatterLoop(session);
        }, SCATTER_STAGGER_MS);
      }
    }

    function onScatterItemLoaded(session, index) {
      if (!session || session.hiding) return;
      session.loaded[index] = true;
      if (session.revealTimer) return;
      if (index === session.nextRevealIndex) revealScatterLoop(session);
    }

    function extractIframeSrc(raw) {
      const s = String(raw || '').trim();
      const m = s.match(/<iframe[\s\S]*?src=["']([^"']+)["']/i);
      if (m && m[1]) return m[1].trim();
      return s;
    }

    function getHoverVideoSrc(embed) {
      let src = extractIframeSrc(embed);
      if (!src) return '';
      const vimeoPlayer = src.match(/player\.vimeo\.com\/video\/(\d+)/);
      if (vimeoPlayer) {
        return 'https://player.vimeo.com/video/' + vimeoPlayer[1] + '?background=1&autoplay=1&loop=1&muted=1&autopause=0&title=0&byline=0&portrait=0';
      }
      const vimeoPage = src.match(/vimeo\.com\/(?:video\/)?(\d+)/);
      if (vimeoPage) {
        return 'https://player.vimeo.com/video/' + vimeoPage[1] + '?background=1&autoplay=1&loop=1&muted=1&autopause=0&title=0&byline=0&portrait=0';
      }
      if (/kinescope\.(io|ru)\/embed\//.test(src)) {
        return src + (src.includes('?') ? '&' : '?') + 'autoplay=1&muted=1&loop=1';
      }
      return src;
    }

    function resolveImageUrl(src) {
      const path = String(src || '').replace(/^\//, '');
      if (!path) return '';
      const baseUrl = base.endsWith('/') ? base : base + '/';
      return /^https?:/i.test(path) ? path : baseUrl + path;
    }

    function showScatter(projectId) {
      if (isNarrowIndex()) return;
      if (!scatterEl) return;
      hideScatter();
      const items = projectMediaMap[projectId];
      if (!items || !items.length) return;
      const n = Math.min(items.length, randomInt(3, 6));
      const count = Math.max(1, n);
      const picked = pickScatterMedia(items, count);
      scatterSession = {
        nextRevealIndex: 0,
        revealTimer: null,
        hideTimer: null,
        hiding: false,
        loaded: new Array(picked.length).fill(false),
        revealed: new Array(picked.length).fill(false),
        wraps: new Array(picked.length).fill(null),
      };
      const session = scatterSession;
      const colW = twoColumnsWidthPx();
      document.documentElement.style.setProperty('--index-hover-col-w', colW + 'px');
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const pad = 10;
      const maxH = Math.min(vh * 0.45, colW * 3);
      const rangeX = Math.max(0, vw - colW - 2 * pad);
      const rangeY = Math.max(0, vh - maxH - 2 * pad);
      picked.forEach(function (item, index) {
        const wrap = document.createElement('div');
        wrap.className = 'index-hover-scatter__item' + ((item.type === 'video' || item.type === 'video-file') ? ' index-hover-scatter__item--video' : '');
        wrap.style.left = pad + Math.random() * rangeX + 'px';
        wrap.style.top = pad + Math.random() * rangeY + 'px';
        session.wraps[index] = wrap;
        scatterEl.appendChild(wrap);

        if (item.type === 'video') {
          const videoSrc = getHoverVideoSrc(item.embed);
          if (!videoSrc) {
            hideScatterItem(wrap);
            session.wraps[index] = null;
            session.loaded[index] = true;
            if (index === session.nextRevealIndex && !session.revealTimer) revealScatterLoop(session);
            return;
          }
          const iframe = document.createElement('iframe');
          iframe.src = videoSrc;
          iframe.setAttribute('frameborder', '0');
          iframe.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture');
          iframe.setAttribute('loading', 'eager');
          iframe.addEventListener('load', function () {
            onScatterItemLoaded(session, index);
          });
          iframe.addEventListener('error', function () {
            hideScatterItem(wrap);
            session.wraps[index] = null;
            session.loaded[index] = true;
            if (index === session.nextRevealIndex && !session.revealTimer) revealScatterLoop(session);
          });
          wrap.appendChild(iframe);
          return;
        }

        if (item.type === 'video-file') {
          const fileSrc = resolveImageUrl(item.src);
          if (!fileSrc) {
            hideScatterItem(wrap);
            session.wraps[index] = null;
            session.loaded[index] = true;
            if (index === session.nextRevealIndex && !session.revealTimer) revealScatterLoop(session);
            return;
          }
          const video = document.createElement('video');
          video.src = fileSrc;
          video.muted = true;
          video.loop = true;
          video.autoplay = true;
          video.playsInline = true;
          video.setAttribute('playsinline', '');
          video.preload = 'metadata';
          video.addEventListener('loadeddata', function () {
            onScatterItemLoaded(session, index);
          });
          video.addEventListener('error', function () {
            hideScatterItem(wrap);
            session.wraps[index] = null;
            session.loaded[index] = true;
            if (index === session.nextRevealIndex && !session.revealTimer) revealScatterLoop(session);
          });
          wrap.appendChild(video);
          return;
        }

        const img = document.createElement('img');
        img.alt = '';
        img.loading = 'eager';
        img.addEventListener('load', function () {
          onScatterItemLoaded(session, index);
        });
        img.addEventListener('error', function () {
          hideScatterItem(wrap);
          session.wraps[index] = null;
          session.loaded[index] = true;
          if (index === session.nextRevealIndex && !session.revealTimer) revealScatterLoop(session);
        });
        wrap.appendChild(img);
        img.src = resolveImageUrl(item.src);
        if (img.complete && img.naturalWidth > 0) onScatterItemLoaded(session, index);
      });
    }

    let newestFirst = true;

    function resolveCoverUrl(cover) {
      const c = (cover || '').trim();
      if (!c) return '';
      if (c.startsWith('http')) return c;
      return (base.endsWith('/') ? base : base + '/') + c.replace(/^\//, '');
    }

    function showPreview(url, row) {
      if (isNarrowIndex()) return;
      if (!preview || !previewImg) return;
      if (url && row) {
        const newTop = (row.getBoundingClientRect().top - wrap.getBoundingClientRect().top + wrap.scrollTop) + 'px';
        preview.style.top = newTop;
        previewImg.src = url;
        preview.classList.add('index-list-preview--visible');
        preview.setAttribute('aria-hidden', 'false');
      } else {
        preview.classList.remove('index-list-preview--visible');
        preview.setAttribute('aria-hidden', 'true');
        preview.style.top = '';
        previewImg.removeAttribute('src');
      }
    }

    getIndexRows().forEach(function (row) {
      row.addEventListener('mouseenter', function () {
        const cover = row.dataset.cover;
        showPreview(resolveCoverUrl(cover), row);
        const pid = row.dataset.projectId;
        if (pid) showScatter(pid);
      });
      row.addEventListener('mouseleave', function () {
        showPreview('');
        hideScatter();
      });
    });

    function sortRowsInList(targetList) {
      function getSortTimestamp(row) {
        const sortDate = String(row.dataset.sortDate || '').trim();
        if (/^\d{4}-\d{2}-\d{2}$/.test(sortDate)) {
          const ts = Date.parse(sortDate + 'T00:00:00Z');
          if (!Number.isNaN(ts)) return ts;
        }
        const y = parseInt(String(row.dataset.year || ''), 10) || 0;
        return Date.UTC(y, 0, 1);
      }

      const rows = Array.from(targetList.querySelectorAll('.index-list__row'));
      rows.sort(function (a, b) {
        const tA = getSortTimestamp(a);
        const tB = getSortTimestamp(b);
        if (newestFirst) return tB - tA;
        return tA - tB;
      });
      rows.forEach(function (row) { targetList.appendChild(row); });
    }

    function sortRows() {
      lists.forEach(function (targetList) {
        sortRowsInList(targetList);
      });
    }

    if (yearBtn) {
      yearBtn.addEventListener('click', function () {
        newestFirst = !newestFirst;
        sortRows();
        syncIndexTailPosition();
      });
    }

    if (!isGroupedIndex) sortRows();
    syncIndexTailPosition();
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(syncIndexTailPosition).catch(function () {});
    }

    window.addEventListener('resize', function () {
      if (isNarrowIndex()) {
        showPreview('');
        hideScatter();
      }
      syncIndexTailPosition();
    });
  })();
</script>
