---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerPageHeader from '../../components/InnerPageHeader.astro';
import { getVisibleProjects, getProjectHoverMedia } from '../../lib/projects';

const base = import.meta.env.BASE_URL;
const projectMediaById: Record<string, ReturnType<typeof getProjectHoverMedia>> = {};
for (const p of getVisibleProjects()) {
  projectMediaById[p.id] = getProjectHoverMedia(p);
}
const projectMediaJson = JSON.stringify(projectMediaById);

function getProjectSortTimestamp(project: { sortDate?: string; year?: string }) {
  const sortDate = String(project.sortDate || '').trim();
  if (/^\d{4}-\d{2}-\d{2}$/.test(sortDate)) {
    const ts = Date.parse(sortDate + 'T00:00:00Z');
    if (!Number.isNaN(ts)) return ts;
  }
  const year = parseInt(String(project.year || ''), 10) || 0;
  return Date.UTC(year, 0, 1);
}

const projects = getVisibleProjects()
  .slice()
  .sort((a, b) => {
    return getProjectSortTimestamp(b) - getProjectSortTimestamp(a); // newest first
  });

function splitProjectTitle(project: { title?: string; shortTitle?: string }) {
  const full = String(project.title || '').trim();
  const short = String(project.shortTitle || '').trim();
  if (!short) return { short: full, tail: '' };
  const fullLower = full.toLowerCase();
  const shortLower = short.toLowerCase();
  if (fullLower.startsWith(shortLower)) {
    return { short, tail: full.slice(short.length) };
  }
  if (full === short) return { short, tail: '' };
  return { short, tail: ' ' + full };
}
---

<BaseLayout title="Index" variant="inner" bodyClass="page-index" hideHeader>
  <div class="inner-page">
    <div id="indexHoverScatter" class="index-hover-scatter" aria-hidden="true"></div>
    <div class="index2__grid">
      <InnerPageHeader activePage="index" />
      <div class="name index-labels-name">Name</div>
      <div class="type index-labels-type">Type</div>
      <button type="button" class="year index-labels-year year-sort-btn" id="yearSort" aria-label="Сортировка по году">Year</button>
      <div class="index-list-wrap">
        <div class="index-list" id="indexList">
          {projects.map((p) => {
            const titleParts = splitProjectTitle(p);
            return (
              <a href={`${base}project/${p.id}/`} class="index-list__row" data-year={p.year || ''} data-sort-date={p.sortDate || ''} data-cover={p.cover || ''} data-project-id={p.id}>
                <span class="index-list__name">
                  <span class="index-list__name-short">{titleParts.short}</span><span class="index-list__name-tail">{titleParts.tail}</span>
                </span>
                <span class="index-list__type">{p.type || ''}</span>
                <span class="index-list__year">{p.year || ''}</span>
              </a>
            );
          })}
        </div>
        <div class="index-list-preview" id="indexListPreview" aria-hidden="true">
          <img id="indexListPreviewImg" alt="" />
        </div>
      </div>
      <div class="index-footer__schk"><a href="https://t.me/schtab_kvartira" target="_blank" rel="noopener noreferrer">SCHK</a></div>
      <p class="index-footer__text">The combination of robust classical typography with a clear vision of the path and experimental visualization is a true balance between chaotic trash art and an academic approach.</p>
      <div class="index-footer__name">Vasilii Aleev</div>
      <div class="index-footer__links"><a href="https://www.instagram.com/wazz4by" target="_blank" rel="noopener noreferrer">Ig</a><br/><a href="https://t.me/waz4by" target="_blank" rel="noopener noreferrer">Tg</a><br/><a href="https://www.behance.net/wazz4by/" target="_blank" rel="noopener noreferrer">Be</a></div>
    </div>
  </div>
  <script type="application/json" id="indexProjectMediaData" set:html={projectMediaJson} />
</BaseLayout>

<style>
  /* Index: 12 колонок, 4 ряда — шапка → Name/Type/Year → список → футер */
  :global(body.page-index .index2__grid) {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: auto auto 1fr auto;
    gap: 0 var(--grid-gutter);
    position: relative;
    flex: 1;
    min-height: calc(100vh - var(--page-header-height));
  }

  :global(body.page-index .inner-page) {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  :global(body.page-index .index2__grid .page-header) {
    grid-column: 1 / -1;
    grid-row: 1;
    z-index: 100;
  }
  :global(body.page-index .index2__grid .index-list-wrap) {
    grid-column: 1 / -1;
    grid-row: 3;
    position: relative;
    z-index: 0;
    padding-top: 0;
    padding-left: 0;
    padding-right: 0;
    min-height: 0;
  }
  :global(body.page-index .index2__grid .index-list) {
    position: relative;
    z-index: 0;
    padding-top: 0;
  }
  :global(body.page-index .index2__grid .index-list-preview) {
    position: absolute;
    left: calc(4 * (100% - 11 * var(--grid-gutter)) / 12 + 4 * var(--grid-gutter));
    width: calc(2 * (100% - 11 * var(--grid-gutter)) / 12 + var(--grid-gutter));
    max-height: 40vh;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
    opacity: 0;
  }
  :global(body.page-index .index2__grid .index-list-preview.index-list-preview--visible) {
    opacity: 1;
  }
  :global(body.page-index .index2__grid .index-list-preview img) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  /* Футер как на странице проекта: кол. 1 — SCHK, 7–11 — текст, 11 — имя, 12 — ссылки */
  :global(body.page-index .index2__grid .index-footer__schk) {
    grid-column: 1;
    grid-row: 4;
    margin-top: 50px;
    margin-bottom: 30px;
    font-family: 'SuisseIntl', sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: black;
    line-height: 1;
  }
  :global(body.page-index .index2__grid .index-footer__schk a) {
    color: inherit;
    text-decoration: none;
  }
  :global(body.page-index .index2__grid .index-footer__text) {
    grid-column: 7 / 11;
    grid-row: 4;
    margin-top: 50px;
    margin-bottom: 30px;
    font-family: 'SuisseIntl', sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: black;
    opacity: 1;
    line-height: 1;
  }
  :global(body.page-index .index2__grid .index-footer__name) {
    grid-column: 11;
    grid-row: 4;
    margin-top: 50px;
    margin-bottom: 30px;
    font-family: 'SuisseIntl', sans-serif;
    font-size: 16pt;
    font-weight: 500;
    color: black;
    line-height: 1;
  }
  :global(body.page-index .index2__grid .index-footer__links) {
    grid-column: 12;
    grid-row: 4;
    margin-top: 50px;
    margin-bottom: 30px;
    font-family: 'SuisseIntl', sans-serif;
    font-size: 16pt;
    font-weight: 500;
    color: black;
    text-align: right;
    line-height: 1;
  }

  /* Name, Type, Year — одна строка (row 2), разные колонки */
  :global(body.page-index .index2__grid .index-labels-name) {
    grid-column: 1;
    grid-row: 2;
    margin-top: 220px;
  }
  :global(body.page-index .index2__grid .index-labels-type) {
    grid-column: 7;
    grid-row: 2;
    margin-top: 220px;
  }
  :global(body.page-index .index2__grid .index-labels-year) {
    grid-column: 12;
    grid-row: 2;
    justify-self: end;
    margin-top: 220px;
  }

  .name, .type, .year {
    font-family: 'SuisseIntl', sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: black;
    opacity: 1;
  }

  .year {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-align: right;
  }
  .year:hover { opacity: 0.5; }

  :global(body.page-index .index-list) {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* 12 колонок как у страницы (Name 1, Type 7, Year 12) */
  :global(body.page-index .index-list__row) {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 0 var(--grid-gutter);
    align-items: start;
    text-decoration: none;
    color:#B29893;
  }

  :global(body.page-index .index-list__row .index-list__name) { grid-column: 1 / 7; }
  :global(body.page-index .index-list__row .index-list__type) { grid-column: 7 / 12; }
  :global(body.page-index .index-list__row .index-list__year) { grid-column: 12; text-align: right; }

  :global(body.page-index .index-list__row:hover) {
    color: black;
  }
  :global(body.page-index .index-list__row:hover .index-list__name),
  :global(body.page-index .index-list__row:hover .index-list__type),
  :global(body.page-index .index-list__row:hover .index-list__year) {
    color: black;
    opacity: 1;
  }

  :global(body.page-index .index-list__name),
  :global(body.page-index .index-list__type),
  :global(body.page-index .index-list__year) {
    font-family: 'SuisseIntl', sans-serif;
    font-size: 24px;
    font-weight: 500;
    line-height: 75%;
    word-wrap: break-word;
    padding-bottom: 0;
  }

  :global(body.page-index .index-list__name) { text-align: left; }
  :global(body.page-index .index-list__name .index-list__name-tail) {
    opacity: 0.25;
    transition: opacity 0.05s ease;
  }
  :global(body.page-index .index-list__row:hover .index-list__name .index-list__name-tail) {
    opacity: 1;
  }
  :global(body.page-index .index-list__type) { text-align: left; }
  :global(body.page-index .index-list__year) { text-align: right; }

  :global(body.page-index .index-hover-scatter) {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }
  :global(body.page-index .index-hover-scatter__item) {
    position: fixed;
    width: var(--index-hover-col-w, 120px);
    max-width: min(
      var(--index-hover-col-w, 120px),
      calc((2 * (100vw - 11 * var(--grid-gutter, 20px)) / 12) + var(--grid-gutter, 20px))
    );
    max-height: 45vh;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    overflow: hidden;
  }
  :global(body.page-index .index-hover-scatter__item--ready) {
    visibility: visible;
    animation: index-hover-float-in 0.1s cubic-bezier(0.33, 0, 0.2, 1) forwards;
  }
  :global(body.page-index .index-hover-scatter__item--hiding) {
    visibility: visible;
    animation: none;
    transition: opacity 0.1s cubic-bezier(0.33, 0, 0.2, 1);
  }
  :global(body.page-index .index-hover-scatter__item img) {
    width: 100%;
    height: auto;
    max-height: 45vh;
    object-fit: contain;
    display: block;
  }
  :global(body.page-index .index-hover-scatter__item--video) {
    aspect-ratio: 16 / 9;
    height: auto;
  }
  :global(body.page-index .index-hover-scatter__item--video iframe) {
    width: 100%;
    height: 100%;
    display: block;
    border: 0;
  }
  @keyframes index-hover-float-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (max-width: 768px) {
    :global(body.page-index .index2__grid .page-header) {
      display: none;
    }
  }
</style>

<script define:vars={{ base }}>
  (function () {
    const list = document.getElementById('indexList');
    const yearBtn = document.getElementById('yearSort');
    const preview = document.getElementById('indexListPreview');
    const previewImg = document.getElementById('indexListPreviewImg');
    const scatterEl = document.getElementById('indexHoverScatter');
    const mediaDataEl = document.getElementById('indexProjectMediaData');
    if (!list || !yearBtn) return;

    let projectMediaMap = {};
    if (mediaDataEl && mediaDataEl.textContent) {
      try {
        projectMediaMap = JSON.parse(mediaDataEl.textContent) || {};
      } catch (e) {
        projectMediaMap = {};
      }
    }

    function twoColumnsWidthPx() {
      const root = document.documentElement;
      const gutter = parseFloat(getComputedStyle(root).getPropertyValue('--grid-gutter')) || 20;
      const w = root.clientWidth || window.innerWidth;
      const col = (w - 11 * gutter) / 12;
      return Math.max(120, 2 * col + gutter);
    }

    function shuffle(arr) {
      const copy = arr.slice();
      for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        const t = copy[i];
        copy[i] = copy[j];
        copy[j] = t;
      }
      return copy;
    }

    function shufflePick(arr, n) {
      return shuffle(arr).slice(0, n);
    }

    function pickScatterMedia(items, count) {
      const videos = items.filter(function (item) { return item.type === 'video'; });
      const images = items.filter(function (item) { return item.type === 'image'; });
      const picked = [];
      if (videos.length) {
        picked.push(shufflePick(videos, 1)[0]);
      }
      const imageCount = Math.max(0, count - picked.length);
      if (imageCount > 0 && images.length) {
        picked.push.apply(picked, shufflePick(images, Math.min(imageCount, images.length)));
      }
      return shuffle(picked);
    }

    function revealScatterItem(wrap) {
      if (!wrap || wrap.classList.contains('index-hover-scatter__item--ready')) return;
      if (wrap.classList.contains('index-hover-scatter__item--hiding')) return;
      wrap.classList.add('index-hover-scatter__item--ready');
    }

    function hideScatterItem(wrap) {
      if (wrap && wrap.parentNode) wrap.parentNode.removeChild(wrap);
    }

    function fadeOutScatterItem(wrap) {
      if (!wrap || !wrap.parentNode) return;
      if (wrap.classList.contains('index-hover-scatter__item--hiding')) return;
      const current = getComputedStyle(wrap).opacity;
      wrap.classList.remove('index-hover-scatter__item--ready');
      wrap.classList.add('index-hover-scatter__item--hiding');
      wrap.style.animation = 'none';
      wrap.style.visibility = 'visible';
      wrap.style.opacity = current;
      void wrap.offsetWidth;
      wrap.style.opacity = '0';
      wrap.addEventListener('transitionend', function onEnd(e) {
        if (e.propertyName && e.propertyName !== 'opacity') return;
        wrap.removeEventListener('transitionend', onEnd);
        hideScatterItem(wrap);
      });
    }

    function randomInt(a, b) {
      return a + Math.floor(Math.random() * (b - a + 1));
    }

    let scatterSession = null;
    const SCATTER_STAGGER_MS = 70;

    function hideScatter() {
      const session = scatterSession;
      scatterSession = null;
      if (!session) return;
      session.hiding = true;
      if (session.revealTimer) {
        clearTimeout(session.revealTimer);
        session.revealTimer = null;
      }
      if (session.hideTimer) {
        clearTimeout(session.hideTimer);
        session.hideTimer = null;
      }

      const toHide = [];
      session.wraps.forEach(function (wrap, i) {
        if (!wrap) return;
        if (session.revealed[i]) toHide.push(wrap);
        else hideScatterItem(wrap);
      });

      let i = 0;
      function hideNext() {
        if (i >= toHide.length) return;
        fadeOutScatterItem(toHide[i]);
        i++;
        if (i < toHide.length) {
          session.hideTimer = setTimeout(hideNext, SCATTER_STAGGER_MS);
        }
      }
      hideNext();
    }

    function revealScatterLoop(session) {
      if (!session || session.hiding) return;
      const idx = session.nextRevealIndex;
      if (idx >= session.wraps.length) return;
      if (!session.loaded[idx]) return;

      const wrap = session.wraps[idx];
      if (wrap && !session.revealed[idx]) {
        revealScatterItem(wrap);
        session.revealed[idx] = true;
      }
      session.nextRevealIndex++;

      if (session.nextRevealIndex < session.wraps.length) {
        session.revealTimer = setTimeout(function () {
          session.revealTimer = null;
          revealScatterLoop(session);
        }, SCATTER_STAGGER_MS);
      }
    }

    function onScatterItemLoaded(session, index) {
      if (!session || session.hiding) return;
      session.loaded[index] = true;
      if (session.revealTimer) return;
      if (index === session.nextRevealIndex) revealScatterLoop(session);
    }

    function extractIframeSrc(raw) {
      const s = String(raw || '').trim();
      const m = s.match(/<iframe[\s\S]*?src=["']([^"']+)["']/i);
      if (m && m[1]) return m[1].trim();
      return s;
    }

    function getHoverVideoSrc(embed) {
      let src = extractIframeSrc(embed);
      if (!src) return '';
      const vimeoPlayer = src.match(/player\.vimeo\.com\/video\/(\d+)/);
      if (vimeoPlayer) {
        return 'https://player.vimeo.com/video/' + vimeoPlayer[1] + '?background=1&autoplay=1&loop=1&muted=1&autopause=0&title=0&byline=0&portrait=0';
      }
      const vimeoPage = src.match(/vimeo\.com\/(?:video\/)?(\d+)/);
      if (vimeoPage) {
        return 'https://player.vimeo.com/video/' + vimeoPage[1] + '?background=1&autoplay=1&loop=1&muted=1&autopause=0&title=0&byline=0&portrait=0';
      }
      if (/kinescope\.(io|ru)\/embed\//.test(src)) {
        return src + (src.includes('?') ? '&' : '?') + 'autoplay=1&muted=1&loop=1';
      }
      return src;
    }

    function resolveImageUrl(src) {
      const path = String(src || '').replace(/^\//, '');
      if (!path) return '';
      const baseUrl = base.endsWith('/') ? base : base + '/';
      return /^https?:/i.test(path) ? path : baseUrl + path;
    }

    function showScatter(projectId) {
      if (!scatterEl) return;
      hideScatter();
      const items = projectMediaMap[projectId];
      if (!items || !items.length) return;
      const n = Math.min(items.length, randomInt(3, 6));
      const count = Math.max(1, n);
      const picked = pickScatterMedia(items, count);
      scatterSession = {
        nextRevealIndex: 0,
        revealTimer: null,
        hideTimer: null,
        hiding: false,
        loaded: new Array(picked.length).fill(false),
        revealed: new Array(picked.length).fill(false),
        wraps: new Array(picked.length).fill(null),
      };
      const session = scatterSession;
      const colW = twoColumnsWidthPx();
      document.documentElement.style.setProperty('--index-hover-col-w', colW + 'px');
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const pad = 10;
      const maxH = Math.min(vh * 0.45, colW * 3);
      const rangeX = Math.max(0, vw - colW - 2 * pad);
      const rangeY = Math.max(0, vh - maxH - 2 * pad);
      picked.forEach(function (item, index) {
        const wrap = document.createElement('div');
        wrap.className = 'index-hover-scatter__item' + (item.type === 'video' ? ' index-hover-scatter__item--video' : '');
        wrap.style.left = pad + Math.random() * rangeX + 'px';
        wrap.style.top = pad + Math.random() * rangeY + 'px';
        session.wraps[index] = wrap;
        scatterEl.appendChild(wrap);

        if (item.type === 'video') {
          const videoSrc = getHoverVideoSrc(item.embed);
          if (!videoSrc) {
            hideScatterItem(wrap);
            session.wraps[index] = null;
            session.loaded[index] = true;
            if (index === session.nextRevealIndex && !session.revealTimer) revealScatterLoop(session);
            return;
          }
          const iframe = document.createElement('iframe');
          iframe.src = videoSrc;
          iframe.setAttribute('frameborder', '0');
          iframe.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture');
          iframe.setAttribute('loading', 'eager');
          iframe.addEventListener('load', function () {
            onScatterItemLoaded(session, index);
          });
          iframe.addEventListener('error', function () {
            hideScatterItem(wrap);
            session.wraps[index] = null;
            session.loaded[index] = true;
            if (index === session.nextRevealIndex && !session.revealTimer) revealScatterLoop(session);
          });
          wrap.appendChild(iframe);
          return;
        }

        const img = document.createElement('img');
        img.alt = '';
        img.loading = 'eager';
        img.addEventListener('load', function () {
          onScatterItemLoaded(session, index);
        });
        img.addEventListener('error', function () {
          hideScatterItem(wrap);
          session.wraps[index] = null;
          session.loaded[index] = true;
          if (index === session.nextRevealIndex && !session.revealTimer) revealScatterLoop(session);
        });
        wrap.appendChild(img);
        img.src = resolveImageUrl(item.src);
        if (img.complete && img.naturalWidth > 0) onScatterItemLoaded(session, index);
      });
    }

    let newestFirst = true;

    function resolveCoverUrl(cover) {
      const c = (cover || '').trim();
      if (!c) return '';
      if (c.startsWith('http')) return c;
      return (base.endsWith('/') ? base : base + '/') + c.replace(/^\//, '');
    }

    function showPreview(url, row) {
      if (!preview || !previewImg) return;
      if (url && row) {
        const wrap = list.parentElement;
        const newTop = wrap ? (row.getBoundingClientRect().top - wrap.getBoundingClientRect().top + wrap.scrollTop) + 'px' : '';
        preview.style.top = newTop;
        previewImg.src = url;
        preview.classList.add('index-list-preview--visible');
        preview.setAttribute('aria-hidden', 'false');
      } else {
        preview.classList.remove('index-list-preview--visible');
        preview.setAttribute('aria-hidden', 'true');
        preview.style.top = '';
        previewImg.removeAttribute('src');
      }
    }

    list.querySelectorAll('.index-list__row').forEach(function (row) {
      row.addEventListener('mouseenter', function () {
        const cover = row.dataset.cover;
        showPreview(resolveCoverUrl(cover), row);
        const pid = row.dataset.projectId;
        if (pid) showScatter(pid);
      });
      row.addEventListener('mouseleave', function () {
        showPreview('');
        hideScatter();
      });
    });

    function sortRows() {
      function getSortTimestamp(row) {
        const sortDate = String(row.dataset.sortDate || '').trim();
        if (/^\d{4}-\d{2}-\d{2}$/.test(sortDate)) {
          const ts = Date.parse(sortDate + 'T00:00:00Z');
          if (!Number.isNaN(ts)) return ts;
        }
        const y = parseInt(String(row.dataset.year || ''), 10) || 0;
        return Date.UTC(y, 0, 1);
      }

      const rows = Array.from(list.querySelectorAll('.index-list__row'));
      rows.sort(function (a, b) {
        const tA = getSortTimestamp(a);
        const tB = getSortTimestamp(b);
        if (newestFirst) return tB - tA;
        return tA - tB;
      });
      rows.forEach(function (row) { list.appendChild(row); });
    }

    yearBtn.addEventListener('click', function () {
      newestFirst = !newestFirst;
      sortRows();
    });

    sortRows();
  })();
</script>
