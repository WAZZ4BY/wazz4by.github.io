        function getResearchScreenPreviewMediaHtml(entry) {
          const src = entry && entry.src ? entry.src : '';
          const as = entry && entry.as ? entry.as : researchMediaAsFromSrc(src);
          if (!src) return '<span class="research-admin-site__cell-empty">пусто</span>';
          if (as === 'video') {
            return '<video src="' + esc(src) + '" muted playsinline loop autoplay preload="metadata"></video>';
