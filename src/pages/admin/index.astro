---
import AdminLayout from '../../layouts/AdminLayout.astro';
const base = import.meta.env.BASE_URL;
---

<AdminLayout title="Админка — Проекты">
  <div id="admin-root">
    <div id="gate" class="gate">
      <h1>Вход в админку</h1>
      <input type="password" id="password" placeholder="Пароль" autocomplete="current-password" />
      <button type="button" id="loginBtn" class="primary">Войти</button>
      <p id="gateError" class="error" style="display:none;"></p>
    </div>

    <div id="app" style="display:none;">
      <h1>Управление проектами</h1>
      <p id="loadStatus" class="status">Загрузка…</p>
      <div id="adminNav" style="display:flex;flex-wrap:wrap;gap:0.5rem;margin:0.75rem 0 1rem;">
        <button type="button" class="secondary admin-nav-btn" data-pane="projectsPane">Проекты</button>
        <button type="button" class="secondary admin-nav-btn" data-pane="homeCardsPane">Главная: Media Cards</button>
        <button type="button" class="secondary admin-nav-btn" data-pane="researchCardsPane">Research</button>
        <button type="button" class="secondary admin-nav-btn" data-pane="githubPane">GitHub</button>
        <button type="button" class="secondary admin-nav-btn" data-pane="backupPane">Резервная копия</button>
      </div>

      <section class="admin-section admin-pane" id="projectsPane">
        <h2>Список проектов</h2>
        <ul class="project-list" id="projectList"></ul>
        <p class="mb-2"><a href={`${base}admin/add/`}>+ Добавить проект</a></p>
      </section>

      <section class="admin-section admin-pane" id="homeCardsPane">
        <h2>Фото на главной (Media Cards)</h2>
        <p class="admin-hint">Управление карточками на главной странице. Можно загружать фото в репозиторий (папка <code>public/images/main</code>) и сразу подставлять путь в карточку. Для режима <code>vimeo</code> вставляйте iframe/embed или ссылку Vimeo, для <code>kinescope</code> — iframe/embed или ссылку Kinescope.</p>
        <p id="homeMediaCardsLoadStatus" class="status">Загрузка…</p>
        <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;margin-bottom:0.75rem;">
          <button type="button" id="homeViewEditorBtn" class="primary">Редактор</button>
          <button type="button" id="homeViewLayoutBtn" class="secondary">Раскладка</button>
          <button type="button" id="homeViewPreviewBtn" class="secondary">Превью главной</button>
        </div>
        <div id="homeMediaCardsLayout" style="display:none;"></div>
        <div id="homeMediaCardsPreview" style="display:none;"></div>
        <div id="homeMediaCardsEditor"></div>
        <div id="homeMediaCardsActions" style="margin-top:1rem;">
          <button type="button" id="addHomeMediaCardBtn" class="secondary">+ Добавить карточку</button>
          <button type="button" id="saveHomeMediaCardsToGitHubBtn" class="primary" style="margin-left:0.5rem;">Сохранить карточки в GitHub</button>
          <button type="button" id="downloadHomeMediaCardsBtn" class="secondary" style="margin-left:0.5rem;">Скачать home-media-cards.json</button>
        </div>
        <p id="homeMediaCardsGhStatus" class="status"></p>
      </section>

      <section class="admin-section admin-section--wide admin-pane" id="researchCardsPane">
        <h2>Карточки Research</h2>
        <p class="admin-hint">Сетка 5 — основной просмотр и редактирование. Лента — вертикальный предпросмотр как на сайте (название слева, медиа по центру, дата справа). Список — компактное редактирование. Для <code>image</code> указывайте путь к <code>webp</code> или <code>gif</code>. Для видео вставляйте ссылку или iframe. Доп. фото показываются справа на странице карточки. Макс. ширина — 4 или 6 колонок в центре ленты. Карточки сортируются по номеру: от меньшего к большему.</p>
        <p id="researchCardsLoadStatus" class="status">Загрузка…</p>
        <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;margin-bottom:0.75rem;">
          <button type="button" id="addResearchCardBtn" class="secondary">+ Добавить карточку</button>
          <button type="button" id="researchViewGridBtn" class="primary">Сетка 5</button>
          <button type="button" id="researchViewListBtn" class="secondary">Список</button>
          <button type="button" id="researchViewPreviewBtn" class="secondary">Лента</button>
          <span id="researchCardScaleWrap" style="display:flex;gap:0.5rem;align-items:center;margin-left:0.5rem;">
            <label for="researchCardScaleRange" style="margin:0;font-weight:500;">Масштаб карточек</label>
            <input type="range" id="researchCardScaleRange" min="70" max="140" step="5" value="100" style="width:170px;margin:0;" />
            <span id="researchCardScaleValue" style="min-width:3ch;">100%</span>
          </span>
        </div>
        <div id="researchCardsEditor"></div>
        <div style="margin-top:1rem;">
          <button type="button" id="saveResearchCardsToGitHubBtn" class="primary">Сохранить карточки в GitHub</button>
          <button type="button" id="downloadResearchCardsBtn" class="secondary" style="margin-left:0.5rem;">Скачать research-cards.json</button>
        </div>
        <p id="researchCardsGhStatus" class="status"></p>
      </section>

      <section class="admin-section admin-pane" id="githubPane">
        <h2>Сохранение в GitHub</h2>
        <p>Чтобы изменения автоматически попадали в репозиторий, укажите репозиторий и токен. После нажатия «Сохранить в GitHub» файл <code>public/data/projects.json</code> будет закоммичен в ветку <code>main</code>; деплой выполнит GitHub Actions.</p>
        <label>Репозиторий (owner/repo)</label>
        <input type="text" id="ghRepo" placeholder="wazz4by/wazz4by.github.io" />
        <label>GitHub Personal Access Token (права repo)</label>
        <input type="password" id="ghToken" placeholder="ghp_xxxx…" autocomplete="off" />
        <button type="button" id="saveToGitHubBtn" class="primary">Сохранить в GitHub</button>
        <p id="ghStatus" class="status"></p>
      </section>

      <section class="admin-section admin-pane" id="backupPane">
        <h2>Резервная копия</h2>
        <p>Скачайте <code>projects.json</code> и при необходимости замените им файл в репозитории вручную.</p>
        <button type="button" id="downloadBtn" class="secondary">Скачать projects.json</button>
      </section>
    </div>
  </div>

  <script define:vars={{ base }}>
    (function () {
      const STORAGE_KEY = 'admin_authed';
      const PASSWORD = 'admin12345';
      const REPO_KEY = 'admin_gh_repo';

      const gate = document.getElementById('gate');
      const app = document.getElementById('app');
      const passwordInput = document.getElementById('password');
      const gateError = document.getElementById('gateError');
      const loginBtn = document.getElementById('loginBtn');

      function checkAuth() {
        if (sessionStorage.getItem(STORAGE_KEY) === '1') {
          gate.style.display = 'none';
          app.style.display = 'block';
          initApp();
          return;
        }
        gate.style.display = 'block';
        app.style.display = 'none';
      }

      loginBtn.addEventListener('click', function () {
        gateError.style.display = 'none';
        if (passwordInput.value === PASSWORD) {
          sessionStorage.setItem(STORAGE_KEY, '1');
          checkAuth();
        } else {
          gateError.textContent = 'Неверный пароль.';
          gateError.style.display = 'block';
        }
      });

      passwordInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') loginBtn.click();
      });

      document.querySelector('.admin-page__back')?.addEventListener('click', function(){});
      const ADMIN_PANES = ['projectsPane', 'homeCardsPane', 'researchCardsPane', 'githubPane', 'backupPane'];
      let adminNavInitialized = false;

      function setActivePane(paneId) {
        const target = ADMIN_PANES.includes(paneId) ? paneId : 'projectsPane';
        ADMIN_PANES.forEach(function (id) {
          const pane = document.getElementById(id);
          if (pane) pane.style.display = id === target ? 'block' : 'none';
        });
        document.querySelectorAll('.admin-nav-btn').forEach(function (btn) {
          const isActive = btn.getAttribute('data-pane') === target;
          btn.className = isActive ? 'primary admin-nav-btn' : 'secondary admin-nav-btn';
        });
      }

      function initAdminNav() {
        if (adminNavInitialized) return;
        adminNavInitialized = true;
        document.querySelectorAll('.admin-nav-btn').forEach(function (btn) {
          btn.addEventListener('click', function () {
            setActivePane(this.getAttribute('data-pane') || 'projectsPane');
          });
        });
      }

      let projects = [];
      let homeMediaCards = [];
      let homeMediaCardsView = 'editor';
      let draggedHomeIndex = null;
      let researchCards = [];
      let researchCardsView = 'grid';
      let researchCardsScale = 100;
      let draggedResearchIndex = null;

      const HOME_MEDIA_RATIOS = [
        'aspect-16-9',
        'aspect-4-5',
        'aspect-3-4',
        'aspect-1-1',
        'aspect-original',
        'aspect-free'
      ];

      function dataUrl() {
        const path = window.location.pathname;
        const basePath = path.replace(/\/admin\/?.*$/, '') || '/';
        return (basePath.endsWith('/') ? basePath : basePath + '/') + 'data/projects.json';
      }

      function dataUrlHomeMediaCards() {
        const path = window.location.pathname;
        const basePath = path.replace(/\/admin\/?.*$/, '') || '/';
        return (basePath.endsWith('/') ? basePath : basePath + '/') + 'data/home-media-cards.json';
      }

      function dataUrlResearchCards() {
        const path = window.location.pathname;
        const basePath = path.replace(/\/admin\/?.*$/, '') || '/';
        return (basePath.endsWith('/') ? basePath : basePath + '/') + 'data/research-cards.json';
      }

      async function loadProjects() {
        const status = document.getElementById('loadStatus');
        try {
          const res = await fetch(dataUrl(), { cache: 'no-store' });
          if (!res.ok) throw new Error(res.statusText);
          projects = await res.json();
          if (!Array.isArray(projects)) projects = [];
          const newProjectRaw = sessionStorage.getItem('admin_new_project');
          if (newProjectRaw) {
            try {
              const newProject = JSON.parse(newProjectRaw);
              if (newProject.id && !projects.find(p => p.id === newProject.id)) projects.push(newProject);
              sessionStorage.removeItem('admin_new_project');
            } catch (_) {}
          }
          const editedRaw = sessionStorage.getItem('admin_edited_projects');
          if (editedRaw) {
            try {
              const edited = JSON.parse(editedRaw);
              Object.keys(edited).forEach(function (id) {
                const idx = projects.findIndex(p => p.id === id);
                if (idx >= 0) projects[idx] = edited[id];
              });
            } catch (_) {}
          }
          projects = projects.map(rewriteProjectImagePaths);
          status.textContent = 'Загружено проектов: ' + projects.length + ' (скрытых: ' + projects.filter(function (p) { return p.hidden; }).length + ')';
          status.className = 'status ok';
          renderProjectList();
          restoreGhRepo();
          return projects;
        } catch (e) {
          status.textContent = 'Ошибка загрузки: ' + e.message;
          status.className = 'status err';
          projects = [];
          return [];
        }
      }

      function getBase() {
        const path = window.location.pathname;
        const basePath = path.replace(/\/admin\/?.*$/, '') || '/';
        return basePath.endsWith('/') ? basePath : basePath + '/';
      }

      function setEditedProject(id, data) {
        try {
          const editedRaw = sessionStorage.getItem('admin_edited_projects');
          const edited = editedRaw ? JSON.parse(editedRaw) : {};
          edited[id] = data;
          sessionStorage.setItem('admin_edited_projects', JSON.stringify(edited));
        } catch (_) {}
      }

      function renderProjectList() {
        const list = document.getElementById('projectList');
        list.innerHTML = '';
        projects.forEach(function (p) {
          const li = document.createElement('li');
          if (p.hidden) li.className = 'project-list__item--hidden';
          const base = getBase();
          const hiddenBadge = p.hidden ? '<span class="project-list__badge">скрыт</span>' : '';
          const toggleLabel = p.hidden ? 'Показать' : 'Скрыть';
          li.innerHTML =
            '<span class="project-list__title"><span>' + (p.title || p.id) + '</span>' + hiddenBadge + '</span>' +
            '<span class="project-list__actions">' +
              '<a href="' + base + 'admin/edit/?id=' + encodeURIComponent(p.id) + '">Редактировать</a>' +
              '<button type="button" class="secondary toggle-project-hidden" data-id="' + p.id + '" style="padding:0.25rem 0.5rem;font-size:0.85rem;">' + toggleLabel + '</button>' +
              '<button type="button" class="danger delete-project" data-id="' + p.id + '" style="padding:0.25rem 0.5rem;font-size:0.85rem;">Удалить</button>' +
            '</span>';
          list.appendChild(li);
        });
        list.querySelectorAll('.toggle-project-hidden').forEach(function (btn) {
          btn.addEventListener('click', function () {
            const id = this.getAttribute('data-id');
            const p = projects.find(function (x) { return x.id === id; });
            if (!p) return;
            const willHide = !p.hidden;
            const action = willHide ? 'скрыть' : 'показать';
            if (!confirm((willHide ? 'Скрыть' : 'Показать') + ' проект «' + (p.title || id) + '» на сайте?')) return;
            p.hidden = willHide;
            if (!willHide) delete p.hidden;
            setEditedProject(id, p);
            renderProjectList();
            document.getElementById('loadStatus').textContent = 'Проект будет ' + (willHide ? 'скрыт' : 'показан') + ' после сохранения в GitHub. Скрытых: ' + projects.filter(function (x) { return x.hidden; }).length + '.';
          });
        });
        list.querySelectorAll('.delete-project').forEach(function (btn) {
          btn.addEventListener('click', function () {
            const id = this.getAttribute('data-id');
            const p = projects.find(function (x) { return x.id === id; });
            if (!p || !confirm('Удалить проект «' + (p.title || id) + '»?')) return;
            projects = projects.filter(function (x) { return x.id !== id; });
            renderProjectList();
            document.getElementById('loadStatus').textContent = 'Проект удалён из списка. Нажмите «Сохранить в GitHub» или скачайте projects.json.';
          });
        });
      }

      function restoreGhRepo() {
        try {
          const saved = sessionStorage.getItem(REPO_KEY);
          if (saved && document.getElementById('ghRepo')) document.getElementById('ghRepo').value = saved;
        } catch (_) {}
      }

      function normalizeHomeMediaCard(card) {
        const c = card || {};
        const ratio = HOME_MEDIA_RATIOS.includes(c.ratio) ? c.ratio : 'aspect-16-9';
        const as = c.as === 'video' || c.as === 'vimeo' || c.as === 'kinescope' ? c.as : 'image';
        const src = typeof c.src === 'string' ? c.src : '';
        return {
          href: typeof c.href === 'string' ? c.href : '/index/',
          src: as === 'image' ? toWebpPath(src) : src,
          alt: typeof c.alt === 'string' ? c.alt : '',
          ratio: ratio,
          as: as,
          size: c.size === 'wide' ? 'wide' : 'normal',
          edge: c.edge === 'left' || c.edge === 'right' ? c.edge : 'auto'
        };
      }

      function parseResearchSideSrcs(c, keepEmpty) {
        const out = [];
        function push(item) {
          if (typeof item !== 'string') return;
          const trimmed = item.trim();
          if (!keepEmpty && !trimmed) return;
          out.push(trimmed ? toWebpPath(trimmed) : '');
        }
        if (c && Array.isArray(c.sideSrcs)) c.sideSrcs.forEach(push);
        else if (c && typeof c.sideSrc === 'string') push(c.sideSrc);
        return out;
      }

      function parseResearchLinks(c, keepEmpty) {
        const out = [];
        function push(item) {
          const rec = item && typeof item === 'object' ? item : {};
          const text = typeof rec.text === 'string' ? rec.text : '';
          const url = typeof rec.url === 'string' ? rec.url : '';
          if (!keepEmpty && !text.trim() && !url.trim()) return;
          out.push({ text: text, url: url });
        }
        if (c && Array.isArray(c.links)) c.links.forEach(push);
        if (keepEmpty && out.length === 0) out.push({ text: '', url: '' });
        return out;
      }

      function normalizeResearchCard(card, fallbackNumber, keepEmptyExtras) {
        const c = card || {};
        const parsedNumber = Number(c.number);
        const rawDate = typeof c.date === 'string' ? c.date : '';
        const m = rawDate.trim().match(/^(\d{1,2})[.\-/](\d{4})$/);
        const normalizedDate = m ? String(m[1]).padStart(2, '0') + '.' + m[2] : '';
        const as = c.as === 'kinescope' ? 'kinescope' : 'image';
        const src = typeof c.src === 'string' ? c.src : '';
        return {
          number: Number.isFinite(parsedNumber) ? Math.max(0, Math.round(parsedNumber)) : fallbackNumber,
          src: as === 'image' ? toWebpPath(src) : src,
          alt: typeof c.alt === 'string' ? c.alt : '',
          as: as,
          caption: typeof c.caption === 'string' ? c.caption : '',
          date: normalizedDate,
          text: typeof c.text === 'string' ? c.text : '',
          links: parseResearchLinks(c, keepEmptyExtras),
          sideSrcs: parseResearchSideSrcs(c, keepEmptyExtras),
          spanW: Number(c.spanW) === 6 ? 6 : 4
        };
      }

      function sortResearchCards() {
        researchCards.sort(function (a, b) {
          return Number(a.number || 0) - Number(b.number || 0);
        });
      }

      function reindexResearchCards() {
        researchCards.forEach(function (card, index) {
          card.number = index + 1;
        });
      }

      function moveResearchCard(fromIndex, toIndex) {
        if (!Number.isFinite(fromIndex) || !Number.isFinite(toIndex)) return;
        if (fromIndex < 0 || toIndex < 0) return;
        if (fromIndex >= researchCards.length || toIndex >= researchCards.length) return;
        if (fromIndex === toIndex) return;
        const moved = researchCards.splice(fromIndex, 1)[0];
        researchCards.splice(toIndex, 0, moved);
        reindexResearchCards();
        renderResearchCardsEditor();
        const status = document.getElementById('researchCardsLoadStatus');
        if (status) status.textContent = 'Порядок обновлён. Карточек: ' + researchCards.length;
      }

      function syncResearchViewButtons() {
        const listBtn = document.getElementById('researchViewListBtn');
        const gridBtn = document.getElementById('researchViewGridBtn');
        const previewBtn = document.getElementById('researchViewPreviewBtn');
        const scaleWrap = document.getElementById('researchCardScaleWrap');
        if (listBtn) listBtn.className = researchCardsView === 'list' ? 'primary' : 'secondary';
        if (gridBtn) gridBtn.className = researchCardsView === 'grid' ? 'primary' : 'secondary';
        if (previewBtn) previewBtn.className = researchCardsView === 'preview' ? 'primary' : 'secondary';
        if (scaleWrap) scaleWrap.style.display = researchCardsView === 'grid' ? 'flex' : 'none';
      }

      function syncResearchScaleUi() {
        const range = document.getElementById('researchCardScaleRange');
        const label = document.getElementById('researchCardScaleValue');
        if (range) range.value = String(researchCardsScale);
        if (label) label.textContent = String(researchCardsScale) + '%';
      }

      async function loadHomeMediaCards() {
        const status = document.getElementById('homeMediaCardsLoadStatus');
        try {
          const res = await fetch(dataUrlHomeMediaCards(), { cache: 'no-store' });
          if (!res.ok) throw new Error(res.statusText);
          const data = await res.json();
          const arr = Array.isArray(data) ? data : data.cards;
          homeMediaCards = Array.isArray(arr) ? arr.slice(0, 30).map(normalizeHomeMediaCard) : [];
          status.textContent = 'Загружено карточек: ' + homeMediaCards.length;
          status.className = 'status ok';
          renderHomeMediaCardsEditor();
          return homeMediaCards;
        } catch (e) {
          homeMediaCards = [];
          status.textContent = 'Файл не найден или пустой. Добавьте карточки.';
          status.className = 'status';
          renderHomeMediaCardsEditor();
          return homeMediaCards;
        }
      }

      async function loadResearchCards() {
        const status = document.getElementById('researchCardsLoadStatus');
        try {
          const res = await fetch(dataUrlResearchCards(), { cache: 'no-store' });
          if (!res.ok) throw new Error(res.statusText);
          const data = await res.json();
          const arr = Array.isArray(data) ? data : data.cards;
          researchCards = Array.isArray(arr)
            ? arr.slice(0, 100).map(function (card, i) { return normalizeResearchCard(card, i + 1); })
            : [];
          sortResearchCards();
          status.textContent = 'Загружено карточек: ' + researchCards.length;
          status.className = 'status ok';
          renderResearchCardsEditor();
          return researchCards;
        } catch (e) {
          researchCards = [];
          status.textContent = 'Файл не найден или пустой. Добавьте карточки.';
          status.className = 'status';
          renderResearchCardsEditor();
          return researchCards;
        }
      }

      function esc(s) {
        return String(s || '')
          .replace(/&/g, '&amp;')
          .replace(/"/g, '&quot;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;');
      }

      function toWebpPath(url) {
        const u = String(url || '').trim();
        if (!u || u.indexOf('<') !== -1 || /^https?:\/\//i.test(u)) return u;
        return u.replace(/\.(png|jpe?g)(\?.*)?$/i, '.webp$2');
      }

      function rewriteProjectImagePaths(project) {
        if (!project || typeof project !== 'object') return project;
        const next = Object.assign({}, project);
        if (typeof next.cover === 'string') next.cover = toWebpPath(next.cover);
        if (Array.isArray(next.images)) next.images = next.images.map(toWebpPath);
        if (Array.isArray(next.contentBlocks)) {
          next.contentBlocks = next.contentBlocks.map(function (block) {
            if (!block || typeof block !== 'object') return block;
            const b = Object.assign({}, block);
            if (typeof b.src === 'string') b.src = toWebpPath(b.src);
            if (typeof b.left === 'string') b.left = toWebpPath(b.left);
            if (typeof b.right === 'string') b.right = toWebpPath(b.right);
            return b;
          });
        }
        return next;
      }

      function extractIframeSrc(raw) {
        const s = String(raw || '').trim();
        const m = s.match(/<iframe[\s\S]*?src=["']([^"']+)["']/i);
        if (m && m[1]) return m[1].trim();
        return s;
      }

      function getVimeoEmbedUrl(raw) {
        const s = extractIframeSrc(raw);
        if (!s) return '';
        const direct = s.match(/player\.vimeo\.com\/video\/(\d+)/);
        if (direct) return s;
        const page = s.match(/vimeo\.com\/(?:video\/)?(\d+)/);
        if (page) return 'https://player.vimeo.com/video/' + page[1] + '?background=1&autoplay=1&loop=1&muted=1';
        return s;
      }

      function getKinescopeEmbedUrl(raw, withAutoplay) {
        const s = extractIframeSrc(raw);
        if (!s) return '';
        let url = s;
        if (!/kinescope\.(io|ru)\/embed\//.test(s)) {
          const m = s.match(/https?:\/\/(?:kinescope\.(?:io|ru))\/([^/?#]+)/);
          if (m && m[1]) url = 'https://kinescope.io/embed/' + m[1];
        }
        try {
          const u = new URL(url);
          if (withAutoplay) {
            u.searchParams.set('autoplay', '1');
            u.searchParams.set('muted', '1');
          } else {
            u.searchParams.set('autoplay', '0');
            u.searchParams.delete('muted');
            u.searchParams.delete('mute');
          }
          return u.toString();
        } catch (_) {
          return url;
        }
      }

      function gridColumnForHomeCard(card) {
        const isWide = card && card.size === 'wide';
        if (card && card.edge === 'left') return isWide ? '1 / span 6' : '1 / span 4';
        if (card && card.edge === 'right') return isWide ? '7 / span 6' : '9 / span 4';
        return isWide ? 'span 6' : 'span 4';
      }

      function projectTitleFromHref(href) {
        const value = typeof href === 'string' ? href.trim() : '';
        if (!value) return '';
        const match = value.match(/\/project\/([^/]+)\/?$/);
        if (!match) return '';
        const id = decodeURIComponent(match[1]);
        const p = projects.find(function (x) { return x.id === id; });
        return (p && (p.title || p.shortTitle)) || '';
      }

      function getHomePreviewCardMediaHtml(card) {
        const item = normalizeHomeMediaCard(card);
        const src = item.src || '';
        const ratio = HOME_MEDIA_RATIOS.includes(item.ratio) ? item.ratio : 'aspect-16-9';
        const thumbClass = 'home-admin-preview__thumb ' + ratio;
        if (!src) {
          return '<div class="' + thumbClass + '" style="display:flex;align-items:center;justify-content:center;min-height:120px;"><span style="font-size:12px;color:#999;">Нет src</span></div>';
        }
        if (item.as === 'vimeo') {
          return '<div class="' + thumbClass + '"><iframe class="home-admin-preview__media home-admin-preview__embed" src="' + esc(getVimeoEmbedUrl(src)) + '" title="Vimeo" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe></div>';
        }
        if (item.as === 'kinescope') {
          return '<div class="' + thumbClass + '"><iframe class="home-admin-preview__media home-admin-preview__embed" data-src="' + esc(getKinescopeEmbedUrl(src, true)) + '" title="Kinescope" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe></div>';
        }
        if (item.as === 'video') {
          return '<div class="' + thumbClass + '"><video class="home-admin-preview__media" src="' + esc(src) + '" muted playsinline loop autoplay preload="metadata"></video></div>';
        }
        return '<div class="' + thumbClass + '"><img class="home-admin-preview__media" src="' + esc(src) + '" alt="' + esc(item.alt || '') + '" loading="lazy" decoding="async" /></div>';
      }

      function refreshHomeMediaCardsVisualViews() {
        if (homeMediaCardsView === 'preview') renderHomeMediaCardsPreview();
        if (homeMediaCardsView === 'layout') renderHomeMediaCardsLayout();
      }

      function moveHomeCard(fromIndex, toIndex) {
        if (!Number.isFinite(fromIndex) || !Number.isFinite(toIndex)) return;
        if (fromIndex < 0 || toIndex < 0) return;
        if (fromIndex >= homeMediaCards.length || toIndex >= homeMediaCards.length) return;
        if (fromIndex === toIndex) return;
        const moved = homeMediaCards.splice(fromIndex, 1)[0];
        homeMediaCards.splice(toIndex, 0, moved);
        if (homeMediaCardsView === 'editor') renderHomeMediaCardsEditor();
        else refreshHomeMediaCardsVisualViews();
        const status = document.getElementById('homeMediaCardsLoadStatus');
        if (status) status.textContent = 'Карточек: ' + homeMediaCards.length + ' (порядок обновлён)';
      }

      function setHomeCardEdge(index, edge) {
        if (!homeMediaCards[index]) return;
        homeMediaCards[index].edge = edge === 'left' || edge === 'right' ? edge : 'auto';
        refreshHomeMediaCardsVisualViews();
      }

      function setHomeCardSize(index, size) {
        if (!homeMediaCards[index]) return;
        homeMediaCards[index].size = size === 'wide' ? 'wide' : 'normal';
        refreshHomeMediaCardsVisualViews();
      }

      function syncHomeMediaCardsView() {
        const editorEl = document.getElementById('homeMediaCardsEditor');
        const previewEl = document.getElementById('homeMediaCardsPreview');
        const layoutEl = document.getElementById('homeMediaCardsLayout');
        const pane = document.getElementById('homeCardsPane');
        const editorBtn = document.getElementById('homeViewEditorBtn');
        const layoutBtn = document.getElementById('homeViewLayoutBtn');
        const previewBtn = document.getElementById('homeViewPreviewBtn');
        const view = homeMediaCardsView;
        if (editorEl) editorEl.style.display = view === 'editor' ? 'block' : 'none';
        if (previewEl) previewEl.style.display = view === 'preview' ? 'block' : 'none';
        if (layoutEl) layoutEl.style.display = view === 'layout' ? 'block' : 'none';
        if (pane) pane.classList.toggle('admin-section--wide', view === 'preview' || view === 'layout');
        if (editorBtn) editorBtn.className = view === 'editor' ? 'primary' : 'secondary';
        if (layoutBtn) layoutBtn.className = view === 'layout' ? 'primary' : 'secondary';
        if (previewBtn) previewBtn.className = view === 'preview' ? 'primary' : 'secondary';
        refreshHomeMediaCardsVisualViews();
      }

      function renderHomeMediaCardsPreview() {
        const container = document.getElementById('homeMediaCardsPreview');
        if (!container) return;
        if (!homeMediaCards.length) {
          container.innerHTML = '<div class="home-admin-preview"><div class="home-admin-preview__empty">Добавьте карточки в редакторе</div></div>';
          return;
        }
        const items = homeMediaCards.map(function (card, i) {
          const item = normalizeHomeMediaCard(card);
          const col = gridColumnForHomeCard(item);
          const label = projectTitleFromHref(item.href);
          const meta = label ? '<div style="padding:0.35rem 0.5rem;font-size:11px;color:#666;background:#fff;border-top:1px solid #eee;">' + esc(label) + '</div>' : '';
          return (
            '<div class="home-admin-preview__item" style="--home-card-col:' + col + ';" title="Карточка ' + (i + 1) + '">' +
              '<div class="home-admin-preview__card">' +
                getHomePreviewCardMediaHtml(item) +
                meta +
              '</div>' +
            '</div>'
          );
        }).join('');
        container.innerHTML =
          '<div class="home-admin-preview">' +
            '<div class="home-admin-preview__label">Превью сетки главной (12 колонок, как на сайте)</div>' +
            '<div class="home-admin-preview__stage">' +
              '<div class="home-admin-preview__grid">' + items + '</div>' +
            '</div>' +
          '</div>';
        hydrateLazyIframes(container);
      }

      function edgeToSnapPercent(edge) {
        if (edge === 'left') return 0;
        if (edge === 'right') return 100;
        return 50;
      }

      function snapPercentToEdge(pct) {
        if (pct <= 25) return 'left';
        if (pct >= 75) return 'right';
        return 'auto';
      }

      function bindHomeLayoutInteractions(container) {
        container.querySelectorAll('.home-admin-layout__item').forEach(function (row) {
          const i = parseInt(row.getAttribute('data-i'), 10);
          row.addEventListener('mousedown', function (e) {
            const interactive = e.target.closest('button, .home-admin-layout__resize-handle, .home-admin-layout__snap-track');
            row.setAttribute('draggable', interactive ? 'false' : 'true');
          });
          row.addEventListener('mouseup', function () {
            row.setAttribute('draggable', 'true');
          });
          row.addEventListener('dragstart', function (e) {
            if (e.target.closest('button, .home-admin-layout__resize-handle, .home-admin-layout__snap-track')) {
              e.preventDefault();
              return;
            }
            draggedHomeIndex = i;
            row.classList.add('home-admin-layout__item--dragging');
            if (e.dataTransfer) {
              e.dataTransfer.effectAllowed = 'move';
              e.dataTransfer.setData('text/plain', String(i));
            }
          });
          row.addEventListener('dragover', function (e) {
            e.preventDefault();
            row.classList.add('home-admin-layout__item--over');
          });
          row.addEventListener('dragleave', function () {
            row.classList.remove('home-admin-layout__item--over');
          });
          row.addEventListener('drop', function (e) {
            e.preventDefault();
            row.classList.remove('home-admin-layout__item--over');
            const from = Number.isFinite(draggedHomeIndex)
              ? draggedHomeIndex
              : parseInt(e.dataTransfer?.getData('text/plain') || '', 10);
            moveHomeCard(from, i);
          });
          row.addEventListener('dragend', function () {
            draggedHomeIndex = null;
            row.classList.remove('home-admin-layout__item--dragging', 'home-admin-layout__item--over');
          });
        });

        container.querySelectorAll('.home-layout-edge-btn').forEach(function (btn) {
          btn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            const i = parseInt(this.getAttribute('data-i'), 10);
            const edge = this.getAttribute('data-edge') || 'auto';
            setHomeCardEdge(i, edge);
          });
        });

        container.querySelectorAll('.home-layout-size-btn').forEach(function (btn) {
          btn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            const i = parseInt(this.getAttribute('data-i'), 10);
            const size = this.getAttribute('data-size') || 'normal';
            setHomeCardSize(i, size);
          });
        });

        container.querySelectorAll('.home-layout-delete').forEach(function (btn) {
          btn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            const i = parseInt(this.getAttribute('data-i'), 10);
            homeMediaCards.splice(i, 1);
            if (homeMediaCardsView === 'editor') renderHomeMediaCardsEditor();
            else renderHomeMediaCardsLayout();
            document.getElementById('homeMediaCardsLoadStatus').textContent = 'Карточек: ' + homeMediaCards.length;
          });
        });

        container.querySelectorAll('.home-admin-layout__snap-track').forEach(function (track) {
          const i = parseInt(track.getAttribute('data-i'), 10);
          const thumb = track.querySelector('.home-admin-layout__snap-thumb');
          const cardEl = track.closest('.home-admin-layout__item');

          function applyEdgeVisual(edge) {
            const edges = ['left', 'auto', 'right'];
            track.querySelectorAll('.home-admin-layout__snap-zone').forEach(function (zone, zi) {
              zone.classList.toggle('is-active', edges[zi] === edge);
            });
            container.querySelectorAll('.home-layout-edge-btn[data-i="' + i + '"]').forEach(function (btn) {
              btn.classList.toggle('is-active', btn.getAttribute('data-edge') === edge);
            });
            const edgeLabel = edge === 'left' ? 'Слева' : edge === 'right' ? 'Справа' : 'Авто';
            const badge = cardEl && cardEl.querySelector('.home-admin-layout__badge');
            if (badge && homeMediaCards[i]) {
              const sizeLabel = homeMediaCards[i].size === 'wide' ? '6 кол.' : '4 кол.';
              badge.textContent = sizeLabel + ' · ' + edgeLabel;
            }
            if (cardEl && homeMediaCards[i]) {
              cardEl.style.setProperty('--home-card-col', gridColumnForHomeCard(Object.assign({}, homeMediaCards[i], { edge: edge })));
            }
          }

          function updateFromClientX(clientX, finalize) {
            const rect = track.getBoundingClientRect();
            const pct = Math.max(0, Math.min(100, ((clientX - rect.left) / rect.width) * 100));
            if (thumb) thumb.style.left = pct + '%';
            const edge = snapPercentToEdge(pct);
            if (homeMediaCards[i]) homeMediaCards[i].edge = edge;
            applyEdgeVisual(edge);
            if (finalize) renderHomeMediaCardsLayout();
          }

          track.addEventListener('mousedown', function (e) {
            e.preventDefault();
            track.classList.add('is-dragging');
            updateFromClientX(e.clientX, false);
            function onMove(ev) { updateFromClientX(ev.clientX, false); }
            function onUp(ev) {
              track.classList.remove('is-dragging');
              updateFromClientX(ev.clientX, true);
              document.removeEventListener('mousemove', onMove);
              document.removeEventListener('mouseup', onUp);
            }
            document.addEventListener('mousemove', onMove);
            document.addEventListener('mouseup', onUp);
          });
        });

        container.querySelectorAll('.home-admin-layout__resize-handle').forEach(function (handle) {
          const i = parseInt(handle.getAttribute('data-i'), 10);
          const cardEl = handle.closest('.home-admin-layout__item');
          handle.addEventListener('mousedown', function (e) {
            e.preventDefault();
            e.stopPropagation();
            const startX = e.clientX;
            const startSize = homeMediaCards[i] && homeMediaCards[i].size === 'wide' ? 'wide' : 'normal';
            handle.classList.add('is-active');

            function applySizeVisual(size) {
              if (!homeMediaCards[i]) return;
              homeMediaCards[i].size = size;
              if (cardEl) cardEl.style.setProperty('--home-card-col', gridColumnForHomeCard(homeMediaCards[i]));
              const badge = cardEl && cardEl.querySelector('.home-admin-layout__badge');
              const edge = homeMediaCards[i].edge === 'left' || homeMediaCards[i].edge === 'right' ? homeMediaCards[i].edge : 'auto';
              const edgeLabel = edge === 'left' ? 'Слева' : edge === 'right' ? 'Справа' : 'Авто';
              if (badge) badge.textContent = (size === 'wide' ? '6 кол.' : '4 кол.') + ' · ' + edgeLabel;
              container.querySelectorAll('.home-layout-size-btn[data-i="' + i + '"]').forEach(function (btn) {
                btn.classList.toggle('is-active', btn.getAttribute('data-size') === size);
              });
            }

            function onMove(ev) {
              const dx = ev.clientX - startX;
              if (dx > 36) applySizeVisual('wide');
              if (dx < -36) applySizeVisual('normal');
            }
            function onUp() {
              handle.classList.remove('is-active');
              renderHomeMediaCardsLayout();
              document.removeEventListener('mousemove', onMove);
              document.removeEventListener('mouseup', onUp);
            }
            document.addEventListener('mousemove', onMove);
            document.addEventListener('mouseup', onUp);
          });
        });
      }

      function renderHomeMediaCardsLayout() {
        const container = document.getElementById('homeMediaCardsLayout');
        if (!container || homeMediaCardsView !== 'layout') return;
        if (!homeMediaCards.length) {
          container.innerHTML = '<div class="home-admin-layout"><div class="home-admin-preview__empty">Добавьте карточки в редакторе</div></div>';
          return;
        }

        const guides = Array.from({ length: 12 }, function (_, n) {
          return '<span class="home-admin-layout__guide" aria-hidden="true"></span>';
        }).join('');

        const items = homeMediaCards.map(function (card, i) {
          const item = normalizeHomeMediaCard(card);
          const col = gridColumnForHomeCard(item);
          const label = projectTitleFromHref(item.href) || ('Карточка ' + (i + 1));
          const edge = item.edge === 'left' || item.edge === 'right' ? item.edge : 'auto';
          const isWide = item.size === 'wide';
          const snapPct = edgeToSnapPercent(edge);
          const edgeLabel = edge === 'left' ? 'Слева' : edge === 'right' ? 'Справа' : 'Авто';
          const sizeLabel = isWide ? '6 кол.' : '4 кол.';

          return (
            '<div class="home-admin-layout__item" data-i="' + i + '" draggable="true" style="--home-card-col:' + col + ';">' +
              '<div class="home-admin-layout__card">' +
                '<div class="home-admin-layout__toolbar">' +
                  '<span class="home-admin-layout__grip" title="Перетащите для смены порядка">↕</span>' +
                  '<span class="home-admin-layout__num">#' + (i + 1) + '</span>' +
                  '<span class="home-admin-layout__meta">' + esc(label) + '</span>' +
                  '<span class="home-admin-layout__badge">' + esc(sizeLabel) + ' · ' + esc(edgeLabel) + '</span>' +
                  '<button type="button" class="danger home-layout-delete" data-i="' + i + '" title="Удалить">×</button>' +
                '</div>' +
                '<div class="home-admin-layout__media-wrap">' +
                  getHomePreviewCardMediaHtml(item) +
                  '<div class="home-admin-layout__resize-handle" data-i="' + i + '" title="Тяните вправо/влево для ширины 4 или 6 колонок"></div>' +
                '</div>' +
                '<div class="home-admin-layout__controls">' +
                  '<div class="home-admin-layout__control-group">' +
                    '<span class="home-admin-layout__control-label">Ширина</span>' +
                    '<button type="button" class="home-layout-size-btn' + (isWide ? '' : ' is-active') + '" data-i="' + i + '" data-size="normal">4</button>' +
                    '<button type="button" class="home-layout-size-btn' + (isWide ? ' is-active' : '') + '" data-i="' + i + '" data-size="wide">6</button>' +
                  '</div>' +
                  '<div class="home-admin-layout__control-group home-admin-layout__control-group--snap">' +
                    '<span class="home-admin-layout__control-label">Край</span>' +
                    '<div class="home-admin-layout__snap-track" data-i="' + i + '">' +
                      '<div class="home-admin-layout__snap-zones">' +
                        '<span class="home-admin-layout__snap-zone' + (edge === 'left' ? ' is-active' : '') + '"></span>' +
                        '<span class="home-admin-layout__snap-zone' + (edge === 'auto' ? ' is-active' : '') + '"></span>' +
                        '<span class="home-admin-layout__snap-zone' + (edge === 'right' ? ' is-active' : '') + '"></span>' +
                      '</div>' +
                      '<div class="home-admin-layout__snap-thumb" style="left:' + snapPct + '%;"></div>' +
                    '</div>' +
                    '<button type="button" class="home-layout-edge-btn' + (edge === 'left' ? ' is-active' : '') + '" data-i="' + i + '" data-edge="left">←</button>' +
                    '<button type="button" class="home-layout-edge-btn' + (edge === 'auto' ? ' is-active' : '') + '" data-i="' + i + '" data-edge="auto">·</button>' +
                    '<button type="button" class="home-layout-edge-btn' + (edge === 'right' ? ' is-active' : '') + '" data-i="' + i + '" data-edge="right">→</button>' +
                  '</div>' +
                '</div>' +
              '</div>' +
            '</div>'
          );
        }).join('');

        container.innerHTML =
          '<div class="home-admin-layout">' +
            '<div class="home-admin-layout__label">Интерактивная раскладка: перетащите карточку для порядка, тяните правый край для ширины (4/6 кол.), полоску или стрелки — для привязки к краю сетки.</div>' +
            '<div class="home-admin-layout__stage">' +
              '<div class="home-admin-layout__guides">' + guides + '</div>' +
              '<div class="home-admin-layout__grid">' + items + '</div>' +
            '</div>' +
          '</div>';

        bindHomeLayoutInteractions(container);
        hydrateLazyIframes(container);
      }

      function renderHomeMediaCardsEditor() {
        const container = document.getElementById('homeMediaCardsEditor');
        if (!container) return;
        container.innerHTML = '';

        function getHomeCardPreviewHtml(card) {
          const src = (card && typeof card.src === 'string') ? card.src : '';
          const as = (card && (card.as === 'video' || card.as === 'vimeo' || card.as === 'kinescope')) ? card.as : 'image';
          if (!src) return '<span style="font-size:12px;color:#666;">Превью появится после заполнения src</span>';
          if (as === 'vimeo') {
            return '<iframe src="' + esc(getVimeoEmbedUrl(src)) + '" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen style="width:100%;height:220px;display:block;border:0;"></iframe>';
          }
          if (as === 'kinescope') {
            return '<iframe src="' + esc(getKinescopeEmbedUrl(src)) + '" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen style="width:100%;height:220px;display:block;border:0;"></iframe>';
          }
          if (as === 'video') {
            return '<video src="' + esc(src) + '" muted playsinline preload="metadata" style="width:100%;max-height:220px;display:block;"></video>';
          }
          return '<img src="' + esc(src) + '" alt="" style="width:100%;max-height:220px;object-fit:contain;display:block;" />';
        }

        function updateHomeCardPreview(i) {
          const preview = container.querySelector('.home-card-preview[data-i="' + i + '"]');
          if (!preview) return;
          preview.innerHTML = getHomeCardPreviewHtml(homeMediaCards[i] || {});
        }

        homeMediaCards.forEach(function (card, i) {
          const item = normalizeHomeMediaCard(card);
          const row = document.createElement('div');
          row.style.cssText = 'margin-bottom:1rem;padding:1rem;border:1px solid #ddd;border-radius:6px;';
          row.innerHTML =
            '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.75rem;">' +
              '<strong>Карточка ' + (i + 1) + '</strong>' +
              '<div style="display:flex;gap:0.4rem;align-items:center;">' +
                '<button type="button" class="secondary move-home-card-up" data-i="' + i + '" style="padding:0.25rem 0.5rem;font-size:0.85rem;">↑</button>' +
                '<button type="button" class="secondary move-home-card-down" data-i="' + i + '" style="padding:0.25rem 0.5rem;font-size:0.85rem;">↓</button>' +
                '<button type="button" class="danger delete-home-card" data-i="' + i + '" style="padding:0.25rem 0.5rem;font-size:0.85rem;">Удалить</button>' +
              '</div>' +
            '</div>' +
            '<div style="display:grid;gap:0.5rem;">' +
              '<label>Источник (src)</label>' +
              '<input type="text" class="home-card-src" data-i="' + i + '" value="' + esc(item.src) + '" placeholder="/images/main/photo.webp" />' +
              '<div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;">' +
                '<button type="button" class="secondary upload-home-card-image" data-i="' + i + '">Загрузить фото в GitHub</button>' +
                '<input type="file" class="home-card-file" data-i="' + i + '" accept="image/*" style="display:none;" />' +
              '</div>' +
              '<label>Ссылка (href)</label>' +
              '<input type="text" class="home-card-href" data-i="' + i + '" value="' + esc(item.href) + '" placeholder="/index/" />' +
              '<label>Alt</label>' +
              '<input type="text" class="home-card-alt" data-i="' + i + '" value="' + esc(item.alt) + '" placeholder="Описание изображения" />' +
              '<div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0.5rem;">' +
                '<div><label>Режим</label><select class="home-card-as" data-i="' + i + '"><option value="image"' + (item.as === 'image' ? ' selected' : '') + '>image</option><option value="video"' + (item.as === 'video' ? ' selected' : '') + '>video-file</option><option value="vimeo"' + (item.as === 'vimeo' ? ' selected' : '') + '>vimeo</option><option value="kinescope"' + (item.as === 'kinescope' ? ' selected' : '') + '>kinescope</option></select></div>' +
                '<div><label>Размер в сетке</label><select class="home-card-size" data-i="' + i + '"><option value="normal"' + (item.size === 'normal' ? ' selected' : '') + '>normal</option><option value="wide"' + (item.size === 'wide' ? ' selected' : '') + '>wide</option></select></div>' +
                '<div><label>Край</label><select class="home-card-edge" data-i="' + i + '"><option value="auto"' + (item.edge === 'auto' ? ' selected' : '') + '>auto</option><option value="left"' + (item.edge === 'left' ? ' selected' : '') + '>left</option><option value="right"' + (item.edge === 'right' ? ' selected' : '') + '>right</option></select></div>' +
              '</div>' +
              '<div><label>Пропорция</label><select class="home-card-ratio" data-i="' + i + '">' +
                HOME_MEDIA_RATIOS.map(function (r) {
                  return '<option value="' + r + '"' + (item.ratio === r ? ' selected' : '') + '>' + r + '</option>';
                }).join('') +
              '</select></div>' +
              '<div class="home-card-preview" data-i="' + i + '" style="margin-top:0.25rem;border:1px solid #eee;background:#f8f8f8;min-height:80px;display:flex;align-items:center;justify-content:center;overflow:hidden;">' +
                getHomeCardPreviewHtml(item) +
              '</div>' +
            '</div>';
          container.appendChild(row);
        });

        container.querySelectorAll('.home-card-src').forEach(function (inp) {
          inp.addEventListener('input', function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            const as = homeMediaCards[i].as;
            let value = this.value.trim();
            if (as === 'image') {
              value = toWebpPath(value);
              if (value !== this.value.trim()) this.value = value;
            }
            homeMediaCards[i].src = value;
            updateHomeCardPreview(i);
            refreshHomeMediaCardsVisualViews();
          });
        });
        container.querySelectorAll('.home-card-href').forEach(function (inp) {
          inp.addEventListener('input', function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            homeMediaCards[i].href = this.value.trim() || '/index/';
            refreshHomeMediaCardsVisualViews();
          });
        });
        container.querySelectorAll('.home-card-alt').forEach(function (inp) {
          inp.addEventListener('input', function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            homeMediaCards[i].alt = this.value;
          });
        });
        container.querySelectorAll('.home-card-as').forEach(function (sel) {
          sel.addEventListener('change', function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            if (this.value === 'video' || this.value === 'vimeo' || this.value === 'kinescope') {
              homeMediaCards[i].as = this.value;
            } else {
              homeMediaCards[i].as = 'image';
            }
            renderHomeMediaCardsEditor();
          });
        });
        container.querySelectorAll('.home-card-size').forEach(function (sel) {
          sel.addEventListener('change', function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            homeMediaCards[i].size = this.value === 'wide' ? 'wide' : 'normal';
            refreshHomeMediaCardsVisualViews();
          });
        });
        container.querySelectorAll('.home-card-ratio').forEach(function (sel) {
          sel.addEventListener('change', function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            homeMediaCards[i].ratio = HOME_MEDIA_RATIOS.includes(this.value) ? this.value : 'aspect-16-9';
            refreshHomeMediaCardsVisualViews();
          });
        });
        container.querySelectorAll('.home-card-edge').forEach(function (sel) {
          sel.addEventListener('change', function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            homeMediaCards[i].edge = (this.value === 'left' || this.value === 'right') ? this.value : 'auto';
            refreshHomeMediaCardsVisualViews();
          });
        });
        container.querySelectorAll('.delete-home-card').forEach(function (btn) {
          btn.addEventListener('click', function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            homeMediaCards.splice(i, 1);
            renderHomeMediaCardsEditor();
            document.getElementById('homeMediaCardsLoadStatus').textContent = 'Карточек: ' + homeMediaCards.length;
          });
        });
        container.querySelectorAll('.move-home-card-up').forEach(function (btn) {
          btn.addEventListener('click', function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            if (!Number.isFinite(i) || i <= 0) return;
            const current = homeMediaCards[i];
            homeMediaCards[i] = homeMediaCards[i - 1];
            homeMediaCards[i - 1] = current;
            renderHomeMediaCardsEditor();
          });
        });
        container.querySelectorAll('.move-home-card-down').forEach(function (btn) {
          btn.addEventListener('click', function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            if (!Number.isFinite(i) || i >= homeMediaCards.length - 1) return;
            const current = homeMediaCards[i];
            homeMediaCards[i] = homeMediaCards[i + 1];
            homeMediaCards[i + 1] = current;
            renderHomeMediaCardsEditor();
          });
        });
        container.querySelectorAll('.upload-home-card-image').forEach(function (btn) {
          btn.addEventListener('click', function () {
            const i = this.getAttribute('data-i');
            const input = container.querySelector('.home-card-file[data-i="' + i + '"]');
            if (input) input.click();
          });
        });
        container.querySelectorAll('.home-card-file').forEach(function (inp) {
          inp.addEventListener('change', async function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            const file = this.files && this.files[0];
            if (!file) return;
            const statusEl = document.getElementById('homeMediaCardsGhStatus');
            if (!/^image\//.test(file.type)) {
              statusEl.textContent = 'Можно загружать только фото (image/*).';
              statusEl.className = 'status err';
              this.value = '';
              return;
            }
            try {
              statusEl.textContent = 'Загрузка фото в GitHub…';
              statusEl.className = 'status';
              const uploadedPath = await uploadFileToGitHub(file, 'public/images/main', 'Upload home media image from admin');
              homeMediaCards[i].src = uploadedPath;
              homeMediaCards[i].as = 'image';
              statusEl.textContent = 'Фото загружено: ' + uploadedPath;
              statusEl.className = 'status ok';
              renderHomeMediaCardsEditor();
            } catch (e) {
              statusEl.textContent = 'Ошибка загрузки: ' + e.message;
              statusEl.className = 'status err';
            } finally {
              this.value = '';
            }
          });
        });
        syncHomeMediaCardsView();
      }

      function hydrateLazyIframes(root) {
        if (!root) return;
        const iframes = root.querySelectorAll('iframe[data-src]');
        if (!iframes.length) return;
        const io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            const el = entry.target;
            const src = el.getAttribute('data-src');
            if (src && el.getAttribute('src') !== src) el.src = src;
            io.unobserve(el);
          });
        }, { rootMargin: '240px' });
        iframes.forEach(function (el) { io.observe(el); });
      }

      function kinescopeAspectCss(src) {
        const pad = String(src || '').match(/padding-top:\s*([\d.]+)%/i);
        if (pad) {
          const pct = Number(pad[1]);
          if (Number.isFinite(pct) && pct > 0) return String(100 / pct);
        }
        const widthMatch = String(src || '').match(/\bwidth=["'](\d+)["']/i);
        const heightMatch = String(src || '').match(/\bheight=["'](\d+)["']/i);
        if (widthMatch && heightMatch) {
          const width = Number(widthMatch[1]);
          const height = Number(heightMatch[1]);
          if (width > 0 && height > 0) return String(width / height);
        }
        return '16 / 9';
      }

      function renderResearchCardsEditor() {
        const container = document.getElementById('researchCardsEditor');
        if (!container) return;
        container.innerHTML = '';
        syncResearchViewButtons();
        syncResearchScaleUi();

        const listMode = researchCardsView === 'list';
        const previewMode = researchCardsView === 'preview';
        const wrapper = document.createElement('div');
        if (listMode) wrapper.className = 'research-admin-list';
        else if (previewMode) wrapper.className = 'research-admin-feed';
        else wrapper.style.cssText = 'display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:0.75rem;align-items:start;';
        container.appendChild(wrapper);

        function getResearchCardPreviewHtml(card, mode) {
          const item = normalizeResearchCard(card, 0);
          if (!item.src) return '<span style="font-size:11px;color:#666;">Нет src</span>';
          if (item.as === 'kinescope') {
            const embed = esc(getKinescopeEmbedUrl(item.src, false));
            if (mode === 'feed') {
              return '<div style="position:relative;width:100%;aspect-ratio:' + kinescopeAspectCss(item.src) + ';background:#111;"><iframe data-src="' + embed + '" title="Видео" frameborder="0" allow="fullscreen; picture-in-picture" allowfullscreen style="position:absolute;inset:0;width:100%;height:100%;display:block;border:0;"></iframe></div>';
            }
            const height = mode === 'list' ? '220px' : '100%';
            return '<iframe data-src="' + embed + '" title="Видео" frameborder="0" allow="fullscreen; picture-in-picture" allowfullscreen style="width:100%;height:' + height + ';display:block;border:0;background:#111;"></iframe>';
          }
          if (mode === 'feed') {
            return '<img src="' + esc(item.src) + '" alt="" style="width:100%;height:auto;display:block;" />';
          }
          return '<img src="' + esc(item.src) + '" alt="" style="width:100%;height:100%;object-fit:contain;display:block;" />';
        }

        function getResearchExtrasHtml(item, i) {
          const extras = Array.isArray(item.sideSrcs) ? item.sideSrcs : [];
          const tiles = extras.map(function (src, j) {
            const thumb = src
              ? '<img src="' + esc(src) + '" alt="" />'
              : '<span style="font-size:11px;color:#888;">Нет файла</span>';
            return (
              '<div class="research-admin-extra" data-i="' + i + '" data-j="' + j + '">' +
                '<div class="research-admin-extra__thumb">' + thumb + '</div>' +
                '<input type="text" class="research-card-extra-src" data-i="' + i + '" data-j="' + j + '" value="' + esc(src || '') + '" placeholder="/images/research/photo.webp" />' +
                '<div class="research-admin-extra__btns">' +
                  '<button type="button" class="secondary upload-research-card-extra" data-i="' + i + '" data-j="' + j + '">Файл</button>' +
                  '<button type="button" class="danger remove-research-card-extra" data-i="' + i + '" data-j="' + j + '">×</button>' +
                '</div>' +
                '<input type="file" class="research-card-extra-file" data-i="' + i + '" data-j="' + j + '" accept=".webp,.gif,.jpg,.jpeg,.png,image/webp,image/gif,image/jpeg,image/png" style="display:none;" />' +
              '</div>'
            );
          }).join('');
          return (
            '<div class="research-admin-extras" data-i="' + i + '">' +
              tiles +
              '<button type="button" class="secondary research-admin-extras__add add-research-card-extra" data-i="' + i + '">+ Фото</button>' +
            '</div>'
          );
        }

        function getResearchLinksHtml(item, i) {
          const links = Array.isArray(item.links) && item.links.length ? item.links : [{ text: '', url: '' }];
          const rows = links.map(function (link, j) {
            return (
              '<div class="link-row" data-i="' + i + '" data-j="' + j + '">' +
                '<input type="text" class="research-card-link-text project-link-text" data-i="' + i + '" data-j="' + j + '" placeholder="Текст ссылки" value="' + esc(link.text || '') + '" />' +
                '<input type="url" class="research-card-link-url project-link-url" data-i="' + i + '" data-j="' + j + '" placeholder="https://example.com" value="' + esc(link.url || '') + '" />' +
                '<button type="button" class="danger remove-link remove-research-card-link" data-i="' + i + '" data-j="' + j + '" title="Удалить">×</button>' +
              '</div>'
            );
          }).join('');
          return (
            '<div class="research-admin-links" data-i="' + i + '">' +
              '<label>Ссылки</label>' +
              '<div class="links-list">' + rows + '</div>' +
              '<button type="button" class="secondary add-research-card-link" data-i="' + i + '" style="margin-top:0.35rem;">+ Добавить ссылку</button>' +
            '</div>'
          );
        }

        function updateResearchCardPreview(i) {
          const preview = container.querySelector('.research-card-preview[data-i="' + i + '"]');
          if (!preview) return;
          const mode = listMode ? 'list' : (previewMode ? 'feed' : 'grid');
          preview.innerHTML = getResearchCardPreviewHtml(researchCards[i] || {}, mode);
          hydrateLazyIframes(preview);
        }

        researchCards.forEach(function (card, i) {
          const item = normalizeResearchCard(card, i + 1, true);
          const row = document.createElement('div');
          row.setAttribute('draggable', 'true');
          row.setAttribute('data-i', String(i));
          if (previewMode) {
            row.className = 'research-admin-feed__row' + (item.spanW === 6 ? ' research-admin-feed__row--w6' : '');
            row.innerHTML =
              '<span class="research-admin-feed__name">' + esc(item.caption || '') + '</span>' +
              '<div class="research-card-preview research-admin-feed__media" data-i="' + i + '">' +
                getResearchCardPreviewHtml(item, 'feed') +
              '</div>' +
              '<span class="research-admin-feed__date">' + esc(item.date || '') + '</span>';
          } else if (listMode) {
            row.className = 'research-admin-list__card';
            row.innerHTML =
              '<div class="research-admin-list__inner">' +
                '<div class="research-card-preview research-admin-list__thumb" data-i="' + i + '">' +
                  getResearchCardPreviewHtml(item, 'list') +
                '</div>' +
                '<div class="research-admin-list__fields">' +
                  '<div class="research-admin-list__row">' +
                    '<label class="research-admin-list__num">№<input type="number" class="research-card-number" data-i="' + i + '" min="0" step="1" value="' + esc(item.number) + '" /></label>' +
                    '<label class="research-admin-list__as">Режим<select class="research-card-as" data-i="' + i + '"><option value="image"' + (item.as === 'image' ? ' selected' : '') + '>image</option><option value="kinescope"' + (item.as === 'kinescope' ? ' selected' : '') + '>видео</option></select></label>' +
                    '<label class="research-admin-list__span">Ширина<select class="research-card-spanw" data-i="' + i + '"><option value="4"' + (item.spanW === 6 ? '' : ' selected') + '>4</option><option value="6"' + (item.spanW === 6 ? ' selected' : '') + '>6</option></select></label>' +
                    '<label class="research-admin-list__grow">Src<textarea class="research-card-src" data-i="' + i + '" rows="3" placeholder="/images/research/photo.webp или Kinescope">' + esc(item.src) + '</textarea></label>' +
                    '<button type="button" class="secondary upload-research-card-image" data-i="' + i + '" style="padding:0.28rem 0.5rem;font-size:0.78rem;">Загрузить</button>' +
                    '<input type="file" class="research-card-file" data-i="' + i + '" accept=".webp,.gif,.jpg,.jpeg,.png,image/webp,image/gif,image/jpeg,image/png" style="display:none;" />' +
                  '</div>' +
                  '<div class="research-admin-list__row">' +
                    '<label class="research-admin-list__grow">Подпись<input type="text" class="research-card-caption" data-i="' + i + '" value="' + esc(item.caption || '') + '" placeholder="Название" /></label>' +
                    '<label class="research-admin-list__grow">Alt<input type="text" class="research-card-alt" data-i="' + i + '" value="' + esc(item.alt) + '" placeholder="Описание" /></label>' +
                    '<label class="research-admin-list__date">Дата<input type="text" class="research-card-date" data-i="' + i + '" value="' + esc(item.date || '') + '" placeholder="06.2026" /></label>' +
                  '</div>' +
                  '<div class="research-admin-list__row">' +
                    '<label class="research-admin-list__grow">Текст<textarea class="research-card-text" data-i="' + i + '" rows="2" placeholder="Текст справа в просмотре">' + esc(item.text || '') + '</textarea></label>' +
                  '</div>' +
                  getResearchLinksHtml(item, i) +
                  getResearchExtrasHtml(item, i) +
                '</div>' +
                '<div class="research-admin-list__actions">' +
                  '<span title="Перетащите для смены порядка" style="font-size:0.85rem;color:#666;cursor:grab;">↕</span>' +
                  '<button type="button" class="danger delete-research-card" data-i="' + i + '">Удалить</button>' +
                '</div>' +
              '</div>';
          } else {
            row.style.cssText = 'padding:0.75rem;border:1px solid #ddd;border-radius:6px;background:#fff;zoom:' + researchCardsScale + '%;';
            row.innerHTML =
            '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.75rem;">' +
              '<strong>Карточка #' + esc(item.number) + '</strong>' +
              '<div style="display:flex;gap:0.4rem;align-items:center;">' +
                '<span title="Перетащите для смены порядка" style="font-size:0.85rem;color:#666;cursor:grab;">↕</span>' +
                '<button type="button" class="danger delete-research-card" data-i="' + i + '" style="padding:0.25rem 0.5rem;font-size:0.85rem;">Удалить</button>' +
              '</div>' +
            '</div>' +
            '<div style="display:grid;gap:0.5rem;">' +
              '<label>Номер</label>' +
              '<input type="number" class="research-card-number" data-i="' + i + '" min="0" step="1" value="' + esc(item.number) + '" />' +
              '<label>Режим</label>' +
              '<select class="research-card-as" data-i="' + i + '">' +
                '<option value="image"' + (item.as === 'image' ? ' selected' : '') + '>image</option>' +
                '<option value="kinescope"' + (item.as === 'kinescope' ? ' selected' : '') + '>видео</option>' +
              '</select>' +
              '<label>Макс. ширина (колонки)</label>' +
              '<select class="research-card-spanw" data-i="' + i + '">' +
                '<option value="4"' + (item.spanW === 6 ? '' : ' selected') + '>4</option>' +
                '<option value="6"' + (item.spanW === 6 ? ' selected' : '') + '>6</option>' +
              '</select>' +
              '<label>Источник (src)</label>' +
              '<input type="text" class="research-card-src" data-i="' + i + '" value="' + esc(item.src) + '" placeholder="/images/research/photo.webp или ссылка/iframe Kinescope" />' +
              '<div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;">' +
                '<button type="button" class="secondary upload-research-card-image" data-i="' + i + '">Загрузить WebP/GIF в GitHub</button>' +
                '<input type="file" class="research-card-file" data-i="' + i + '" accept=".webp,.gif,.jpg,.jpeg,.png,image/webp,image/gif,image/jpeg,image/png" style="display:none;" />' +
              '</div>' +
              '<label>Alt</label>' +
              '<input type="text" class="research-card-alt" data-i="' + i + '" value="' + esc(item.alt) + '" placeholder="Описание изображения" />' +
              '<label>Подпись (caption)</label>' +
              '<input type="text" class="research-card-caption" data-i="' + i + '" value="' + esc(item.caption || '') + '" placeholder="Подпись в полноэкранном просмотре" />' +
              '<label>Дата (MM.YYYY)</label>' +
              '<input type="text" class="research-card-date" data-i="' + i + '" value="' + esc(item.date || '') + '" placeholder="06.2026" />' +
              '<label>Доп. фото</label>' +
              getResearchExtrasHtml(item, i) +
              '<label>Текст</label>' +
              '<textarea class="research-card-text" data-i="' + i + '" rows="3" placeholder="Текст в колонках 5–12">' + esc(item.text || '') + '</textarea>' +
              getResearchLinksHtml(item, i) +
              '<div class="research-card-preview" data-i="' + i + '" style="margin-top:0.25rem;border:1px solid #eee;background:#f8f8f8;aspect-ratio:1/1;min-height:0;display:flex;align-items:center;justify-content:center;overflow:hidden;">' +
                getResearchCardPreviewHtml(item, 'grid') +
              '</div>' +
            '</div>';
          }
          wrapper.appendChild(row);

          row.addEventListener('mousedown', function (e) {
            const interactive = e.target.closest('button, input, textarea, select, label, .research-admin-extras, .research-admin-extra, .research-admin-links, .link-row');
            row.setAttribute('draggable', interactive ? 'false' : 'true');
          });
          row.addEventListener('mouseup', function () {
            row.setAttribute('draggable', 'true');
          });
          row.addEventListener('dragstart', function (e) {
            if (e.target.closest('button, input, textarea, select, label, .research-admin-extras, .research-admin-extra, .research-admin-links, .link-row')) {
              e.preventDefault();
              return;
            }
            draggedResearchIndex = i;
            row.style.opacity = '0.6';
            if (e.dataTransfer) {
              e.dataTransfer.effectAllowed = 'move';
              e.dataTransfer.setData('text/plain', String(i));
            }
          });
          row.addEventListener('dragover', function (e) {
            e.preventDefault();
            row.style.outline = '2px dashed #999';
          });
          row.addEventListener('dragleave', function () {
            row.style.outline = '';
          });
          row.addEventListener('drop', function (e) {
            e.preventDefault();
            row.style.outline = '';
            const from = Number.isFinite(draggedResearchIndex)
              ? draggedResearchIndex
              : parseInt(e.dataTransfer?.getData('text/plain') || '', 10);
            const to = i;
            moveResearchCard(from, to);
          });
          row.addEventListener('dragend', function () {
            draggedResearchIndex = null;
            row.style.outline = '';
            row.style.opacity = '';
          });
        });

        container.querySelectorAll('.research-card-number').forEach(function (inp) {
          inp.addEventListener('change', function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            const value = Number(this.value);
            researchCards[i].number = Number.isFinite(value) ? Math.max(0, Math.round(value)) : 0;
            sortResearchCards();
            renderResearchCardsEditor();
          });
        });
        container.querySelectorAll('.research-card-as').forEach(function (sel) {
          sel.addEventListener('change', function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            researchCards[i].as = this.value === 'kinescope' ? 'kinescope' : 'image';
            updateResearchCardPreview(i);
          });
        });
        container.querySelectorAll('.research-card-spanw').forEach(function (sel) {
          sel.addEventListener('change', function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            researchCards[i].spanW = this.value === '6' ? 6 : 4;
          });
        });
        container.querySelectorAll('.research-card-src').forEach(function (inp) {
          inp.addEventListener('input', function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            let value = this.value.trim();
            if (researchCards[i].as !== 'kinescope') {
              value = toWebpPath(value);
              if (value !== this.value.trim()) this.value = value;
            }
            researchCards[i].src = value;
            updateResearchCardPreview(i);
          });
        });
        container.querySelectorAll('.research-card-alt').forEach(function (inp) {
          inp.addEventListener('input', function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            researchCards[i].alt = this.value;
          });
        });
        container.querySelectorAll('.research-card-caption').forEach(function (inp) {
          inp.addEventListener('input', function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            researchCards[i].caption = this.value;
          });
        });
        container.querySelectorAll('.research-card-date').forEach(function (inp) {
          inp.addEventListener('change', function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            const v = (this.value || '').trim();
            const m = v.match(/^(\d{1,2})[.\-/](\d{4})$/);
            researchCards[i].date = m ? String(m[1]).padStart(2, '0') + '.' + m[2] : '';
            this.value = researchCards[i].date || '';
          });
        });
        container.querySelectorAll('.research-card-extra-src').forEach(function (inp) {
          inp.addEventListener('input', function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            const j = parseInt(this.getAttribute('data-j'), 10);
            if (!Array.isArray(researchCards[i].sideSrcs)) researchCards[i].sideSrcs = [];
            const value = toWebpPath(this.value.trim());
            if (value !== this.value.trim()) this.value = value;
            researchCards[i].sideSrcs[j] = value;
            const wrap = this.closest('.research-admin-extra');
            const thumb = wrap ? wrap.querySelector('.research-admin-extra__thumb') : null;
            if (thumb) thumb.innerHTML = value ? '<img src="' + esc(value) + '" alt="" />' : '<span style="font-size:11px;color:#888;">Нет файла</span>';
          });
        });
        container.querySelectorAll('.add-research-card-extra').forEach(function (btn) {
          btn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            const i = parseInt(this.getAttribute('data-i'), 10);
            if (!Array.isArray(researchCards[i].sideSrcs)) researchCards[i].sideSrcs = [];
            researchCards[i].sideSrcs.push('');
            renderResearchCardsEditor();
          });
        });
        container.querySelectorAll('.remove-research-card-extra').forEach(function (btn) {
          btn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            const i = parseInt(this.getAttribute('data-i'), 10);
            const j = parseInt(this.getAttribute('data-j'), 10);
            if (!Array.isArray(researchCards[i].sideSrcs)) return;
            researchCards[i].sideSrcs.splice(j, 1);
            renderResearchCardsEditor();
          });
        });
