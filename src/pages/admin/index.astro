                '<div class="research-admin-list__screens-label">Внутренние экраны — колонки и медиа</div>' +
                getResearchExtrasHtml(item, i) +
              '</div>';
          } else if (listMode) {
            row.className = 'research-admin-list__card';
            row.innerHTML =
              '<div class="research-admin-list__inner">' +
                '<div class="research-card-preview research-admin-list__thumb" data-i="' + i + '">' +
                  getResearchCardPreviewHtml(item, 'list') +
                '</div>' +
                '<div class="research-admin-list__fields">' +
                  '<div class="research-admin-list__row">' +
                    '<label class="research-admin-list__num">№<input type="number" class="research-card-number" data-i="' + i + '" min="0" step="1" value="' + esc(item.number) + '" /></label>' +
                    '<label class="research-admin-list__as">Режим<select class="research-card-as" data-i="' + i + '"><option value="image"' + (item.as === 'image' ? ' selected' : '') + '>image</option><option value="video"' + (item.as === 'video' ? ' selected' : '') + '>video-file</option><option value="audio"' + (item.as === 'audio' ? ' selected' : '') + '>audio</option><option value="kinescope"' + (item.as === 'kinescope' ? ' selected' : '') + '>embed</option></select></label>' +
                    '<label class="research-admin-list__span">Обложка<select class="research-card-cover" data-i="' + i + '">' + researchCoverSizeOptionsHtml(item) + '</select></label>' +
                    getResearchSrcFieldsHtml(item, i, 'list') +
                  '</div>' +
                  '<div class="research-admin-list__row">' +
                    '<label class="research-admin-list__grow">Название<input type="text" class="research-card-caption" data-i="' + i + '" value="' + esc(item.caption || '') + '" placeholder="Плашка «+»" /></label>' +
                    '<label class="research-admin-list__grow">Ссылка<input type="url" class="research-card-link" data-i="' + i + '" value="' + esc(researchLinkUrl(item)) + '" placeholder="https://…" /></label>' +
                    '<label class="research-admin-list__grow">Alt<input type="text" class="research-card-alt" data-i="' + i + '" value="' + esc(item.alt) + '" placeholder="Fallback" /></label>' +
                    '<label class="research-admin-list__date">Дата<input type="text" class="research-card-date" data-i="' + i + '" value="' + esc(item.date || '') + '" placeholder="06.2026 или текст" /></label>' +
                  '</div>' +
                  '<div class="research-admin-list__row">' +
                    '<label class="research-admin-list__grow">Описание<textarea class="research-card-text" data-i="' + i + '" rows="2" placeholder="Плашка описания (по центру, 12px)">' + esc(item.text || '') + '</textarea></label>' +
                  '</div>' +
                  '<div class="research-admin-list__screens-label">Внутренние экраны (1–3 фото/видео на экран)</div>' +
                  getResearchExtrasHtml(item, i) +
                '</div>' +
                '<div class="research-admin-list__actions">' +
                  '<span title="Перетащите для смены порядка" style="font-size:0.85rem;color:#666;cursor:grab;">↕</span>' +
                  '<button type="button" class="danger delete-research-card" data-i="' + i + '">Удалить</button>' +
                '</div>' +
              '</div>';
          } else {
            row.style.cssText = 'padding:0.75rem;border:1px solid #ddd;border-radius:6px;background:#fff;zoom:' + researchCardsScale + '%;';
            row.innerHTML =
            '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.75rem;">' +
              '<strong>Карточка #' + esc(item.number) + '</strong>' +
              '<div style="display:flex;gap:0.4rem;align-items:center;">' +
                '<span title="Перетащите для смены порядка" style="font-size:0.85rem;color:#666;cursor:grab;">↕</span>' +
                '<button type="button" class="danger delete-research-card" data-i="' + i + '" style="padding:0.25rem 0.5rem;font-size:0.85rem;">Удалить</button>' +
              '</div>' +
            '</div>' +
            '<div style="display:grid;gap:0.5rem;">' +
              '<label>Номер</label>' +
              '<input type="number" class="research-card-number" data-i="' + i + '" min="0" step="1" value="' + esc(item.number) + '" />' +
              '<label>Режим</label>' +
              '<select class="research-card-as" data-i="' + i + '">' +
                '<option value="image"' + (item.as === 'image' ? ' selected' : '') + '>image</option>' +
                '<option value="video"' + (item.as === 'video' ? ' selected' : '') + '>video-file</option>' +
                '<option value="audio"' + (item.as === 'audio' ? ' selected' : '') + '>audio</option>' +
                '<option value="kinescope"' + (item.as === 'kinescope' ? ' selected' : '') + '>embed</option>' +
              '</select>' +
              '<label>Обложка</label>' +
              '<select class="research-card-cover" data-i="' + i + '">' +
                researchCoverSizeOptionsHtml(item) +
              '</select>' +
              getResearchSrcFieldsHtml(item, i, 'grid') +
              '<label>Alt</label>' +
              '<input type="text" class="research-card-alt" data-i="' + i + '" value="' + esc(item.alt) + '" placeholder="Fallback / a11y" />' +
              '<label>Название (плашка «+»)</label>' +
              '<input type="text" class="research-card-caption" data-i="' + i + '" value="' + esc(item.caption || '') + '" placeholder="ItakFilm" />' +
              '<label>Ссылка (в названии)</label>' +
              '<input type="url" class="research-card-link" data-i="' + i + '" value="' + esc(researchLinkUrl(item)) + '" placeholder="https://…" />' +
              '<label>Дата</label>' +
              '<input type="text" class="research-card-date" data-i="' + i + '" value="' + esc(item.date || '') + '" placeholder="06.2026 или любой текст" />' +
              '<label>Описание (плашка «+»)</label>' +
              '<textarea class="research-card-text" data-i="' + i + '" rows="3" placeholder="Текст описания">' + esc(item.text || '') + '</textarea>' +
              '<label>Внутренние экраны (1–3 фото/видео на экран)</label>' +
              getResearchExtrasHtml(item, i) +
              '<div class="research-card-preview" data-i="' + i + '" style="margin-top:0.25rem;border:1px solid #eee;background:#f8f8f8;aspect-ratio:1/1;min-height:0;display:flex;align-items:center;justify-content:center;overflow:hidden;">' +
                getResearchCardPreviewHtml(item, 'grid') +
              '</div>' +
            '</div>';
          }
          wrapper.appendChild(row);

          row.addEventListener('mousedown', function (e) {
            const interactive = e.target.closest('button, input, textarea, select, label, .research-admin-extras, .research-admin-screen, .research-admin-media, .research-admin-links, .link-row');
            row.setAttribute('draggable', interactive ? 'false' : 'true');
          });
          row.addEventListener('mouseup', function () {
            row.setAttribute('draggable', 'true');
          });
          row.addEventListener('dragstart', function (e) {
            if (e.target.closest('button, input, textarea, select, label, .research-admin-extras, .research-admin-screen, .research-admin-media, .research-admin-links, .link-row')) {
              e.preventDefault();
              return;
            }
            draggedResearchIndex = i;
            row.style.opacity = '0.6';
            if (e.dataTransfer) {
              e.dataTransfer.effectAllowed = 'move';
              e.dataTransfer.setData('text/plain', String(i));
            }
          });
          row.addEventListener('dragover', function (e) {
            e.preventDefault();
            row.style.outline = '2px dashed #999';
          });
          row.addEventListener('dragleave', function () {
            row.style.outline = '';
          });
          row.addEventListener('drop', function (e) {
            e.preventDefault();
            row.style.outline = '';
            const from = Number.isFinite(draggedResearchIndex)
              ? draggedResearchIndex
              : parseInt(e.dataTransfer?.getData('text/plain') || '', 10);
            const to = i;
            moveResearchCard(from, to);
          });
          row.addEventListener('dragend', function () {
            draggedResearchIndex = null;
            row.style.outline = '';
            row.style.opacity = '';
          });
        });

        container.querySelectorAll('.research-card-number').forEach(function (inp) {
          inp.addEventListener('change', function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            const value = Number(this.value);
            researchCards[i].number = Number.isFinite(value) ? Math.max(0, Math.round(value)) : 0;
            sortResearchCards();
            renderResearchCardsEditor();
          });
        });
        container.querySelectorAll('.research-card-as').forEach(function (sel) {
          sel.addEventListener('change', function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            const nextAs = this.value === 'kinescope' ? 'kinescope'
              : this.value === 'video' ? 'video'
              : this.value === 'audio' ? 'audio'
              : 'image';
            const prevAs = researchCards[i].as;
            researchCards[i].as = nextAs;
            if (nextAs === 'audio' && prevAs !== 'audio') {
              if (isResearchAudioPath(researchCards[i].src) && !researchCards[i].audioSrc) {
                researchCards[i].audioSrc = researchCards[i].src;
                researchCards[i].src = '';
              }
              if (!researchCards[i].audioSrc) researchCards[i].audioSrc = '';
            }
            renderResearchCardsEditor();
          });
        });
        container.querySelectorAll('.research-card-cover').forEach(function (sel) {
          sel.addEventListener('change', function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            applyResearchCoverSize(researchCards[i], this.value);
            updateResearchCardPreview(i);
          });
        });
        container.querySelectorAll('.research-card-src').forEach(function (inp) {
          inp.addEventListener('input', function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            let value = this.value.trim();
            if (researchCards[i].as === 'image' || researchCards[i].as === 'audio') {
              value = toWebpPath(value);
              if (value !== this.value.trim()) this.value = value;
            }
            researchCards[i].src = value;
            updateResearchCardPreview(i);
          });
        });
        container.querySelectorAll('.research-card-audio-src').forEach(function (inp) {
          inp.addEventListener('input', function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            researchCards[i].audioSrc = this.value.trim();
            researchCards[i].as = 'audio';
            updateResearchCardPreview(i);
          });
        });
        container.querySelectorAll('.research-card-src-mobile').forEach(function (inp) {
          inp.addEventListener('input', function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            let value = this.value.trim();
            value = toWebpPath(value);
            if (value !== this.value.trim()) this.value = value;
            researchCards[i].srcMobile = value;
            updateResearchCardPreview(i);
          });
        });
        container.querySelectorAll('.research-card-alt').forEach(function (inp) {
          inp.addEventListener('input', function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            researchCards[i].alt = this.value;
          });
        });
        container.querySelectorAll('.research-card-caption').forEach(function (inp) {
          inp.addEventListener('input', function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            researchCards[i].caption = this.value;
            if (researchLinkUrl(researchCards[i])) setResearchLinkUrl(researchCards[i], researchLinkUrl(researchCards[i]));
            updateResearchCardPreview(i);
          });
        });
        container.querySelectorAll('.research-card-link').forEach(function (inp) {
          inp.addEventListener('input', function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            setResearchLinkUrl(researchCards[i], this.value);
            updateResearchCardPreview(i);
          });
        });
        container.querySelectorAll('.research-card-date').forEach(function (inp) {
          inp.addEventListener('input', function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            researchCards[i].date = this.value;
            updateResearchCardPreview(i);
          });
        });
        function ensureResearchScreens(i) {
          if (!Array.isArray(researchCards[i].screens)) researchCards[i].screens = [];
          return researchCards[i].screens;
        }

        function ensureResearchScreenItem(i, j, k) {
          const screens = ensureResearchScreens(i);
          if (!screens[j]) screens[j] = { items: [] };
          if (!Array.isArray(screens[j].items)) screens[j].items = [];
          if (!screens[j].items[k]) screens[j].items[k] = { src: '', as: 'image', span: 4, fit: 'cols' };
          return screens[j].items[k];
        }

        container.querySelectorAll('.research-card-screen-src').forEach(function (inp) {
          inp.addEventListener('input', function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            const j = parseInt(this.getAttribute('data-j'), 10);
            const k = parseInt(this.getAttribute('data-k'), 10);
            const item = ensureResearchScreenItem(i, j, k);
            let value = this.value.trim();
            const as = researchMediaAsFromSrc(value, item.as);
            if (as === 'image') {
              value = toWebpPath(value);
              if (value !== this.value.trim()) this.value = value;
            }
            item.src = value;
            item.as = as;
            const wrap = this.closest('.research-admin-media');
            const thumb = wrap ? wrap.querySelector('.research-admin-extra__thumb') : null;
            if (thumb) thumb.innerHTML = researchScreenThumbHtml(item);
            const asSel = wrap ? wrap.querySelector('.research-card-screen-as') : null;
            if (asSel) asSel.value = as;
            updateResearchCardPreview(i);
          });
        });
        container.querySelectorAll('.research-card-screen-as').forEach(function (sel) {
          sel.addEventListener('change', function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            const j = parseInt(this.getAttribute('data-j'), 10);
            const k = parseInt(this.getAttribute('data-k'), 10);
            const item = ensureResearchScreenItem(i, j, k);
            item.as = this.value === 'video' ? 'video' : 'image';
            const wrap = this.closest('.research-admin-media');
            const thumb = wrap ? wrap.querySelector('.research-admin-extra__thumb') : null;
            if (thumb) thumb.innerHTML = researchScreenThumbHtml(item);
            updateResearchCardPreview(i);
          });
        });
        container.querySelectorAll('.research-card-screen-span').forEach(function (sel) {
          sel.addEventListener('change', function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            const j = parseInt(this.getAttribute('data-j'), 10);
            const k = parseInt(this.getAttribute('data-k'), 10);
            ensureResearchScreenItem(i, j, k).span = parseResearchScreenSpan(this.value);
            updateResearchCardPreview(i);
          });
        });
        container.querySelectorAll('.research-card-screen-fit').forEach(function (sel) {
          sel.addEventListener('change', function () {
            const i = parseInt(this.getAttribute('data-i'), 10);
            const j = parseInt(this.getAttribute('data-j'), 10);
            const k = parseInt(this.getAttribute('data-k'), 10);
            ensureResearchScreenItem(i, j, k).fit = this.value === 'height' ? 'height' : 'cols';
            updateResearchCardPreview(i);
          });
        });
        container.querySelectorAll('.add-research-card-screen').forEach(function (btn) {
          btn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            const i = parseInt(this.getAttribute('data-i'), 10);
            ensureResearchScreens(i).push({ items: [{ src: '', as: 'image', span: 4, fit: 'cols' }] });
            renderResearchCardsEditor();
