            if (!Number.isFinite(i) || i >= homeMediaCards.length - 1) return;
            const current = homeMediaCards[i];
            homeMediaCards[i] = homeMediaCards[i + 1];
            homeMediaCards[i + 1] = current;
            renderHomeMediaCardsEditor();
          });
