        researchCardsScale = Number.isFinite(value) ? Math.max(70, Math.min(140, Math.round(value))) : 100;
        syncResearchScaleUi();
        if (researchCardsView === 'grid') renderResearchCardsEditor();
      });

      function initApp() {
        initAdminNav();
        setActivePane('projectsPane');
        loadProjects();
        loadHomeMediaCards();
        loadResearchCards();
      }

      checkAuth();
    })();
  </script>
</AdminLayout>
