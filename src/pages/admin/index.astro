      function parseRepoAndToken(statusEl) {
        const repoInput = document.getElementById('ghRepo');
        const tokenInput = document.getElementById('ghToken');
        const repo = (repoInput?.value || '').trim();
        const token = (tokenInput?.value || '').trim();
        if (!repo || !token) {
          statusEl.textContent = 'Укажите репозиторий и токен выше.';
          statusEl.className = 'status err';
          return null;
        }
        const parts = repo.split('/').filter(Boolean);
        if (parts.length !== 2) {
          statusEl.textContent = 'Репозиторий в формате owner/repo';
          statusEl.className = 'status err';
          return null;
        }
        return { owner: parts[0], repoName: parts[1], token: token, repo: repo };
      }

      function sanitizeFileName(name) {
        const safe = String(name || 'file')
          .toLowerCase()
          .replace(/[^a-z0-9._-]+/g, '-')
          .replace(/-+/g, '-')
          .replace(/^-|-$/g, '');
        return safe || 'file';
      }

      function isVideoFile(file) {
        const name = String(file && file.name || '').toLowerCase();
        const type = String(file && file.type || '').toLowerCase();
        return type === 'video/mp4' || type === 'video/webm' || /\.(mp4|webm)$/.test(name);
      }

      function isAudioFile(file) {
        const name = String(file && file.name || '').toLowerCase();
        const type = String(file && file.type || '').toLowerCase();
        return type.startsWith('audio/') || /\.(mp3|wav|ogg|m4a|aac)$/.test(name);
      }

      async function maybeConvertUploadToWebp(file) {
        const name = String(file.name || 'image').toLowerCase();
        if (file.type === 'image/gif' || name.endsWith('.gif')) return file;
        if (file.type === 'image/webp' || name.endsWith('.webp')) return file;
        if (!(file.type === 'image/png' || file.type === 'image/jpeg' || /\.(png|jpe?g)$/.test(name))) return file;
        const bitmap = await createImageBitmap(file);
        const canvas = document.createElement('canvas');
        canvas.width = bitmap.width;
        canvas.height = bitmap.height;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(bitmap, 0, 0);
        bitmap.close();
        const blob = await new Promise(function (resolve, reject) {
          canvas.toBlob(function (b) {
            if (b) resolve(b);
            else reject(new Error('Не удалось конвертировать в WebP'));
          }, 'image/webp', 0.8);
        });
        const webpName = String(file.name || 'image').replace(/\.(png|jpe?g)$/i, '.webp');
        return new File([blob], /\.webp$/i.test(webpName) ? webpName : webpName + '.webp', { type: 'image/webp' });
      }

      async function fileToBase64(file) {
        const buffer = await file.arrayBuffer();
        const bytes = new Uint8Array(buffer);
        let binary = '';
        const chunk = 0x8000;
        for (let i = 0; i < bytes.length; i += chunk) {
          const part = bytes.subarray(i, i + chunk);
          binary += String.fromCharCode.apply(null, part);
        }
        return btoa(binary);
      }

      async function uploadFileToGitHub(file, targetDir, commitMessage, statusEl) {
        const gh = parseRepoAndToken(statusEl || document.getElementById('ghStatus'));
        if (!gh) throw new Error('Нет данных GitHub');

        if ((isVideoFile(file) || isAudioFile(file)) && file.size > 40 * 1024 * 1024) {
          throw new Error('Файл больше 40 МБ. Сожмите и загрузите снова.');
        }

        sessionStorage.setItem(REPO_KEY, gh.repo);

        const uploadFile = (isVideoFile(file) || isAudioFile(file)) ? file : await maybeConvertUploadToWebp(file);
        const fileName = Date.now() + '-' + sanitizeFileName(uploadFile.name);
        const contentPath = targetDir + '/' + fileName;
        const apiUrl = 'https://api.github.com/repos/' + gh.owner + '/' + gh.repoName + '/contents/' + contentPath;

        const getRes = await fetch(apiUrl, {
          headers: { 'Accept': 'application/vnd.github.v3+json', 'Authorization': 'token ' + gh.token }
        });
        let sha = null;
        if (getRes.ok) {
          const data = await getRes.json();
          sha = data.sha;
        } else if (getRes.status !== 404) {
          const err = await getRes.json().catch(() => ({}));
          throw new Error(err.message || getRes.statusText);
        }

        const body = {
          message: commitMessage,
          content: await fileToBase64(uploadFile),
          branch: 'main'
        };
        if (sha) body.sha = sha;

        const putRes = await fetch(apiUrl, {
          method: 'PUT',
          headers: {
            'Accept': 'application/vnd.github.v3+json',
            'Authorization': 'token ' + gh.token,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(body)
        });

        if (!putRes.ok) {
          const err = await putRes.json().catch(() => ({}));
          throw new Error(err.message || putRes.statusText);
        }

        const publicPath = targetDir.replace(/^public\//, '');
        return '/' + publicPath + '/' + fileName;
      }

