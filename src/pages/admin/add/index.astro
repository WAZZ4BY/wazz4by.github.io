---
import AdminLayout from '../../../layouts/AdminLayout.astro';
const base = import.meta.env.BASE_URL;
---

<AdminLayout title="Добавить проект">
  <div id="admin-add-root">
    <div id="gate" class="gate">
      <h1>Вход в админку</h1>
      <input type="password" id="password" placeholder="Пароль" />
      <button type="button" id="loginBtn" class="primary">Войти</button>
      <p id="gateError" class="error" style="display:none;"></p>
    </div>

    <div id="app" style="display:none;">
      <h1>Добавить проект</h1>
      <p><a href={`${base}admin/`}>← К списку проектов</a></p>

      <section class="admin-section">
        <form id="addForm">
          <label>Название проекта</label>
          <input type="text" id="addTitle" placeholder="Название" required />
          <label>Короткое название (для Index)</label>
          <input type="text" id="addShortTitle" placeholder="Например: De Stul" />
          <label>Тип проекта</label>
          <input type="text" id="addType" placeholder="Type design, Motion, Identity…" />
          <label>Год</label>
          <input type="text" id="addYear" placeholder="2025" />
          <label>Точная дата для сортировки</label>
          <input type="date" id="addSortDate" />
          <label class="admin-checkbox-label">
            <input type="checkbox" id="addHidden" />
            Скрыть проект с сайта
          </label>
          <p class="admin-hint">Скрытый проект сохранится в данных, но не будет показан на сайте.</p>
          <label>Цвет фона страницы</label>
          <div class="admin-color-row">
            <input type="color" id="addBackgroundColor" value="#FBFBFB" title="Выберите цвет" />
            <input type="text" id="addBackgroundColorHex" placeholder="#FBFBFB или оставьте пустым" />
          </div>
          <label>Awards (награды)</label>
          <p class="admin-hint">В конце проекта: место, фестиваль и номинация.</p>
          <div id="addAwardsList" class="awards-list"></div>
          <button type="button" class="secondary" id="addAwardBtn" style="margin-top:0.5rem;">+ Добавить награду</button>
          <label style="margin-top:1rem;">Credits (кредиты)</label>
          <p class="admin-hint">Одна строка = одна роль и имя. Можно добавить ссылку к имени.</p>
          <div id="addCreditsList" class="credits-list"></div>
          <button type="button" class="secondary" id="addCreditBtn" style="margin-top:0.5rem;">+ Добавить кредит</button>
          <label>Ссылки проекта</label>
          <p class="admin-hint">Добавьте текст ссылки и URL.</p>
          <div id="addLinksList" class="links-list"></div>
          <button type="button" class="secondary" id="addLinkBtn" style="margin-top:0.5rem;">+ Добавить ссылку</button>
          <label>Контент (блоки)</label>
          <p class="admin-hint">Текст — колонки 5–12. Изображение — на всю ширину. Сплит — два изображения. Видео — embed (Vimeo/Kinescope) или файл mp4/webm в <code>public/videos/projects</code>. Между блоками отступ 50px.</p>
          <label>GitHub (для загрузки видео)</label>
          <p class="admin-hint">Те же репозиторий и токен, что в списке проектов. Нужны только чтобы залить mp4/webm в GitHub.</p>
          <input type="text" id="addGhRepo" placeholder="owner/repo" />
          <input type="password" id="addGhToken" placeholder="ghp_xxxx…" autocomplete="off" />
          <p id="addUploadStatus" class="status"></p>
          <div id="addContentBlocksList" class="content-blocks-list"></div>
          <div class="content-blocks-actions">
            <button type="button" class="secondary" id="addBlockText">+ Текст</button>
            <button type="button" class="secondary" id="addBlockImage">+ Изображение</button>
            <button type="button" class="secondary" id="addBlockSplit">+ Сплит</button>
            <button type="button" class="secondary" id="addBlockVideo">+ Видео</button>
          </div>
          <button type="submit" class="primary">Сохранить проект</button>
        </form>
      </section>
    </div>
  </div>

  <script define:vars={{ base }}>
    (function () {
      const STORAGE_KEY = 'admin_authed';
      const PASSWORD = 'admin12345';
      const NEW_PROJECT_KEY = 'admin_new_project';

      const gate = document.getElementById('gate');
      const app = document.getElementById('app');
      const passwordInput = document.getElementById('password');
      const gateError = document.getElementById('gateError');
      const loginBtn = document.getElementById('loginBtn');

      function checkAuth() {
        if (sessionStorage.getItem(STORAGE_KEY) === '1') {
          gate.style.display = 'none';
          app.style.display = 'block';
          return;
        }
        gate.style.display = 'block';
        app.style.display = 'none';
      }

      loginBtn.addEventListener('click', function () {
        gateError.style.display = 'none';
        if (passwordInput.value === PASSWORD) {
          sessionStorage.setItem(STORAGE_KEY, '1');
          checkAuth();
        } else {
          gateError.textContent = 'Неверный пароль.';
          gateError.style.display = 'block';
        }
      });

      passwordInput.addEventListener('keydown', function (e) { if (e.key === 'Enter') loginBtn.click(); });

      function slugify(s) {
        return s.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
      }

      let contentBlocks = [];

      function esc(s) { return String(s || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }

      function toWebpPath(url) {
        const u = String(url || '').trim();
        if (!u || u.indexOf('<') !== -1 || /^https?:\/\//i.test(u)) return u;
        return u.replace(/\.(png|jpe?g)(\?.*)?$/i, '.webp$2');
      }

      function rewriteBlocks(blocks) {
        return (blocks || []).map(function (block) {
          if (!block || typeof block !== 'object') return block;
          if (block.type === 'video') {
            const src = typeof block.src === 'string' ? block.src.trim() : '';
            const embed = typeof block.embed === 'string' ? block.embed.trim() : '';
            if (src) return { type: 'video', src: src };
            return { type: 'video', embed: embed };
          }
          const b = Object.assign({}, block);
          if (typeof b.src === 'string') b.src = toWebpPath(b.src);
          if (typeof b.left === 'string') b.left = toWebpPath(b.left);
          if (typeof b.right === 'string') b.right = toWebpPath(b.right);
          return b;
        });
      }

      function resolveImgUrl(url) {
        const u = (url || '').trim();
        if (!u) return '';
        if (u.startsWith('http')) return u;
        const b = (typeof base !== 'undefined' ? base : '') || '/';
        return (b.endsWith('/') ? b : b + '/') + toWebpPath(u).replace(/^\//, '');
      }

      function resolveMediaUrl(url) {
        const u = (url || '').trim();
        if (!u) return '';
        if (u.startsWith('http')) return u;
        const b = (typeof base !== 'undefined' ? base : '') || '/';
        return (b.endsWith('/') ? b : b + '/') + u.replace(/^\//, '');
      }

      function isVideoUpload(file) {
        const name = String(file && file.name || '').toLowerCase();
        const type = String(file && file.type || '').toLowerCase();
        return type.startsWith('video/') || /\.(mp4|webm)$/.test(name);
      }

      function sanitizeFileName(name) {
        const safe = String(name || 'video')
          .toLowerCase()
          .replace(/[^a-z0-9._-]+/g, '-')
          .replace(/-+/g, '-')
          .replace(/^-|-$/g, '');
        return safe || 'video';
      }

      async function fileToBase64(file) {
        const buffer = await file.arrayBuffer();
        const bytes = new Uint8Array(buffer);
        let binary = '';
        const chunk = 0x8000;
        for (let i = 0; i < bytes.length; i += chunk) {
          const part = bytes.subarray(i, i + chunk);
          binary += String.fromCharCode.apply(null, part);
        }
        return btoa(binary);
      }

      function parseAddGh() {
        const statusEl = document.getElementById('addUploadStatus');
        const repoInput = document.getElementById('addGhRepo');
        const tokenInput = document.getElementById('addGhToken');
        const repo = (repoInput?.value || '').trim() || (sessionStorage.getItem('admin_gh_repo') || '').trim();
        const token = (tokenInput?.value || '').trim();
        if (repoInput && !repoInput.value.trim() && repo) repoInput.value = repo;
        if (!repo || !token) {
          if (statusEl) {
            statusEl.textContent = 'Укажите репозиторий и токен выше для загрузки.';
            statusEl.className = 'status err';
          }
          return null;
        }
        const parts = repo.split('/').filter(Boolean);
        if (parts.length !== 2) {
          if (statusEl) {
            statusEl.textContent = 'Репозиторий в формате owner/repo';
            statusEl.className = 'status err';
          }
          return null;
        }
        return { owner: parts[0], repoName: parts[1], token: token, repo: repo };
      }

      async function uploadVideoToGitHub(file) {
        const statusEl = document.getElementById('addUploadStatus');
        const gh = parseAddGh();
        if (!gh) throw new Error('Нет данных GitHub');
        sessionStorage.setItem('admin_gh_repo', gh.repo);
        const fileName = Date.now() + '-' + sanitizeFileName(file.name);
        const contentPath = 'public/videos/projects/' + fileName;
        const apiUrl = 'https://api.github.com/repos/' + gh.owner + '/' + gh.repoName + '/contents/' + contentPath;
        const getRes = await fetch(apiUrl, {
          headers: { 'Accept': 'application/vnd.github.v3+json', 'Authorization': 'token ' + gh.token }
        });
        let sha = null;
        if (getRes.ok) {
          const data = await getRes.json();
          sha = data.sha;
        } else if (getRes.status !== 404) {
          const err = await getRes.json().catch(function () { return {}; });
          throw new Error(err.message || getRes.statusText);
        }
        const body = {
          message: 'Upload project video from admin',
          content: await fileToBase64(file),
          branch: 'main'
        };
        if (sha) body.sha = sha;
        const putRes = await fetch(apiUrl, {
          method: 'PUT',
          headers: {
            'Accept': 'application/vnd.github.v3+json',
            'Authorization': 'token ' + gh.token,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(body)
        });
        if (!putRes.ok) {
          const err = await putRes.json().catch(function () { return {}; });
          throw new Error(err.message || putRes.statusText);
        }
        if (statusEl) {
          statusEl.textContent = 'Видео загружено: /videos/projects/' + fileName;
          statusEl.className = 'status ok';
        }
        return '/videos/projects/' + fileName;
      }

      function renderBlocks() {
        const list = document.getElementById('addContentBlocksList');
        list.innerHTML = '';
        contentBlocks.forEach(function (block, index) {
          const card = document.createElement('div');
          card.className = 'content-block-card';
          card.dataset.index = String(index);
          let inner = '';
          if (block.type === 'text') {
            inner = '<div class="content-block-card__row"><span class="content-block-card__type">Текст</span><button type="button" class="secondary move-up" title="Вверх">↑</button><button type="button" class="secondary move-down" title="Вниз">↓</button><button type="button" class="danger remove-block" title="Удалить">×</button></div><textarea class="content-block-card__textarea" rows="3" placeholder="Текст (колонки 5–12)">' + esc(block.content || '') + '</textarea>';
          } else if (block.type === 'image') {
            const imgSrc = resolveImgUrl(block.src || '');
            inner = '<div class="content-block-card__row"><span class="content-block-card__type">Изображение</span><button type="button" class="secondary move-up" title="Вверх">↑</button><button type="button" class="secondary move-down" title="Вниз">↓</button><button type="button" class="danger remove-block" title="Удалить">×</button></div><input type="text" class="content-block-card__url" value="' + esc(block.src || '') + '" placeholder="/images/photo.webp" /><div class="content-block-card__preview">' + (imgSrc ? '<img src="' + esc(imgSrc) + '" alt="" onerror="this.classList.add(\'content-block-card__preview-img--error\')" onload="this.classList.remove(\'content-block-card__preview-img--error\')" />' : '') + '</div>';
          } else if (block.type === 'split') {
            const leftSrc = resolveImgUrl(block.left || '');
            const rightSrc = resolveImgUrl(block.right || '');
            inner = '<div class="content-block-card__row"><span class="content-block-card__type">Сплит</span><button type="button" class="secondary move-up" title="Вверх">↑</button><button type="button" class="secondary move-down" title="Вниз">↓</button><button type="button" class="danger remove-block" title="Удалить">×</button></div><div class="content-block-card__split-fields"><input type="text" class="content-block-card__url" value="' + esc(block.left || '') + '" placeholder="/images/left.webp" data-side="left" /><input type="text" class="content-block-card__url" value="' + esc(block.right || '') + '" placeholder="/images/right.webp" data-side="right" /></div><div class="content-block-card__preview content-block-card__preview--split"><div class="content-block-card__preview-item">' + (leftSrc ? '<img src="' + esc(leftSrc) + '" alt="" onerror="this.classList.add(\'content-block-card__preview-img--error\')" onload="this.classList.remove(\'content-block-card__preview-img--error\')" />' : '') + '</div><div class="content-block-card__preview-item">' + (rightSrc ? '<img src="' + esc(rightSrc) + '" alt="" onerror="this.classList.add(\'content-block-card__preview-img--error\')" onload="this.classList.remove(\'content-block-card__preview-img--error\')" />' : '') + '</div></div>';
          } else if (block.type === 'video') {
            const fileSrc = resolveMediaUrl(block.src || '');
            const hasFile = !!(block.src || '').trim();
            inner =
              '<div class="content-block-card__row"><span class="content-block-card__type">Видео</span><button type="button" class="secondary move-up" title="Вверх">↑</button><button type="button" class="secondary move-down" title="Вниз">↓</button><button type="button" class="danger remove-block" title="Удалить">×</button></div>' +
              '<label style="display:block;margin:0.35rem 0 0.2rem;font-size:0.85rem;">Файл (mp4/webm)</label>' +
              '<input type="text" class="content-block-card__url content-block-card__video-src" value="' + esc(block.src || '') + '" placeholder="/videos/projects/clip.mp4" />' +
              '<div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;margin:0.4rem 0;">' +
                '<button type="button" class="secondary upload-block-video">Загрузить видео</button>' +
                '<input type="file" class="content-block-card__video-file" accept="video/mp4,video/webm,.mp4,.webm" style="display:none;" />' +
                (hasFile ? '<button type="button" class="danger clear-block-video-src" style="padding:0.25rem 0.5rem;font-size:0.85rem;">Очистить файл</button>' : '') +
              '</div>' +
              '<div class="content-block-card__preview content-block-card__preview--video">' +
                (fileSrc ? '<video src="' + esc(fileSrc) + '" muted playsinline controls preload="metadata" style="width:100%;max-height:220px;display:block;background:#111;"></video>' : '') +
              '</div>' +
              '<label style="display:block;margin:0.6rem 0 0.2rem;font-size:0.85rem;">Или embed (Vimeo/Kinescope)</label>' +
              '<textarea class="content-block-card__textarea content-block-card__textarea--embed" rows="3" placeholder="Вставьте iframe или ссылку">' + esc(block.embed || '') + '</textarea>';
          }
          card.innerHTML = inner;

          card.querySelector('.remove-block').addEventListener('click', function () {
            contentBlocks.splice(index, 1);
            renderBlocks();
          });
          card.querySelector('.move-up').addEventListener('click', function () {
            if (index === 0) return;
            contentBlocks.splice(index - 1, 0, contentBlocks.splice(index, 1)[0]);
            renderBlocks();
          });
          card.querySelector('.move-down').addEventListener('click', function () {
            if (index >= contentBlocks.length - 1) return;
            contentBlocks.splice(index + 1, 0, contentBlocks.splice(index, 1)[0]);
            renderBlocks();
          });

          if (block.type === 'text') {
            card.querySelector('.content-block-card__textarea').addEventListener('input', function () {
              contentBlocks[index].content = this.value;
            });
          } else if (block.type === 'image') {
            const urlInput = card.querySelector('.content-block-card__url');
            const previewWrap = card.querySelector('.content-block-card__preview');
            function updateImagePreview() {
              const value = toWebpPath(urlInput.value.trim());
              if (value !== urlInput.value.trim()) urlInput.value = value;
              contentBlocks[index].src = value;
              const src = resolveImgUrl(value);
              if (!previewWrap) return;
              if (src) {
                let img = previewWrap.querySelector('img');
                if (!img) { img = document.createElement('img'); img.alt = ''; img.onerror = function () { this.classList.add('content-block-card__preview-img--error'); }; img.onload = function () { this.classList.remove('content-block-card__preview-img--error'); }; previewWrap.appendChild(img); }
                img.src = src;
                img.classList.remove('content-block-card__preview-img--error');
              } else {
                previewWrap.innerHTML = '';
              }
            }
            urlInput.addEventListener('input', updateImagePreview);
            urlInput.addEventListener('change', updateImagePreview);
          } else if (block.type === 'split') {
            const leftInput = card.querySelector('input[data-side="left"]');
            const rightInput = card.querySelector('input[data-side="right"]');
            const previewWrap = card.querySelector('.content-block-card__preview--split');
            function updateSplitPreviews() {
              const left = toWebpPath(leftInput.value.trim());
              const right = toWebpPath(rightInput.value.trim());
              if (left !== leftInput.value.trim()) leftInput.value = left;
              if (right !== rightInput.value.trim()) rightInput.value = right;
              contentBlocks[index].left = left;
              contentBlocks[index].right = right;
              if (!previewWrap) return;
              const items = previewWrap.querySelectorAll('.content-block-card__preview-item');
              [leftInput.value.trim(), rightInput.value.trim()].forEach(function (val, i) {
                const src = resolveImgUrl(val);
                const item = items[i];
                if (!item) return;
                if (src) {
                  let img = item.querySelector('img');
                  if (!img) { img = document.createElement('img'); img.alt = ''; img.onerror = function () { this.classList.add('content-block-card__preview-img--error'); }; img.onload = function () { this.classList.remove('content-block-card__preview-img--error'); }; item.appendChild(img); }
                  img.src = src;
                  img.classList.remove('content-block-card__preview-img--error');
                } else {
                  item.innerHTML = '';
                }
              });
            }
            leftInput.addEventListener('input', updateSplitPreviews);
            leftInput.addEventListener('change', updateSplitPreviews);
            rightInput.addEventListener('input', updateSplitPreviews);
            rightInput.addEventListener('change', updateSplitPreviews);
          } else if (block.type === 'video') {
            const srcInput = card.querySelector('.content-block-card__video-src');
            const embedInput = card.querySelector('.content-block-card__textarea--embed');
            const previewWrap = card.querySelector('.content-block-card__preview--video');
            const fileInput = card.querySelector('.content-block-card__video-file');
            const uploadBtn = card.querySelector('.upload-block-video');
            const clearBtn = card.querySelector('.clear-block-video-src');

            function updateVideoFilePreview() {
              const value = (srcInput.value || '').trim();
              contentBlocks[index].src = value;
              if (value) contentBlocks[index].embed = '';
              if (embedInput && value) embedInput.value = '';
              if (!previewWrap) return;
              const resolved = resolveMediaUrl(value);
              if (resolved) {
                previewWrap.innerHTML = '<video src="' + esc(resolved) + '" muted playsinline controls preload="metadata" style="width:100%;max-height:220px;display:block;background:#111;"></video>';
              } else {
                previewWrap.innerHTML = '';
              }
            }

            if (srcInput) {
              srcInput.addEventListener('input', updateVideoFilePreview);
              srcInput.addEventListener('change', updateVideoFilePreview);
            }
            if (embedInput) {
              embedInput.addEventListener('input', function () {
                contentBlocks[index].embed = this.value;
                if (this.value.trim()) {
                  contentBlocks[index].src = '';
                  if (srcInput) srcInput.value = '';
                  if (previewWrap) previewWrap.innerHTML = '';
                }
              });
            }
            if (clearBtn) {
              clearBtn.addEventListener('click', function () {
                contentBlocks[index].src = '';
                if (srcInput) srcInput.value = '';
                if (previewWrap) previewWrap.innerHTML = '';
                renderBlocks();
              });
            }
            if (uploadBtn && fileInput) {
              uploadBtn.addEventListener('click', function () {
                fileInput.click();
              });
              fileInput.addEventListener('change', async function () {
                const file = this.files && this.files[0];
                this.value = '';
                if (!file) return;
                if (!isVideoUpload(file)) {
                  const statusEl = document.getElementById('addUploadStatus');
                  if (statusEl) {
                    statusEl.textContent = 'Нужен файл mp4 или webm.';
                    statusEl.className = 'status err';
                  }
                  return;
                }
                if (file.size > 40 * 1024 * 1024) {
                  const statusEl = document.getElementById('addUploadStatus');
                  if (statusEl) {
                    statusEl.textContent = 'Видео больше 40 МБ. Сожмите файл и загрузите снова.';
                    statusEl.className = 'status err';
                  }
                  return;
                }
                try {
                  uploadBtn.disabled = true;
                  uploadBtn.textContent = 'Загрузка…';
                  const uploadedPath = await uploadVideoToGitHub(file);
                  contentBlocks[index].src = uploadedPath;
                  contentBlocks[index].embed = '';
                  renderBlocks();
                } catch (err) {
                  const statusEl = document.getElementById('addUploadStatus');
                  if (statusEl) {
                    statusEl.textContent = 'Ошибка загрузки: ' + (err && err.message ? err.message : err);
                    statusEl.className = 'status err';
                  }
                } finally {
                  uploadBtn.disabled = false;
                  uploadBtn.textContent = 'Загрузить видео';
                }
              });
            }
          }

          list.appendChild(card);
        });
      }

      document.getElementById('addBlockText').addEventListener('click', function () {
        contentBlocks.push({ type: 'text', content: '' });
        renderBlocks();
      });
      document.getElementById('addBlockImage').addEventListener('click', function () {
        contentBlocks.push({ type: 'image', src: '' });
        renderBlocks();
      });
      document.getElementById('addBlockSplit').addEventListener('click', function () {
        contentBlocks.push({ type: 'split', left: '', right: '' });
        renderBlocks();
      });
      document.getElementById('addBlockVideo').addEventListener('click', function () {
        contentBlocks.push({ type: 'video', embed: '' });
        renderBlocks();
      });

      (function () {
        const colorInput = document.getElementById('addBackgroundColor');
        const hexInput = document.getElementById('addBackgroundColorHex');
        if (colorInput && hexInput) {
          colorInput.addEventListener('input', function () { hexInput.value = this.value; });
          hexInput.addEventListener('input', function () {
            const v = this.value.trim();
            if (/^#[0-9A-Fa-f]{6}$/.test(v)) colorInput.value = v;
          });
        }
      })();

      (function () {
        const list = document.getElementById('addAwardsList');
        if (!list) return;
        const addRow = function () {
          const row = document.createElement('div');
          row.className = 'award-row';
          row.innerHTML = '<input type="text" class="award-place" placeholder="Место" /> <input type="text" class="award-festival" placeholder="Фестиваль" /> <input type="text" class="award-nomination" placeholder="Номинация" /> <button type="button" class="danger remove-award" title="Удалить">×</button>';
          list.appendChild(row);
          row.querySelector('.remove-award').addEventListener('click', function () { row.remove(); });
        };
        addRow();
        document.getElementById('addAwardBtn').addEventListener('click', addRow);
      })();

      (function () {
        const list = document.getElementById('addLinksList');
        if (!list) return;
        const addRow = function () {
          const row = document.createElement('div');
          row.className = 'link-row';
          row.innerHTML = '<input type="text" class="project-link-text" placeholder="Текст ссылки" /> <input type="url" class="project-link-url" placeholder="https://example.com" /> <button type="button" class="danger remove-link" title="Удалить">×</button>';
          list.appendChild(row);
          row.querySelector('.remove-link').addEventListener('click', function () { row.remove(); });
        };
        addRow();
        document.getElementById('addLinkBtn').addEventListener('click', addRow);
      })();

      (function () {
        const list = document.getElementById('addCreditsList');
        if (!list) return;
        const addRow = function () {
          const row = document.createElement('div');
          row.className = 'credit-row';
          row.innerHTML = '<input type="text" class="credit-role" placeholder="Роль" /> <input type="text" class="credit-name" placeholder="Имя" /> <input type="url" class="credit-url" placeholder="https://example.com (необязательно)" /> <button type="button" class="danger remove-credit" title="Удалить">×</button>';
          list.appendChild(row);
          row.querySelector('.remove-credit').addEventListener('click', function () { row.remove(); });
        };
        addRow();
        document.getElementById('addCreditBtn').addEventListener('click', addRow);
      })();

      document.getElementById('addForm').addEventListener('submit', function (e) {
        e.preventDefault();
        const title = document.getElementById('addTitle').value.trim();
        if (!title) return;
        const addBgHex = document.getElementById('addBackgroundColorHex').value.trim();
        const addBgColor = document.getElementById('addBackgroundColor').value;
        const awards = [];
        const creditsList = [];
        const links = [];
        document.querySelectorAll('#addAwardsList .award-row').forEach(function (row) {
          const placeEl = row.querySelector('.award-place');
          const festivalEl = row.querySelector('.award-festival');
          const nominationEl = row.querySelector('.award-nomination');
          const place = placeEl ? placeEl.value.trim() : '';
          const festival = festivalEl ? festivalEl.value.trim() : '';
          const nomination = nominationEl ? nominationEl.value.trim() : '';
          if (place || festival || nomination) {
            awards.push({ place: place || '—', festival: festival || '—', nomination: nomination || '—' });
          }
        });
        document.querySelectorAll('#addLinksList .link-row').forEach(function (row) {
          const textEl = row.querySelector('.project-link-text');
          const urlEl = row.querySelector('.project-link-url');
          const text = textEl ? textEl.value.trim() : '';
          const url = urlEl ? urlEl.value.trim() : '';
          if (text || url) {
            links.push({ text: text || '—', url: url || '#' });
          }
        });
        document.querySelectorAll('#addCreditsList .credit-row').forEach(function (row) {
          const roleEl = row.querySelector('.credit-role');
          const nameEl = row.querySelector('.credit-name');
          const urlEl = row.querySelector('.credit-url');
          const role = roleEl ? roleEl.value.trim() : '';
          const name = nameEl ? nameEl.value.trim() : '';
          const url = urlEl ? urlEl.value.trim() : '';
          if (role || name || url) {
            creditsList.push({ role: role || '—', name: name || '—', url: url || undefined });
          }
        });
        const newProject = {
          id: slugify(title),
          title,
          shortTitle: document.getElementById('addShortTitle').value.trim() || undefined,
          description: '',
          type: document.getElementById('addType').value.trim(),
          year: document.getElementById('addYear').value.trim(),
          sortDate: document.getElementById('addSortDate').value.trim() || undefined,
          images: [],
          contentBlocks: rewriteBlocks(contentBlocks),
          backgroundColor: addBgHex || addBgColor || undefined,
          awards: awards.length > 0 ? awards : undefined,
          links: links.length > 0 ? links : undefined,
          creditsList: creditsList.length > 0 ? creditsList : undefined
        };
        if (document.getElementById('addHidden').checked) newProject.hidden = true;
        sessionStorage.setItem(NEW_PROJECT_KEY, JSON.stringify(newProject));
        window.location.href = base + 'admin/';
      });

      checkAuth();
    })();
  </script>
</AdminLayout>
