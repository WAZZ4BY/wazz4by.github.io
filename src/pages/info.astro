---
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerPageHeader from '../components/InnerPageHeader.astro';
---

<BaseLayout title="Info" variant="inner" bodyClass="page-info" hideHeader>
  <div class="inner-page info-page">
    <div class="inner-page__grid">
      <InnerPageHeader activePage="info" />
      <main class="inner-page__main info">
        <div class="info-grid">
          <p class="info-intro">
            I design in the field of identity, constantly experimenting with form and graphics, and exploring the trashart approach to commerce. I focus on building complex identity systems with an emphasis on digital and physicality.
          </p>

          <div class="info-split">
            <div class="info-split__left">
              <div class="info-pair">
                <div class="info-pair__label info-pair__label--tight">
                  Name<br/>Based<br/>Alive
                </div>
                <div class="info-pair__value">
                  Vasilii Aleev<br/>
                  In Moscow<br/>
                  Since 2004
                </div>
              </div>
              <div class="info-pair">
                <div class="info-pair__label">Education<br/>Work</div>
                <div class="info-pair__value">
                  HSE A&amp;D School<br/>
                  Currently designer at ONY Agency, ex-designer at Dotorg. Freelance since `23.
                </div>
              </div>
            </div>

            <div class="info-split__right">
              <p class="info-quote">
                “The combination of robust classical typography with a clear vision of the path and experimental visualization is a true balance between chaotic trash art and an academic approach.”
              </p>
              <div class="info-contacts-line">
                <div class="info-contacts-handles">
                  <a href="https://t.me/waz4by" target="_blank" rel="noopener noreferrer">@waz4by</a><br/>
                  <a href="https://www.instagram.com/wazz4by/" target="_blank" rel="noopener noreferrer">@wazz4by</a><br/>
                  <a href="https://www.behance.net/wazz4by" target="_blank" rel="noopener noreferrer">@wazz4by</a><br/>
                  wass4lsnow<br/>@gmail.com
                </div>
                <div class="info-contacts-short">
                  <a href="https://t.me/waz4by" target="_blank" rel="noopener noreferrer">Tg</a><br/>
                  <a href="https://www.instagram.com/wazz4by/" target="_blank" rel="noopener noreferrer">Ig</a><br/>
                  <a href="https://www.behance.net/wazz4by" target="_blank" rel="noopener noreferrer">Be</a><br/>
                  <span>Mail</span>
                </div>
              </div>
            </div>
          </div>

          <div class="info-reward-row">
            <div class="info-reward-label">Reward</div>
            <div class="info-reward-years">
              WBDS `23-24<br/>
              WBDS `24-25<br/>
              Pentawards `25<br/>
              Sreda `25<br/>
              Sreda `25<br/>
              WBDS `25-26
            </div>
            <div class="info-reward-pairs">
              <span>Silver <span class="info-reward-project">De Stul</span></span><br/>
              <span>Gold <span class="info-reward-project">Boop</span></span><br/>
              <span>Silver <span class="info-reward-project">Boop</span></span><br/>
              <span>Silver <span class="info-reward-project">Bioart Lab</span></span><br/>
              <span>Bronze <span class="info-reward-project">Hoja Sagrada</span></span><br/>
              <span>Commended <span class="info-reward-project">CC25</span></span>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>
</BaseLayout>

<style>
  .info {
    width: 100%;
    background: transparent;
  }

  .info-grid {
    display: grid;
    grid-template-columns: var(--info-label-col) repeat(9, minmax(0, 1fr));
    gap: 0 var(--grid-gutter);
    width: 100%;
    align-items: start;
    --info-label-col: 6.75rem;
  }

  .info-grid > * {
    color: #000;
    font-family: 'SuisseIntl', sans-serif;
    word-wrap: break-word;
    min-width: 0;
  }

  .info-pair__label,
  .info-reward-label {
    word-wrap: normal;
    overflow-wrap: normal;
    word-break: keep-all;
    hyphens: none;
    white-space: nowrap;
    min-width: var(--info-label-col);
  }

  .info-intro {
    grid-column: 1 / -1;
    margin-top: calc(300px - var(--page-header-height));
    margin-bottom: 0;
    font-size: 72px;
    font-weight: 700;
    letter-spacing: -4px;
    line-height: 1;
  }

  /* 10 колонок: 1 — labels, 2 — values/years, 4 — reward pairs, 6–8 — quote, 9–10 — contacts */
  .info-split,
  .info-split__left,
  .info-split__right,
  .info-reward-row,
  .info-pair {
    display: contents;
  }

  .info-contacts-line {
    grid-column: 9 / 11;
    grid-row: 2;
    margin-top: 70px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0 var(--grid-gutter);
    align-items: start;
    min-width: 0;
  }

  .info-pair__label,
  .info-pair__value,
  .info-reward-label,
  .info-reward-years,
  .info-reward-pairs,
  .info-contacts-handles,
  .info-contacts-short {
    font-size: 14pt;
    font-weight: 500;
    line-height: 1.2;
  }

  .info-pair__label--tight {
    line-height: 1.2;
  }

  .info-split__left .info-pair:nth-child(1) .info-pair__label {
    grid-column: 1;
    grid-row: 2;
    margin-top: 70px;
  }

  .info-split__left .info-pair:nth-child(1) .info-pair__value {
    grid-column: 2 / 4;
    grid-row: 2;
    margin-top: 70px;
  }

  .info-split__left .info-pair:nth-child(2) .info-pair__label {
    grid-column: 1;
    grid-row: 3;
    margin-top: 20px;
  }

  .info-split__left .info-pair:nth-child(2) .info-pair__value {
    grid-column: 2 / 5;
    grid-row: 3;
    margin-top: 20px;
  }

  .info-quote {
    grid-column: 6 / 9;
    grid-row: 2;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.2;
    margin: 70px 0 0;
    align-self: start;
  }

  .info-contacts-handles {
    white-space: nowrap;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    min-width: 0;
  }

  .info-contacts-short {
    text-align: right;
    white-space: nowrap;
  }

  .info-contacts-handles a,
  .info-contacts-short a {
    color: inherit;
    text-decoration: none;
  }

  .info-contacts-handles a:hover,
  .info-contacts-short a:hover {
    color: #B29893;
    text-decoration: none;
  }

  .info-reward-label {
    grid-column: 1;
    grid-row: 4;
    margin-top: 20px;
  }

  .info-reward-years {
    grid-column: 2 / 4;
    grid-row: 4;
    margin-top: 20px;
  }

  .info-reward-pairs {
    grid-column: 4 / 7;
    grid-row: 4;
    margin-top: 20px;
  }

  .info-reward-project {
    color: #B29893;
  }

  @media (max-width: 1024px) and (min-width: 769px) {
    .info-intro {
      font-size: clamp(2rem, 10vw, 4rem);
      letter-spacing: -0.04em;
      margin-top: min(180px, 28vw);
    }

    .info-split__left .info-pair:nth-child(1) .info-pair__label,
    .info-split__left .info-pair:nth-child(1) .info-pair__value,
    .info-quote {
      margin-top: 48px;
    }

    .info-contacts-line {
      display: contents;
    }

    .info-contacts-handles {
      grid-column: 8 / 10;
      grid-row: 4;
      margin-top: 20px;
    }

    .info-contacts-short {
      grid-column: 10;
      grid-row: 4;
      margin-top: 20px;
    }

    .info-split__left .info-pair:nth-child(2) .info-pair__value {
      grid-column: 2 / 6;
    }

    .info-quote {
      grid-column: 6 / 11;
    }
  }

  @media (max-width: 768px) {
    .info-grid {
      display: grid;
      grid-template-columns: var(--info-label-col) repeat(9, minmax(0, 1fr));
      gap: 0 8px;
      align-items: start;
      --info-label-col: 6.75rem;
    }

    .info-split,
    .info-split__left,
    .info-split__right,
    .info-reward-row {
      display: contents;
    }

    .info-pair__label,
    .info-pair__value,
    .info-reward-label,
    .info-reward-years,
    .info-contacts-handles,
    .info-contacts-short {
      font-size: 14px;
      font-weight: 500;
      line-height: 1.2;
      overflow-wrap: normal;
      word-break: keep-all;
      hyphens: none;
    }

    /* Local text-block grid: slightly wider first columns */
    .info-split__left .info-pair {
      display: grid;
      grid-column: 1 / 9;
      grid-template-columns: var(--info-label-col) minmax(0, 1fr) repeat(6, minmax(0, 1fr));
      gap: 0 8px;
      align-items: start;
      min-width: 0;
    }

    /* 1) Large quote: columns 1-7 */
    .info-intro {
      grid-column: 1 / 8;
      grid-row: 1;
      margin-top: 180px;
      margin-bottom: 0;
      font-size: clamp(2.1rem, 10.2vw, 4.1rem);
      letter-spacing: -0.03em;
      line-height: 0.96;
    }

    /* 2) Small quote: columns 3-8, offset 10 */
    .info-quote {
      grid-column: 3 / 9;
      grid-row: 2;
      margin-top: 10px;
      margin-bottom: 0;
      font-size: 12px;
      line-height: 1.2;
      text-align: left;
      max-width: 100%;
    }

    /* 3) Contacts: handles 6–9, labels col 10, offset 40 */
    .info-contacts-line {
      display: contents;
    }

    .info-contacts-handles {
      grid-column: 6 / 10;
      grid-row: 3;
      margin-top: 20px;
      white-space: normal;
      overflow: visible;
    }

    .info-contacts-short {
      grid-column: 10 / 11;
      grid-row: 3;
      margin-top: 20px;
      text-align: right;
      justify-self: end;
      white-space: nowrap;
    }

    /* 4) Name / Based / Alive block: offset 50 */
    .info-split__left .info-pair:nth-child(1) {
      grid-row: 4;
      margin-top: 50px;
    }

    .info-split__left .info-pair:nth-child(1) .info-pair__label {
      grid-column: 1;
      margin-top: 0;
    }

    .info-split__left .info-pair:nth-child(1) .info-pair__value {
      grid-column: 2 / 6;
      margin-top: 0;
    }

    /* 5) Education / Work block: offset 20 */
    .info-split__left .info-pair:nth-child(2) {
      grid-row: 5;
      margin-top: 20px;
    }

    .info-split__left .info-pair:nth-child(2) .info-pair__label {
      grid-column: 1;
      margin-top: 0;
    }

    .info-split__left .info-pair:nth-child(2) .info-pair__value {
      grid-column: 2 / 9;
      margin-top: 0;
    }

    /* 6) Reward block: offset 20 */
    .info-reward-label {
      grid-column: 1;
      grid-row: 6;
      margin-top: 20px;
    }

    .info-reward-years {
      grid-column: 2 / 6;
      grid-row: 6;
      margin-top: 20px;
    }

    .info-reward-pairs {
      display: none;
    }
  }
</style>
