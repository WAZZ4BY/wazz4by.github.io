---
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerPageHeader from '../components/InnerPageHeader.astro';
import { getResearchCards, type ResearchCard } from '../lib/researchCards';

const researchItems = getResearchCards();
const base = import.meta.env.BASE_URL;

function resolveMediaSrc(src: string): string {
  const value = String(src || '').trim();
  if (!value || value.startsWith('http') || value.startsWith('<')) return value;
  return `${base}${value.replace(/^\//, '')}`;
}

function extractIframeSrc(raw: string): string {
  const s = String(raw || '').trim();
  const m = s.match(/<iframe[\s\S]*?src=["']([^"']+)["']/i);
  if (m && m[1]) return m[1].trim();
  return s;
}

function getKinescopeEmbedUrl(raw: string): string {
  const s = extractIframeSrc(raw);
  if (!s) return '';
  if (/kinescope\.(io|ru)\/embed\//.test(s)) return s;
  if (/player\.vimeo\.com\/video\//.test(s) || /vimeo\.com\//.test(s)) return s;
  const m = s.match(/https?:\/\/(?:kinescope\.(?:io|ru))\/([^/?#]+)/);
  if (m && m[1]) return `https://kinescope.io/embed/${m[1]}?autoplay=1&muted=1`;
  return s;
}

type CoverSpan = 2 | 4 | 6 | 8;

function coverLayout(item: ResearchCard): { fit: 'height' | 'cols'; span: CoverSpan } {
  const raw = Number(item.spanW);
  const span: CoverSpan = raw === 2 || raw === 4 || raw === 6 || raw === 8 ? raw : 4;
  return { fit: item.coverFit === 'height' ? 'height' : 'cols', span };
}

const payload = researchItems.map((item, index) => {
  const link = (item.links || []).find((entry) => entry && String(entry.url || '').trim());
  return {
    index,
    name: item.caption || '',
    date: item.date || '',
    text: item.text || '',
    url: link ? String(link.url).trim() : '',
    screens: item.screens.map((screen) => ({
      items: screen.items.map((entry) => ({
        src: resolveMediaSrc(entry.src),
        as: entry.as,
        span: entry.span,
        fit: entry.fit,
        ar: entry.aspectRatio,
        alt: entry.alt || item.caption || '',
        embed: entry.as === 'kinescope' ? getKinescopeEmbedUrl(entry.src) : '',
      })),
    })),
  };
});
---

<BaseLayout title="Research" variant="inner" hideHeader bodyClass="page-research" themeColor="#000000">
  <InnerPageHeader activePage="research" />
  <div class="rf-stage" aria-live="polite">
    {researchItems.map((item, index) => {
      const label = item.caption || item.alt || `Research ${item.number}`;
      const mediaSrc = resolveMediaSrc(item.src);
      const cover = coverLayout(item);
      const canOpen = item.screens.length > 0;
      return (
        <article
          class="rf-slide"
          data-index={index}
          data-fit={cover.fit}
          data-span={cover.span}
          style={`--ar: ${item.aspectRatio}; --rf-span: ${cover.span};`}
          aria-label={label}
        >
          <div class="rf-slide__frame">
            {item.as === 'kinescope' ? (
              <iframe
                src={getKinescopeEmbedUrl(item.src)}
                title={item.alt || label}
                frameborder="0"
                allow="autoplay; fullscreen; picture-in-picture"
                allowfullscreen
              />
            ) : item.as === 'video' ? (
              <video
                src={mediaSrc}
                muted
                playsinline
                loop
                autoplay
                preload="metadata"
              />
            ) : item.as === 'audio' ? (
              <div class="rf-slide__audio">
                <span class="rf-slide__audio-icon" aria-hidden="true">♪</span>
                <span class="rf-slide__audio-label">{item.caption || item.alt || 'Audio'}</span>
              </div>
            ) : (
              <img src={mediaSrc} alt={item.alt || label} draggable="false" />
            )}
            {canOpen && (
              <button class="rf-slide__open" type="button" aria-label={`Open ${label}`}></button>
            )}
          </div>
        </article>
      );
    })}
  </div>

  <div class="rf-info">
    <div class="rf-info__stack" hidden>
      <div class="rf-info__row">
        <div class="rf-blur rf-info__chip rf-info__chip--name" hidden><span class="rf-info__label"></span></div>
        <div class="rf-blur rf-info__chip rf-info__chip--date" hidden><span class="rf-info__label"></span></div>
      </div>
      <div class="rf-blur rf-info__chip rf-info__chip--text" hidden><span class="rf-info__label"></span></div>
    </div>
    <button class="rf-blur rf-info__toggle" type="button" aria-label="Project info" aria-expanded="false">
      <span class="rf-info__plus" aria-hidden="true">
        <span class="rf-info__bar rf-info__bar--h"></span>
        <span class="rf-info__bar rf-info__bar--v"></span>
      </span>
    </button>
  </div>

  <div class="rf-inner" hidden>
    <div class="rf-inner__stage"></div>
  </div>

  <nav class="rf-nav" hidden>
    <button class="rf-blur rf-nav__btn rf-nav__btn--prev" type="button" aria-label="Previous">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M14.5 5.5 8 12l6.5 6.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <button class="rf-blur rf-nav__close" type="button" aria-label="Close">
      <span class="rf-nav__close-name"></span>
      <span class="rf-nav__close-x" aria-hidden="true">
        <span class="rf-nav__close-bar rf-nav__close-bar--h"></span>
        <span class="rf-nav__close-bar rf-nav__close-bar--v"></span>
      </span>
    </button>
    <button class="rf-blur rf-nav__btn rf-nav__btn--next" type="button" aria-label="Next">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M9.5 5.5 16 12l-6.5 6.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </nav>
</BaseLayout>

<script is:inline define:vars={{ payload }}>
  window.__RF_DATA__ = payload;
</script>

<style is:global>
  html:has(body.page-research),
  body.page-research {
    background: #000;
    --page-bg: #000;
    overflow: hidden;
    height: 100%;
    overscroll-behavior: none;
    scrollbar-width: none;
    -ms-overflow-style: none;
    touch-action: none;
  }

  html:has(body.page-research)::-webkit-scrollbar,
  body.page-research::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }

  body.page-research .page-backdrop {
    background: #000;
  }
</style>

<style is:global>
  .rf-stage,
  .rf-inner {
    position: fixed;
    inset: 0;
    z-index: 1;
    background: #000;
  }

  .rf-inner {
    z-index: 4;
    display: none;
  }

  .rf-inner.is-open {
    display: block;
  }

  .rf-slide,
  .rf-inner__screen {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(var(--grid-cols), minmax(0, 1fr));
    grid-template-rows: minmax(0, 1fr);
    column-gap: var(--grid-gutter);
    align-items: center;
    padding: 0 var(--grid-margin);
    box-sizing: border-box;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
  }

  .rf-slide:first-child {
    opacity: 1;
    visibility: visible;
  }

  .rf-slide__frame,
  .rf-inner__cell {
    position: relative;
    z-index: 1;
    line-height: 0;
    background: transparent;
  }

  .rf-slide__frame {
    grid-column: 1 / -1;
    grid-row: 1;
    justify-self: center;
    align-self: center;
  }

  .rf-slide[data-fit='height'] .rf-slide__frame,
  .rf-inner__cell[data-fit='height'] {
    height: 100%;
    width: auto;
    aspect-ratio: var(--ar);
  }

  .rf-slide[data-fit='cols'] .rf-slide__frame {
    width: min(
      calc(
        var(--rf-span, 4) * (100% - (var(--grid-cols) - 1) * var(--grid-gutter)) / var(--grid-cols)
        + (var(--rf-span, 4) - 1) * var(--grid-gutter)
      ),
      calc(100dvh * var(--ar))
    );
    max-width: 100%;
    max-height: 100%;
    aspect-ratio: var(--ar);
  }

  @media (max-width: 768px) {
    .rf-slide[data-fit='cols'] .rf-slide__frame,
    .rf-slide[data-fit='height'] .rf-slide__frame {
      height: 100%;
      width: auto;
      max-width: none;
      max-height: 100%;
      aspect-ratio: var(--ar);
    }
  }

  .rf-inner__cell[data-fit='cols'] {
    width: var(--rf-w);
    max-width: 100%;
    max-height: 100%;
    aspect-ratio: var(--ar);
  }

  .rf-slide__frame img,
  .rf-slide__frame video,
  .rf-slide__frame iframe,
  .rf-inner__cell img,
  .rf-inner__cell video,
  .rf-inner__cell iframe {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    border: 0;
    background: transparent;
    -webkit-user-drag: none;
    user-select: none;
  }

  .rf-slide__frame iframe,
  .rf-slide__frame video,
  .rf-inner__cell iframe,
  .rf-inner__cell video {
    position: absolute;
    inset: 0;
  }

  .rf-slide__frame iframe,
  .rf-slide__frame video {
    pointer-events: none;
  }

  .rf-slide__open {
    position: absolute;
    inset: 0;
    z-index: 3;
    border: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
  }

  .rf-slide__open:focus,
  .rf-slide__open:focus-visible {
    outline: none;
  }

  .rf-slide__audio {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: #111;
    color: #fff;
  }

  .rf-inner__stage {
    position: absolute;
    inset: 0;
  }

  .rf-inner__screen {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 var(--grid-margin);
  }

  .rf-inner__row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--grid-gutter);
    height: 100%;
    width: 100%;
    max-width: 100%;
  }

  .rf-inner__cell {
    flex: 0 0 auto;
  }

  /* mouthwash.studio header buttons — текст свой */
  .rf-blur {
    appearance: none;
    -webkit-appearance: none;
    color: #fff;
    line-height: 0.9;
    letter-spacing: -0.03em;
    white-space: nowrap;
    text-box-trim: trim-both;
    text-box-edge: cap alphabetic;
    transition:
      color 0.25s,
      background-color 0.25s,
      border-color 0.25s;
    -webkit-backdrop-filter: blur(1rem);
    backdrop-filter: blur(1rem);
    background-color: rgba(255, 255, 255, 0.1);
    border-style: solid;
    border-color: transparent;
    border-width: 0.5px 0 0 0.5px;
    outline: none;
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .rf-blur:hover {
    border-color: rgba(255, 255, 255, 0.5);
  }

  .rf-info {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 30px;
    z-index: 7;
    width: max-content;
    max-width: calc(100vw - (var(--grid-margin) * 2));
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    pointer-events: none;
  }

  body.rf-inner-open .rf-info {
    display: none;
  }

  .rf-info__stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    pointer-events: none;
  }

  .rf-info__stack[hidden] {
    display: none;
  }

  .rf-info__row {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    gap: 10px;
  }

  .rf-info__chip {
    pointer-events: auto;
    box-sizing: border-box;
    max-width: calc(100vw - (var(--grid-margin) * 2));
    padding: 6px 12px;
    border-radius: 20px;
    text-align: center;
    text-decoration: none;
    color: inherit;
  }

  .rf-info__chip--name.is-link {
    cursor: pointer;
    border-color: rgba(255, 255, 255, 0.5);
  }

  .rf-info__chip[hidden] {
    display: none !important;
  }

  .rf-info__chip--text {
    --rf-text-span: 4;
    width: calc(
      var(--rf-text-span) * ((100vw - (var(--grid-margin) * 2) - ((var(--grid-cols) - 1) * var(--grid-gutter))) / var(--grid-cols))
      + (var(--rf-text-span) - 1) * var(--grid-gutter)
    );
    max-width: calc(100vw - (var(--grid-margin) * 2));
    text-align: center;
    white-space: normal;
  }

  .rf-info__chip--text .rf-info__label {
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    text-align: center;
    white-space: pre-wrap;
  }

  .rf-info__label {
    display: block;
    font-family: 'SuisseIntl', sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: #fff;
    opacity: 0.3;
    mix-blend-mode: soft-light;
    white-space: nowrap;
    transition: opacity 0.25s ease;
  }

  .rf-info__chip:hover .rf-info__label {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .rf-info {
      left: var(--grid-margin);
      right: var(--grid-margin);
      width: auto;
      max-width: none;
      margin-inline: 0;
      align-items: flex-start;
    }

    .rf-info__stack {
      align-items: flex-start;
      width: 100%;
    }

    .rf-info__row {
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      flex-wrap: wrap;
    }

    .rf-info__chip {
      max-width: 100%;
      padding: 8px 16px;
      text-align: left;
    }

    .rf-info__label {
      font-size: 18px;
      line-height: 20px;
      text-align: left;
    }

    .rf-info__chip--name .rf-info__label,
    .rf-info__chip--date .rf-info__label {
      opacity: 1;
    }

    .rf-info__chip--text {
      width: calc(
        5 * ((100% - (var(--grid-cols) - 1) * var(--grid-gutter)) / var(--grid-cols))
        + 4 * var(--grid-gutter)
      );
      max-width: 100%;
      align-self: flex-start;
      text-align: left;
    }

    .rf-info__chip--text .rf-info__label {
      font-size: 14px;
      line-height: 16px;
      text-align: left;
    }

    .rf-blur:hover {
      border-color: transparent;
    }

    .rf-info__chip--name.is-link,
    .rf-info__chip--name.is-link:hover {
      border-color: rgba(255, 255, 255, 0.5);
    }

    .rf-info__chip:hover .rf-info__label {
      opacity: 0.3;
    }

    .rf-info__chip--name:hover .rf-info__label,
    .rf-info__chip--date:hover .rf-info__label {
      opacity: 1;
    }

    .rf-info__toggle {
      display: none;
    }
  }

  .rf-info__toggle {
    pointer-events: auto;
    width: 42px;
    height: 42px;
    padding: 0;
    border-radius: 50%;
    color: rgba(255, 255, 255, 0.3);
    cursor: pointer;
  }

  .rf-info__toggle:hover {
    color: #fff;
  }

  .rf-info__toggle:focus,
  .rf-info__toggle:focus-visible {
    outline: none;
  }

  .rf-info__plus {
    position: relative;
    width: 14px;
    height: 14px;
    display: block;
    transition: transform 0.28s ease;
  }

  .rf-info.is-open .rf-info__plus {
    transform: rotate(45deg);
  }

  .rf-info__bar {
    position: absolute;
    background: currentColor;
    border-radius: 1px;
  }

  .rf-info__bar--h {
    left: 0;
    top: 50%;
    width: 14px;
    height: 1.5px;
    transform: translateY(-50%);
  }

  .rf-info__bar--v {
    top: 0;
    left: 50%;
    width: 1.5px;
    height: 14px;
    transform: translateX(-50%);
  }

  .rf-nav {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 30px;
    z-index: 8;
    width: max-content;
    max-width: calc(100vw - (var(--grid-margin) * 2));
    margin-inline: auto;
    display: none;
    align-items: center;
    gap: 10px;
  }

  .rf-nav.is-open {
    display: flex;
  }

  .rf-nav__btn,
  .rf-nav__close {
    color: rgba(255, 255, 255, 0.3);
    cursor: pointer;
  }

  .rf-nav__btn:hover:not(:disabled),
  .rf-nav__close:hover {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.5);
  }

  .rf-nav__btn {
    flex: 0 0 auto;
    width: 42px;
    height: 42px;
    padding: 0;
    border-radius: 50%;
  }

  .rf-nav__btn svg {
    width: 14px;
    height: 14px;
    display: block;
  }

  .rf-nav__btn:disabled {
    color: rgba(255, 255, 255, 0.3);
    border-color: transparent;
    cursor: default;
  }

  .rf-nav__btn:disabled:hover {
    color: rgba(255, 255, 255, 0.3);
    border-color: transparent;
  }

  .rf-nav__close {
    flex: 0 1 auto;
    min-width: 0;
    height: 42px;
    padding: 6px 12px;
    border-radius: 20px;
    gap: 10px;
  }

  .rf-nav__close-name {
    font-family: 'SuisseIntl', sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: inherit;
    mix-blend-mode: soft-light;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .rf-nav__close-x {
    position: relative;
    flex: 0 0 auto;
    width: 14px;
    height: 14px;
    display: block;
    transform: rotate(45deg);
  }

  .rf-nav__close-bar {
    position: absolute;
    background: currentColor;
    border-radius: 1px;
  }

  .rf-nav__close-bar--h {
    left: 0;
    top: 50%;
    width: 14px;
    height: 1.5px;
    transform: translateY(-50%);
  }

  .rf-nav__close-bar--v {
    top: 0;
    left: 50%;
    width: 1.5px;
    height: 14px;
    transform: translateX(-50%);
  }

  .rf-nav__btn:focus,
  .rf-nav__btn:focus-visible,
  .rf-nav__close:focus,
  .rf-nav__close:focus-visible {
    outline: none;
  }

  @media (max-width: 768px) {
    .rf-nav {
      left: var(--grid-margin);
      right: var(--grid-margin);
      margin-inline: 0;
      width: auto;
      max-width: none;
      justify-content: center;
    }

    .rf-nav__btn,
    .rf-nav__btn:hover:not(:disabled),
    .rf-nav__btn:disabled,
    .rf-nav__btn:disabled:hover {
      color: #fff;
      border-color: transparent;
    }

    .rf-nav__close,
    .rf-nav__close:hover {
      color: #fff;
      border-color: transparent;
    }

    .rf-nav__close {
      padding: 8px 16px;
    }

    .rf-nav__close-name {
      font-size: 18px;
      line-height: 20px;
    }
  }
</style>

<script>
  (function () {
    const stage = document.querySelector('.rf-stage');
    const slides = Array.from(document.querySelectorAll('.rf-slide'));
    const inner = document.querySelector('.rf-inner');
    const innerStage = document.querySelector('.rf-inner__stage');
    const nav = document.querySelector('.rf-nav');
    const prevBtn = document.querySelector('.rf-nav__btn--prev');
    const nextBtn = document.querySelector('.rf-nav__btn--next');
    const closeBtn = document.querySelector('.rf-nav__close');
    const closeName = document.querySelector('.rf-nav__close-name');
    const info = document.querySelector('.rf-info');
    const infoToggle = document.querySelector('.rf-info__toggle');
    const infoStack = document.querySelector('.rf-info__stack');
    const infoName = document.querySelector('.rf-info__chip--name');
    const infoDate = document.querySelector('.rf-info__chip--date');
    const infoText = document.querySelector('.rf-info__chip--text');
    if (!stage || !inner || !innerStage || !nav || !prevBtn || !nextBtn || !closeBtn || !closeName || !info || !infoToggle || !infoStack || !infoName || !infoDate || !infoText || slides.length === 0) return;

    const projects = Array.isArray(window.__RF_DATA__) ? window.__RF_DATA__ : [];

    const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fadeOutMs = reduceMotion ? 0 : 420;
    const fadeInMs = reduceMotion ? 0 : 420;
    const fadeGapMs = reduceMotion ? 0 : 90;
    const wheelThreshold = 70;
    const swipeThreshold = 56;

    let current = 0;
    let screenIndex = 0;
    let innerOpen = false;
    let infoOpen = false;
    let busy = false;
    let wheelAcc = 0;
    let touchY = 0;

    function gridCols() {
      const v = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--grid-cols'), 10);
      return v > 0 ? v : 12;
    }

    function gridMetrics() {
      const cols = gridCols();
      const gutter = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--grid-gutter')) || 20;
      const margin = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--grid-margin')) || 30;
      const width = Math.max(0, window.innerWidth - margin * 2);
      const col = (width - (cols - 1) * gutter) / cols;
      return { cols: cols, gutter: gutter, margin: margin, width: width, col: col };
    }

    function spanWidth(span, metrics) {
      const n = Math.max(1, Math.min(metrics.cols, Number(span) || 4));
      return n * metrics.col + Math.max(0, n - 1) * metrics.gutter;
    }

    function wait(ms) {
      if (!ms) return Promise.resolve();
      return new Promise(function (resolve) { setTimeout(resolve, ms); });
    }

    function animateOpacity(el, from, to, ms) {
      return new Promise(function (resolve) {
        if (!el) return resolve();
        el.style.visibility = 'visible';
        if (!ms || from === to) {
          el.style.opacity = String(to);
          if (to <= 0.004) el.style.visibility = 'hidden';
          return resolve();
        }
        const t0 = performance.now();
        function frame(now) {
          const u = Math.min(1, (now - t0) / ms);
          const e = u * u * (3 - 2 * u);
          const value = from + (to - from) * e;
          el.style.opacity = String(value);
          if (u < 1) {
            requestAnimationFrame(frame);
          } else {
            el.style.opacity = String(to);
            if (to <= 0.004) el.style.visibility = 'hidden';
            resolve();
          }
        }
        requestAnimationFrame(frame);
      });
    }

    function syncVideo(slide, on) {
      if (!slide) return;
      const video = slide.querySelector('video');
      if (!video) return;
      if (on) {
        const play = video.play();
        if (play && typeof play.catch === 'function') play.catch(function () {});
      } else {
        video.pause();
      }
    }

    function layoutCover(slide) {
      if (!slide || slide.getAttribute('data-fit') !== 'cols') return;
      const span = parseInt(slide.getAttribute('data-span') || '4', 10);
      const ar = parseFloat(slide.style.getPropertyValue('--ar')) || 1;
      const metrics = gridMetrics();
      const maxH = window.innerHeight;
      let w = spanWidth(span, metrics);
      if (ar > 0 && w / ar > maxH) w = maxH * ar;
      slide.style.setProperty('--rf-w', Math.round(w) + 'px');
    }

    function layoutCovers() {
      slides.forEach(layoutCover);
    }

    function currentScreens() {
      const project = projects[current];
      return project && Array.isArray(project.screens) ? project.screens : [];
    }

    function updateNav() {
      const screens = currentScreens();
      const project = projects[current] || {};
      const canMove = innerOpen && screens.length > 1;
      prevBtn.disabled = !canMove;
      nextBtn.disabled = !canMove;
      const title = String(project.name || '').trim();
      closeName.textContent = title;
      closeName.hidden = !title;
    }

    function setChip(el, value) {
      const text = String(value || '').trim();
      const label = el.querySelector('.rf-info__label');
      if (label) label.textContent = text;
      else el.textContent = text;
      el.hidden = !text;
    }

    function layoutTextChip() {
      if (!infoText || infoText.hidden) return;
      if (isMobileInfo()) {
        infoText.style.setProperty('--rf-text-span', '5');
        return;
      }
      const label = infoText.querySelector('.rf-info__label');
      const len = String((label && label.textContent) || '').trim().length;
      let span = 4;
      if (len > 140) span = 6;
      if (len > 320) span = 8;
      infoText.style.setProperty('--rf-text-span', String(span));
    }

    function setNameChip(name, url) {
      setChip(infoName, name);
      const href = String(url || '').trim();
      infoName.classList.toggle('is-link', Boolean(href));
      infoName.setAttribute('data-url', href);
      if (href) {
        infoName.setAttribute('role', 'link');
        infoName.setAttribute('tabindex', '0');
      } else {
        infoName.removeAttribute('role');
        infoName.removeAttribute('tabindex');
      }
    }

    function isMobileInfo() {
      return window.matchMedia('(max-width: 768px)').matches;
    }

    function applyInfoOpen(open) {
      infoOpen = open;
      info.classList.toggle('is-open', open);
      infoStack.hidden = !open;
      infoToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    function syncInfo() {
      const project = projects[current] || {};
      setNameChip(project.name, project.url);
      setChip(infoDate, project.date);
      setChip(infoText, project.text);
      layoutTextChip();
      const hasAny = !infoName.hidden || !infoDate.hidden || !infoText.hidden;
      if (isMobileInfo()) {
        applyInfoOpen(hasAny);
        return;
      }
      if (!hasAny && infoOpen) applyInfoOpen(false);
    }

    function openInfo() {
      syncInfo();
      if (isMobileInfo()) return;
      if (infoName.hidden && infoDate.hidden && infoText.hidden) return;
      applyInfoOpen(true);
    }

    function closeInfo() {
      if (isMobileInfo()) {
        syncInfo();
        return;
      }
      applyInfoOpen(false);
    }

    function toggleInfo() {
      if (innerOpen || busy || isMobileInfo()) return;
      if (infoOpen) closeInfo();
      else openInfo();
    }

    function mediaEl(item) {
      if (item.as === 'kinescope') {
        const iframe = document.createElement('iframe');
        iframe.src = item.embed || item.src;
        iframe.title = item.alt || '';
        iframe.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture');
        iframe.setAttribute('allowfullscreen', '');
        iframe.setAttribute('frameborder', '0');
        return iframe;
      }
      if (item.as === 'video') {
        const video = document.createElement('video');
        video.src = item.src;
        video.muted = true;
        video.loop = true;
        video.autoplay = true;
        video.playsInline = true;
        video.setAttribute('playsinline', '');
        video.preload = 'metadata';
        return video;
      }
      const img = document.createElement('img');
      img.src = item.src;
      img.alt = item.alt || '';
      img.draggable = false;
      return img;
    }

    function layoutInnerScreen(screenEl) {
      if (!screenEl) return;
      const metrics = gridMetrics();
      const cells = Array.from(screenEl.querySelectorAll('.rf-inner__cell'));
      const widths = cells.map(function (cell) {
        if (cell.getAttribute('data-fit') === 'height') return 0;
        return spanWidth(cell.getAttribute('data-span') || '4', metrics);
      });
      const gaps = Math.max(0, cells.length - 1) * metrics.gutter;
      const total = widths.reduce(function (sum, w) { return sum + w; }, 0) + gaps;
      const scale = total > metrics.width && total > 0 ? metrics.width / total : 1;
      cells.forEach(function (cell, i) {
        if (cell.getAttribute('data-fit') === 'height') return;
        cell.style.setProperty('--rf-w', Math.round(widths[i] * scale) + 'px');
      });
    }

    function buildInnerScreen(index) {
      const screens = currentScreens();
      const screen = screens[index];
      if (!screen) return null;
      const screenEl = document.createElement('div');
      screenEl.className = 'rf-inner__screen';
      const row = document.createElement('div');
      row.className = 'rf-inner__row';
      screen.items.forEach(function (item) {
        const cell = document.createElement('div');
        cell.className = 'rf-inner__cell';
        cell.setAttribute('data-fit', item.fit || 'cols');
        cell.setAttribute('data-span', String(item.span || 4));
        cell.style.setProperty('--rf-span', String(item.span || 4));
        cell.style.setProperty('--ar', String(item.ar || 1));
        cell.appendChild(mediaEl(item));
        row.appendChild(cell);
      });
      screenEl.appendChild(row);
      return screenEl;
    }

    function mountInnerScreen(index) {
      innerStage.innerHTML = '';
      const screenEl = buildInnerScreen(index);
      if (!screenEl) return null;
      innerStage.appendChild(screenEl);
      layoutInnerScreen(screenEl);
      return screenEl;
    }

    async function goProject(next) {
      const n = slides.length;
      if (!n || busy || innerOpen) return;
      const target = ((next % n) + n) % n;
      if (target === current) return;
      busy = true;
      wheelAcc = 0;
      closeInfo();
      const from = slides[current];
      const to = slides[target];
      layoutCover(to);
      from.style.zIndex = '2';
      to.style.zIndex = '3';
      syncVideo(to, true);
      await animateOpacity(from, 1, 0, fadeOutMs);
      syncVideo(from, false);
      await wait(fadeGapMs);
      await animateOpacity(to, 0, 1, fadeInMs);
      current = target;
      syncInfo();
      busy = false;
    }

    async function goScreen(next) {
      const screens = currentScreens();
      const n = screens.length;
      if (!innerOpen || busy || !n) return;
      const target = ((next % n) + n) % n;
      if (target === screenIndex) return;
      busy = true;
      wheelAcc = 0;
      const from = innerStage.querySelector('.rf-inner__screen');
      const incoming = buildInnerScreen(target);
      if (!incoming) {
        busy = false;
        return;
      }
      innerStage.appendChild(incoming);
      layoutInnerScreen(incoming);
      incoming.style.zIndex = '3';
      if (from) from.style.zIndex = '2';
      if (from) await animateOpacity(from, 1, 0, fadeOutMs);
      await wait(fadeGapMs);
      await animateOpacity(incoming, 0, 1, fadeInMs);
      if (from) from.remove();
      screenIndex = target;
      updateNav();
      busy = false;
    }

    async function openInner() {
      const screens = currentScreens();
      if (busy || innerOpen || !screens.length) return;
      busy = true;
      wheelAcc = 0;
      closeInfo();
      const cover = slides[current];
      screenIndex = 0;
      inner.hidden = false;
      inner.classList.add('is-open');
      document.body.classList.add('rf-inner-open');
      const first = mountInnerScreen(0);
      await animateOpacity(cover, 1, 0, fadeOutMs);
      syncVideo(cover, false);
      await wait(fadeGapMs);
      innerOpen = true;
      nav.hidden = false;
      nav.classList.add('is-open');
      updateNav();
      await animateOpacity(first, 0, 1, fadeInMs);
      busy = false;
    }

    async function closeInner() {
      if (busy || !innerOpen) return;
      busy = true;
      wheelAcc = 0;
      const screenEl = innerStage.querySelector('.rf-inner__screen');
      const cover = slides[current];
      nav.classList.remove('is-open');
      nav.hidden = true;
      await animateOpacity(screenEl, 1, 0, fadeOutMs);
      await wait(fadeGapMs);
      inner.classList.remove('is-open');
      inner.hidden = true;
      innerStage.innerHTML = '';
      document.body.classList.remove('rf-inner-open');
      layoutCover(cover);
      syncVideo(cover, true);
      await animateOpacity(cover, 0, 1, fadeInMs);
      innerOpen = false;
      screenIndex = 0;
      busy = false;
    }

    function onIntent(dir) {
      if (busy) return;
      if (innerOpen) {
        goScreen(screenIndex + dir);
        return;
      }
      goProject(current + dir);
    }

    function onWheel(e) {
      e.preventDefault();
      if (busy || innerOpen) return;
      wheelAcc += e.deltaY;
      if (wheelAcc >= wheelThreshold) {
        wheelAcc = 0;
        onIntent(1);
      } else if (wheelAcc <= -wheelThreshold) {
        wheelAcc = 0;
        onIntent(-1);
      }
    }

    slides.forEach(function (slide) {
      const open = slide.querySelector('.rf-slide__open');
      if (!open) return;
      open.addEventListener('click', function (e) {
        e.preventDefault();
        const index = Number(slide.getAttribute('data-index')) || 0;
        if (index !== current || busy || innerOpen) return;
        openInner();
      });
    });

    infoToggle.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      toggleInfo();
    });

    function openNameLink() {
      const href = infoName.getAttribute('data-url') || '';
      if (!href || !infoName.classList.contains('is-link')) return;
      window.open(href, '_blank', 'noopener,noreferrer');
    }

    infoName.addEventListener('click', function (e) {
      if (!infoName.classList.contains('is-link')) return;
      e.preventDefault();
      e.stopPropagation();
      openNameLink();
    });

    infoName.addEventListener('keydown', function (e) {
      if (!infoName.classList.contains('is-link')) return;
      if (e.key !== 'Enter' && e.key !== ' ') return;
      e.preventDefault();
      openNameLink();
    });

    prevBtn.addEventListener('click', function () { onIntent(-1); });
    nextBtn.addEventListener('click', function () { onIntent(1); });
    closeBtn.addEventListener('click', function () {
      if (busy || !innerOpen) return;
      closeInner();
    });

    window.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        if (infoOpen && !innerOpen) {
          e.preventDefault();
          closeInfo();
          return;
        }
        if (innerOpen) {
          e.preventDefault();
          closeInner();
          return;
        }
      }
      if (innerOpen && (e.key === 'ArrowDown' || e.key === 'ArrowUp')) {
        e.preventDefault();
        return;
      }
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        onIntent(1);
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        onIntent(-1);
      }
    });

    window.addEventListener('wheel', onWheel, { passive: false });

    window.addEventListener('touchstart', function (e) {
      if (!e.changedTouches || !e.changedTouches[0]) return;
      touchY = e.changedTouches[0].clientY;
    }, { passive: true });

    window.addEventListener('touchmove', function (e) {
      e.preventDefault();
    }, { passive: false });

    window.addEventListener('touchend', function (e) {
      if (busy || innerOpen || !e.changedTouches || !e.changedTouches[0]) return;
      const dy = touchY - e.changedTouches[0].clientY;
      if (Math.abs(dy) < swipeThreshold) return;
      onIntent(dy > 0 ? 1 : -1);
    }, { passive: true });

    window.addEventListener('resize', function () {
      layoutCovers();
      syncInfo();
      const screenEl = innerStage.querySelector('.rf-inner__screen');
      if (screenEl) layoutInnerScreen(screenEl);
    });

    syncInfo();
    layoutCovers();
    slides.forEach(function (slide, i) {
      slide.style.opacity = i === 0 ? '1' : '0';
      slide.style.visibility = i === 0 ? 'visible' : 'hidden';
      syncVideo(slide, i === 0);
    });
  })();
</script>
