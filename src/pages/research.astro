</style>

<script>
  (function () {
    const stage = document.querySelector('.rf-stage');
    const slides = Array.from(document.querySelectorAll('.rf-slide'));
    const inner = document.querySelector('.rf-inner');
    const innerStage = document.querySelector('.rf-inner__stage');
    const nav = document.querySelector('.rf-nav');
    const prevBtn = document.querySelector('.rf-nav__btn--prev');
    const nextBtn = document.querySelector('.rf-nav__btn--next');
    const closeBtn = document.querySelector('.rf-nav__close');
    const closeName = document.querySelector('.rf-nav__close-name');
    const info = document.querySelector('.rf-info');
    const infoToggle = document.querySelector('.rf-info__toggle');
    const infoStack = document.querySelector('.rf-info__stack');
    const infoName = document.querySelector('.rf-info__chip--name');
    const infoDate = document.querySelector('.rf-info__chip--date');
    const infoText = document.querySelector('.rf-info__chip--text');
    if (!stage || !inner || !innerStage || !nav || !prevBtn || !nextBtn || !closeBtn || !closeName || !info || !infoToggle || !infoStack || !infoName || !infoDate || !infoText || slides.length === 0) return;

    const projects = Array.isArray(window.__RF_DATA__) ? window.__RF_DATA__ : [];

    const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fadeOutMs = reduceMotion ? 0 : 270;
    const fadeInMs = reduceMotion ? 0 : 270;
    const fadeGapMs = reduceMotion ? 0 : 60;
    const wheelThreshold = 70;
    const swipeThreshold = 56;

    let current = 0;
    let screenIndex = 0;
    let innerOpen = false;
    let audioInner = false;
    let infoOpen = false;
    let busy = false;
    let wheelAcc = 0;
    let touchY = 0;
    let audioRaf = 0;
    let audioSeeking = false;

    const PLAY_ICON = '<svg class="rf-audio-play__icon rf-audio-play__icon--play" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M9.15 6.35c0-1.02 1.08-1.66 1.95-1.15l8.2 4.85a1.32 1.32 0 0 1 0 2.3l-8.2 4.85c-.87.51-1.95-.13-1.95-1.15V6.35z"/></svg>';
    const PAUSE_ICON = '<svg class="rf-audio-play__icon rf-audio-play__icon--pause" viewBox="0 0 24 24" aria-hidden="true" hidden><rect x="7" y="6" width="3.6" height="12" rx="1.6" fill="currentColor"/><rect x="13.4" y="6" width="3.6" height="12" rx="1.6" fill="currentColor"/></svg>';

    function gridCols() {
      const v = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--grid-cols'), 10);
      return v > 0 ? v : 12;
    }

    function gridMetrics() {
      const cols = gridCols();
      const gutter = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--grid-gutter')) || 20;
      const margin = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--grid-margin')) || 30;
      const width = Math.max(0, window.innerWidth - margin * 2);
      const col = (width - (cols - 1) * gutter) / cols;
      return { cols: cols, gutter: gutter, margin: margin, width: width, col: col };
    }

    function spanWidth(span, metrics) {
      const n = Math.max(1, Math.min(metrics.cols, Number(span) || 4));
      return n * metrics.col + Math.max(0, n - 1) * metrics.gutter;
    }

    function wait(ms) {
      if (!ms) return Promise.resolve();
      return new Promise(function (resolve) { setTimeout(resolve, ms); });
    }

    function animateOpacity(el, from, to, ms) {
      return new Promise(function (resolve) {
        if (!el) return resolve();
        el.style.visibility = 'visible';
        if (!ms || from === to) {
          el.style.opacity = String(to);
          if (to <= 0.004) el.style.visibility = 'hidden';
          return resolve();
        }
        const t0 = performance.now();
        function frame(now) {
          const u = Math.min(1, (now - t0) / ms);
          const e = u * u * (3 - 2 * u);
          const value = from + (to - from) * e;
          el.style.opacity = String(value);
          if (u < 1) {
            requestAnimationFrame(frame);
          } else {
            el.style.opacity = String(to);
            if (to <= 0.004) el.style.visibility = 'hidden';
            resolve();
          }
        }
        requestAnimationFrame(frame);
      });
    }

    function currentAudio() {
      const slide = slides[current];
      return slide ? slide.querySelector('audio') : null;
    }

    function isAudioProject() {
      const project = projects[current];
      return Boolean(project && project.as === 'audio' && project.audioSrc);
    }

    function setPlayButtonState(btn, playing) {
      if (!btn) return;
      btn.setAttribute('data-playing', playing ? '1' : '0');
      btn.setAttribute('aria-label', playing ? 'Pause' : 'Play');
    }

    const AUDIO_SPIN_SEC = 24;

    function getRotateDeg(el) {
      if (!el) return 0;
      const t = getComputedStyle(el).transform;
      if (!t || t === 'none') return 0;
      const m = new DOMMatrix(t);
      let deg = Math.atan2(m.b, m.a) * (180 / Math.PI);
      if (deg < 0) deg += 360;
      return deg;
    }

    function syncSpin(playing) {
      // Spin only inside the audio player; keep angle on pause
      if (!innerStage) return;
      innerStage.querySelectorAll('.rf-audio-player__disc').forEach(function (disc) {
        const targets = disc.querySelectorAll(':scope > img, :scope > .rf-audio-player__fallback');
        targets.forEach(function (el) {
          if (playing) {
            const deg = getRotateDeg(el);
            el.style.transform = '';
            el.style.animationDelay = (-(deg / 360) * AUDIO_SPIN_SEC) + 's';
            disc.classList.add('is-spinning');
          } else {
            const deg = getRotateDeg(el);
            disc.classList.remove('is-spinning');
            el.style.animation = 'none';
            el.style.animationDelay = '';
            el.style.transform = 'rotate(' + deg + 'deg)';
            // force reflow so next play can restart animation cleanly
            void el.offsetWidth;
            el.style.animation = '';
          }
        });
      });
    }

    function syncPlayButtons(playing) {
      const slide = slides[current];
      if (slide) {
        slide.querySelectorAll('.rf-audio-play').forEach(function (btn) {
          setPlayButtonState(btn, playing);
        });
      }
      if (innerStage) {
        innerStage.querySelectorAll('.rf-audio-play').forEach(function (btn) {
          setPlayButtonState(btn, playing);
        });
      }
      syncSpin(playing);
    }

    function audioProgress() {
      const audio = currentAudio();
      if (!audio || !audio.duration || !Number.isFinite(audio.duration) || audio.duration <= 0) return 0;
      return Math.min(1, Math.max(0, audio.currentTime / audio.duration));
    }

    function setAudioRingProgress(root, progress) {
      if (!root) return;
      const arc = root.querySelector('.rf-audio-ring__progress');
      if (!arc) return;
      const r = Number(arc.getAttribute('data-r') || 47);
      const p = Math.min(1, Math.max(0, Number(progress) || 0));
      const c = 2 * Math.PI * r;
      arc.style.strokeDasharray = String(c);
      arc.style.strokeDashoffset = String(c * (1 - p));
    }

    function updateAudioRing(progress) {
      if (!audioInner) return;
      setAudioRingProgress(innerStage, progress);
    }

    function stopAudioRaf() {
      if (audioRaf) {
        cancelAnimationFrame(audioRaf);
        audioRaf = 0;
      }
    }

    function tickAudioRing() {
      if (!audioInner || audioSeeking) return;
      updateAudioRing(audioProgress());
      const audio = currentAudio();
      if (audio && !audio.paused) {
        audioRaf = requestAnimationFrame(tickAudioRing);
      } else {
        audioRaf = 0;
      }
    }

    function startAudioRaf() {
      stopAudioRaf();
      if (!audioInner) return;
      audioRaf = requestAnimationFrame(tickAudioRing);
    }

    function playCurrentAudio() {
      const audio = currentAudio();
      if (!audio) return;
      const play = audio.play();
      if (play && typeof play.catch === 'function') {
        play.then(function () {
          syncPlayButtons(true);
          startAudioRaf();
        }).catch(function () {
          syncPlayButtons(false);
        });
      } else {
        syncPlayButtons(true);
        startAudioRaf();
      }
    }

    function toggleCurrentAudio() {
      const audio = currentAudio();
      if (!audio) return;
      if (audio.paused) playCurrentAudio();
      else {
        audio.pause();
        syncPlayButtons(false);
        stopAudioRaf();
        updateAudioRing(audioProgress());
      }
    }

    function seekAudioFromEvent(e, ringSvg) {
      const audio = currentAudio();
      if (!audio || !ringSvg) return;
      const rect = ringSvg.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      const clientX = e.clientX != null ? e.clientX : (e.touches && e.touches[0] ? e.touches[0].clientX : 0);
      const clientY = e.clientY != null ? e.clientY : (e.touches && e.touches[0] ? e.touches[0].clientY : 0);
      let progress = (Math.atan2(clientY - cy, clientX - cx) + Math.PI / 2) / (Math.PI * 2);
      if (progress < 0) progress += 1;
      if (!audio.duration || !Number.isFinite(audio.duration)) return;
      audio.currentTime = progress * audio.duration;
      updateAudioRing(progress);
    }

    function bindAudioRing(hitEl) {
      if (!hitEl) return;
      const svg = hitEl.querySelector('svg') || hitEl;
      function onDown(e) {
        e.preventDefault();
        e.stopPropagation();
        if (!audioInner || busy) return;
        audioSeeking = true;
        seekAudioFromEvent(e, svg);
        function onMove(ev) {
          ev.preventDefault();
          seekAudioFromEvent(ev, svg);
        }
        function onUp() {
          audioSeeking = false;
          window.removeEventListener('pointermove', onMove);
          window.removeEventListener('pointerup', onUp);
          if (currentAudio() && !currentAudio().paused) startAudioRaf();
        }
        window.addEventListener('pointermove', onMove, { passive: false });
        window.addEventListener('pointerup', onUp);
      }
      hitEl.addEventListener('pointerdown', onDown);
    }

    function layoutCoverAudioPlayer() {
      const player = innerStage.querySelector('.rf-audio-player');
      if (!player) return;
      if (isMobileInfo()) {
        player.style.width = '100%';
        player.style.removeProperty('--rf-w');
        return;
      }
      if (player.getAttribute('data-fit') !== 'cols') return;
      const span = parseInt(player.getAttribute('data-span') || '4', 10);
      const metrics = gridMetrics();
      const maxH = window.innerHeight;
      let w = spanWidth(span, metrics);
      if (w > maxH) w = maxH;
      player.style.setProperty('--rf-w', Math.round(w) + 'px');
      player.style.width = Math.round(w) + 'px';
    }

    function buildAudioInner() {
      const project = projects[current] || {};
      const screenEl = document.createElement('div');
      screenEl.className = 'rf-inner__screen rf-inner__screen--audio';
      const player = document.createElement('div');
      player.className = 'rf-audio-player';
      player.setAttribute('data-fit', project.fit === 'height' ? 'height' : 'cols');
      player.setAttribute('data-span', String(project.span || 4));
      player.style.setProperty('--rf-span', String(project.span || 4));
      player.style.setProperty('--ar', '1');

      const disc = document.createElement('div');
      disc.className = 'rf-audio-player__disc';

      const coverUrl = (isMobileInfo() && project.coverSrcMobile)
        ? project.coverSrcMobile
        : (project.coverSrc || project.coverSrcMobile || '');
      if (coverUrl) {
        const img = document.createElement('img');
        img.src = coverUrl;
        img.alt = project.name || '';
        img.draggable = false;
        disc.appendChild(img);
      } else {
        const fallback = document.createElement('div');
        fallback.className = 'rf-audio-player__fallback';
        fallback.textContent = '♪';
        disc.appendChild(fallback);
      }

      const ringWrap = document.createElement('div');
      ringWrap.className = 'rf-audio-ring';
      ringWrap.setAttribute('aria-hidden', 'true');
      ringWrap.innerHTML =
        '<svg viewBox="0 0 100 100">' +
          '<circle class="rf-audio-ring__track" cx="50" cy="50" r="47" />' +
          '<circle class="rf-audio-ring__progress" data-r="47" cx="50" cy="50" r="47" transform="rotate(-90 50 50)" />' +
        '</svg>';
      disc.appendChild(ringWrap);

      const hit = document.createElement('div');
      hit.className = 'rf-audio-ring-hit';
      hit.innerHTML =
        '<svg viewBox="0 0 100 100" aria-hidden="true">' +
          '<circle class="rf-audio-ring__hit" cx="50" cy="50" r="47" />' +
        '</svg>';
      disc.appendChild(hit);
      bindAudioRing(hit);

      const playBtn = document.createElement('button');
      playBtn.type = 'button';
      playBtn.className = 'rf-blur rf-audio-play';
      playBtn.innerHTML = PLAY_ICON + PAUSE_ICON;
      const audio = currentAudio();
      setPlayButtonState(playBtn, Boolean(audio && !audio.paused));
      playBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        toggleCurrentAudio();
      });
      disc.appendChild(playBtn);

      player.appendChild(disc);
      screenEl.appendChild(player);
      setAudioRingProgress(screenEl, audioProgress());
      return screenEl;
    }

    function syncMedia(slide, on) {
      if (!slide) return;
      const video = slide.querySelector('video');
      if (video) {
        if (on) {
          const play = video.play();
          if (play && typeof play.catch === 'function') play.catch(function () {});
        } else {
          video.pause();
        }
      }
      // Pause audio only when leaving the project (not when opening audio inner)
      if (!on && !audioInner) {
        const audio = slide.querySelector('audio');
        if (audio) {
          audio.pause();
          stopAudioRaf();
          slide.querySelectorAll('.rf-audio-play').forEach(function (btn) {
            setPlayButtonState(btn, false);
          });
          slide.querySelectorAll('.rf-slide__audio-disc').forEach(function (disc) {
            disc.classList.remove('is-spinning');
          });
        }
      }
    }

    function layoutCover(slide) {
      if (!slide || slide.getAttribute('data-fit') !== 'cols') return;
      const span = parseInt(slide.getAttribute('data-span') || '4', 10);
      let ar = parseFloat(slide.style.getPropertyValue('--ar')) || 1;
      if (slide.getAttribute('data-kind') === 'audio') {
        if (isMobileInfo()) {
          ar = parseFloat(slide.style.getPropertyValue('--ar-mobile')) || ar;
        } else {
          ar = 1; // Desktop audio covers are circular (square)
        }
      }
      const metrics = gridMetrics();
      const maxH = window.innerHeight;
      let w = spanWidth(span, metrics);
      if (ar > 0 && w / ar > maxH) w = maxH * ar;
      slide.style.setProperty('--rf-w', Math.round(w) + 'px');
    }

    function layoutCovers() {
      slides.forEach(layoutCover);
    }

    function currentScreens() {
      const project = projects[current];
      return project && Array.isArray(project.screens) ? project.screens : [];
    }

    function updateNav() {
      const screens = currentScreens();
      const project = projects[current] || {};
      const canMove = innerOpen && !audioInner && screens.length > 1;
      prevBtn.disabled = !canMove;
      nextBtn.disabled = !canMove;
      prevBtn.hidden = !canMove;
      nextBtn.hidden = !canMove;
      const title = String(project.name || '').trim();
      closeName.textContent = title;
      closeName.hidden = !title;
    }

    function setChip(el, value) {
      const text = String(value || '').trim();
      const label = el.querySelector('.rf-info__label');
      if (label) label.textContent = text;
      else el.textContent = text;
      el.hidden = !text;
    }

    function layoutTextChip() {
      if (!infoText || infoText.hidden) return;
      if (isMobileInfo()) {
        infoText.style.setProperty('--rf-text-span', '5');
        return;
      }
      const label = infoText.querySelector('.rf-info__label');
      const len = String((label && label.textContent) || '').trim().length;
      let span = 4;
      if (len > 140) span = 6;
      if (len > 320) span = 8;
      infoText.style.setProperty('--rf-text-span', String(span));
    }

    function setNameChip(name, url) {
      setChip(infoName, name);
      const href = String(url || '').trim();
      infoName.classList.toggle('is-link', Boolean(href));
      infoName.setAttribute('data-url', href);
      if (href) {
        infoName.setAttribute('role', 'link');
        infoName.setAttribute('tabindex', '0');
      } else {
        infoName.removeAttribute('role');
        infoName.removeAttribute('tabindex');
      }
    }

    function isMobileInfo() {
      return window.matchMedia('(max-width: 768px)').matches;
    }

    function applyInfoOpen(open) {
      infoOpen = open;
      info.classList.toggle('is-open', open);
      infoStack.hidden = !open;
      infoToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    function syncInfo() {
      const project = projects[current] || {};
      setNameChip(project.name, project.url);
      setChip(infoDate, project.date);
      setChip(infoText, project.text);
      layoutTextChip();
      const hasAny = !infoName.hidden || !infoDate.hidden || !infoText.hidden;
      if (isMobileInfo()) {
        applyInfoOpen(hasAny);
        return;
      }
      if (!hasAny && infoOpen) applyInfoOpen(false);
    }

    function openInfo() {
      syncInfo();
      if (isMobileInfo()) return;
      if (infoName.hidden && infoDate.hidden && infoText.hidden) return;
      applyInfoOpen(true);
    }

    function closeInfo() {
      if (isMobileInfo()) {
        syncInfo();
        return;
      }
      applyInfoOpen(false);
    }

    function toggleInfo() {
      if (innerOpen || busy || isMobileInfo()) return;
      if (infoOpen) closeInfo();
      else openInfo();
    }

    function mediaEl(item) {
      if (item.as === 'kinescope') {
        const iframe = document.createElement('iframe');
        iframe.src = item.embed || item.src;
        iframe.title = item.alt || '';
        iframe.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture');
        iframe.setAttribute('allowfullscreen', '');
        iframe.setAttribute('frameborder', '0');
        return iframe;
      }
      if (item.as === 'video') {
        const video = document.createElement('video');
        video.src = item.src;
        video.muted = true;
        video.loop = true;
        video.autoplay = true;
        video.playsInline = true;
        video.setAttribute('playsinline', '');
        video.preload = 'metadata';
        return video;
      }
      const img = document.createElement('img');
      img.src = item.src;
      img.alt = item.alt || '';
      img.draggable = false;
      return img;
    }

    function layoutInnerScreen(screenEl) {
      if (!screenEl) return;
      const metrics = gridMetrics();
      const cells = Array.from(screenEl.querySelectorAll('.rf-inner__cell'));
      const widths = cells.map(function (cell) {
        if (cell.getAttribute('data-fit') === 'height') return 0;
        return spanWidth(cell.getAttribute('data-span') || '4', metrics);
      });
      const gaps = Math.max(0, cells.length - 1) * metrics.gutter;
      const total = widths.reduce(function (sum, w) { return sum + w; }, 0) + gaps;
      const scale = total > metrics.width && total > 0 ? metrics.width / total : 1;
      cells.forEach(function (cell, i) {
        if (cell.getAttribute('data-fit') === 'height') return;
        cell.style.setProperty('--rf-w', Math.round(widths[i] * scale) + 'px');
      });
    }

    function buildInnerScreen(index) {
      const screens = currentScreens();
      const screen = screens[index];
      if (!screen) return null;
      const screenEl = document.createElement('div');
      screenEl.className = 'rf-inner__screen';
      const row = document.createElement('div');
      row.className = 'rf-inner__row';
      screen.items.forEach(function (item) {
        const cell = document.createElement('div');
        cell.className = 'rf-inner__cell';
        cell.setAttribute('data-fit', item.fit || 'cols');
        cell.setAttribute('data-span', String(item.span || 4));
        cell.style.setProperty('--rf-span', String(item.span || 4));
        cell.style.setProperty('--ar', String(item.ar || 1));
        cell.appendChild(mediaEl(item));
        row.appendChild(cell);
      });
      screenEl.appendChild(row);
      return screenEl;
    }

    function mountInnerScreen(index) {
      innerStage.innerHTML = '';
      const screenEl = buildInnerScreen(index);
      if (!screenEl) return null;
      innerStage.appendChild(screenEl);
      layoutInnerScreen(screenEl);
      return screenEl;
    }

    async function goProject(next) {
      const n = slides.length;
      if (!n || busy || innerOpen) return;
      const target = ((next % n) + n) % n;
      if (target === current) return;
      busy = true;
      wheelAcc = 0;
      const mobileSwitch = isMobileInfo();
      if (mobileSwitch) info.classList.add('is-switching');
      closeInfo();
      const from = slides[current];
      const to = slides[target];
      layoutCover(to);
      from.style.zIndex = '2';
      to.style.zIndex = '3';
      syncMedia(to, true);
      await animateOpacity(from, 1, 0, fadeOutMs);
      syncMedia(from, false);
      await wait(fadeGapMs);
      await animateOpacity(to, 0, 1, fadeInMs);
      current = target;
      syncInfo();
      if (mobileSwitch) info.classList.remove('is-switching');
      busy = false;
    }

    async function goScreen(next) {
      const screens = currentScreens();
      const n = screens.length;
      if (!innerOpen || busy || !n) return;
      const target = ((next % n) + n) % n;
      if (target === screenIndex) return;
      busy = true;
      wheelAcc = 0;
      const from = innerStage.querySelector('.rf-inner__screen');
      const incoming = buildInnerScreen(target);
      if (!incoming) {
        busy = false;
        return;
      }
      innerStage.appendChild(incoming);
      layoutInnerScreen(incoming);
      incoming.style.zIndex = '3';
      if (from) from.style.zIndex = '2';
      if (from) await animateOpacity(from, 1, 0, fadeOutMs);
      await wait(fadeGapMs);
      await animateOpacity(incoming, 0, 1, fadeInMs);
      if (from) from.remove();
      screenIndex = target;
      updateNav();
      busy = false;
    }

    async function openInner(options) {
      if (busy || innerOpen) return;
      const startAudio = Boolean(options && options.startAudio);
      const audioMode = isAudioProject();
      const screens = currentScreens();
      if (!audioMode && !screens.length) return;
      busy = true;
      wheelAcc = 0;
      closeInfo();
      const cover = slides[current];
      screenIndex = 0;
      audioInner = audioMode;
      inner.hidden = false;
      inner.classList.add('is-open');
      document.body.classList.add('rf-inner-open');
      let first;
      if (audioMode) {
        innerStage.innerHTML = '';
        first = buildAudioInner();
        innerStage.appendChild(first);
        layoutCoverAudioPlayer();
        // Audio: instant cut, no fade
        cover.style.opacity = '0';
        cover.style.visibility = 'hidden';
        first.style.opacity = '1';
        first.style.visibility = 'visible';
      } else {
        first = mountInnerScreen(0);
        await animateOpacity(cover, 1, 0, fadeOutMs);
        syncMedia(cover, false);
        await wait(fadeGapMs);
      }
      innerOpen = true;
      nav.hidden = false;
      nav.classList.add('is-open');
      updateNav();
      if (!audioMode) await animateOpacity(first, 0, 1, fadeInMs);
      if (audioMode) {
        updateAudioRing(audioProgress());
        if (startAudio) playCurrentAudio();
        else {
          const audio = currentAudio();
          syncPlayButtons(Boolean(audio && !audio.paused));
          if (audio && !audio.paused) startAudioRaf();
        }
      }
      busy = false;
    }

    async function closeInner() {
      if (busy || !innerOpen) return;
      busy = true;
      wheelAcc = 0;
      stopAudioRaf();
      const screenEl = innerStage.querySelector('.rf-inner__screen');
      const cover = slides[current];
      const wasAudio = audioInner;
      nav.classList.remove('is-open');
      nav.hidden = true;
      if (wasAudio) {
        // Audio: instant cut, no fade
        if (screenEl) {
          screenEl.style.opacity = '0';
          screenEl.style.visibility = 'hidden';
        }
      } else {
        await animateOpacity(screenEl, 1, 0, fadeOutMs);
        await wait(fadeGapMs);
      }
      inner.classList.remove('is-open');
      inner.hidden = true;
      innerStage.innerHTML = '';
      document.body.classList.remove('rf-inner-open');
      layoutCover(cover);
      if (!wasAudio) syncMedia(cover, true);
      else {
        const audio = currentAudio();
        if (audio) {
          audio.pause();
          audio.currentTime = 0;
        }
        stopAudioRaf();
        syncPlayButtons(false);
      }
      if (wasAudio) {
        cover.style.opacity = '1';
        cover.style.visibility = 'visible';
      } else {
        await animateOpacity(cover, 0, 1, fadeInMs);
      }
      innerOpen = false;
      audioInner = false;
      screenIndex = 0;
      busy = false;
    }

    function onIntent(dir) {
      if (busy) return;
      if (innerOpen) {
        if (audioInner) return;
        goScreen(screenIndex + dir);
        return;
      }
      goProject(current + dir);
    }

    function onWheel(e) {
      e.preventDefault();
      if (busy || innerOpen) return;
      wheelAcc += e.deltaY;
      if (wheelAcc >= wheelThreshold) {
        wheelAcc = 0;
        onIntent(1);
      } else if (wheelAcc <= -wheelThreshold) {
        wheelAcc = 0;
        onIntent(-1);
      }
    }

    slides.forEach(function (slide) {
      const open = slide.querySelector('.rf-slide__open');
      if (open) {
        open.addEventListener('click', function (e) {
          e.preventDefault();
          const index = Number(slide.getAttribute('data-index')) || 0;
          if (index !== current || busy || innerOpen) return;
          openInner({ startAudio: slide.getAttribute('data-kind') === 'audio' });
        });
      }
      slide.querySelectorAll('.rf-audio-play').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          const index = Number(slide.getAttribute('data-index')) || 0;
          if (index !== current || busy || innerOpen) return;
          openInner({ startAudio: true });
        });
      });
    });

    infoToggle.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      toggleInfo();
    });

    function openNameLink() {
      const href = infoName.getAttribute('data-url') || '';
      if (!href || !infoName.classList.contains('is-link')) return;
      window.open(href, '_blank', 'noopener,noreferrer');
    }

    infoName.addEventListener('click', function (e) {
      if (!infoName.classList.contains('is-link')) return;
      e.preventDefault();
      e.stopPropagation();
      openNameLink();
    });

    infoName.addEventListener('keydown', function (e) {
      if (!infoName.classList.contains('is-link')) return;
      if (e.key !== 'Enter' && e.key !== ' ') return;
      e.preventDefault();
      openNameLink();
    });

    prevBtn.addEventListener('click', function () { onIntent(-1); });
    nextBtn.addEventListener('click', function () { onIntent(1); });
    closeBtn.addEventListener('click', function () {
      if (busy || !innerOpen) return;
      closeInner();
    });

    window.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        if (infoOpen && !innerOpen) {
          e.preventDefault();
          closeInfo();
          return;
        }
        if (innerOpen) {
          e.preventDefault();
          closeInner();
          return;
        }
      }
      if (innerOpen && (e.key === 'ArrowDown' || e.key === 'ArrowUp')) {
        e.preventDefault();
        return;
      }
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        onIntent(1);
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        onIntent(-1);
      }
    });

    window.addEventListener('wheel', onWheel, { passive: false });

    window.addEventListener('touchstart', function (e) {
      if (!e.changedTouches || !e.changedTouches[0]) return;
      touchY = e.changedTouches[0].clientY;
    }, { passive: true });

    window.addEventListener('touchmove', function (e) {
      e.preventDefault();
    }, { passive: false });

    window.addEventListener('touchend', function (e) {
      if (busy || innerOpen || !e.changedTouches || !e.changedTouches[0]) return;
      const dy = touchY - e.changedTouches[0].clientY;
      if (Math.abs(dy) < swipeThreshold) return;
      onIntent(dy > 0 ? 1 : -1);
    }, { passive: true });

    window.addEventListener('resize', function () {
      layoutCovers();
      syncInfo();
      if (audioInner) layoutCoverAudioPlayer();
      else {
        const screenEl = innerStage.querySelector('.rf-inner__screen');
        if (screenEl) layoutInnerScreen(screenEl);
      }
    });

    syncInfo();
    layoutCovers();
    slides.forEach(function (slide, i) {
      slide.style.opacity = i === 0 ? '1' : '0';
      slide.style.visibility = i === 0 ? 'visible' : 'hidden';
      syncMedia(slide, i === 0);
    });
  })();
</script>
