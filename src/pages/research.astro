---
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerPageHeader from '../components/InnerPageHeader.astro';
import { getResearchCards, type ResearchCard } from '../lib/researchCards';

const researchItems = getResearchCards();
const base = import.meta.env.BASE_URL;

function resolveMediaSrc(src: string): string {
  const value = String(src || '').trim();
  if (!value || value.startsWith('http') || value.startsWith('<')) return value;
  return `${base}${value.replace(/^\//, '')}`;
}

function extractIframeSrc(raw: string): string {
  const s = String(raw || '').trim();
  const m = s.match(/<iframe[\s\S]*?src=["']([^"']+)["']/i);
  if (m && m[1]) return m[1].trim();
  return s;
}

function getKinescopeEmbedUrl(raw: string): string {
  const s = extractIframeSrc(raw);
  if (!s) return '';
  if (/kinescope\.(io|ru)\/embed\//.test(s)) return s;
  if (/player\.vimeo\.com\/video\//.test(s) || /vimeo\.com\//.test(s)) return s;
  const m = s.match(/https?:\/\/(?:kinescope\.(?:io|ru))\/([^/?#]+)/);
  if (m && m[1]) return `https://kinescope.io/embed/${m[1]}?autoplay=1&muted=1`;
  return s;
}

type CoverSpan = 2 | 4 | 6 | 8;

function coverLayout(item: ResearchCard): { fit: 'height' | 'cols'; span: CoverSpan } {
  const raw = Number(item.spanW);
  const span: CoverSpan = raw === 2 || raw === 4 || raw === 6 || raw === 8 ? raw : 4;
  return { fit: item.coverFit === 'height' ? 'height' : 'cols', span };
}

const payload = researchItems.map((item, index) => {
  const link = (item.links || []).find((entry) => entry && String(entry.url || '').trim());
  const cover = coverLayout(item);
  return {
    index,
    name: item.caption || '',
    date: item.date || '',
    text: item.text || '',
    url: link ? String(link.url).trim() : '',
    as: item.as || 'image',
    coverSrc: resolveMediaSrc(item.src),
    coverSrcMobile: item.srcMobile ? resolveMediaSrc(item.srcMobile) : '',
    audioSrc: item.audioSrc ? resolveMediaSrc(item.audioSrc) : '',
    span: cover.span,
    fit: cover.fit,
    screens: item.screens.map((screen) => ({
      items: screen.items.map((entry) => ({
        src: resolveMediaSrc(entry.src),
        as: entry.as,
        span: entry.span,
        fit: entry.fit,
        ar: entry.aspectRatio,
        alt: entry.alt || item.caption || '',
        embed: entry.as === 'kinescope' ? getKinescopeEmbedUrl(entry.src) : '',
      })),
    })),
  };
});
---

<BaseLayout title="Research" variant="inner" hideHeader bodyClass="page-research" themeColor="#000000">
  <InnerPageHeader activePage="research" />
  <div class="rf-stage" aria-live="polite">
    {researchItems.map((item, index) => {
      const label = item.caption || item.alt || `Research ${item.number}`;
      const mediaSrc = resolveMediaSrc(item.src);
      const mediaSrcMobile = item.srcMobile ? resolveMediaSrc(item.srcMobile) : mediaSrc;
      const cover = coverLayout(item);
      const isAudio = item.as === 'audio';
      const canOpen = isAudio ? Boolean(item.audioSrc) : item.screens.length > 0;
      return (
        <article
          class="rf-slide"
          data-index={index}
          data-fit={cover.fit}
          data-span={cover.span}
          data-kind={isAudio ? 'audio' : (item.as || 'image')}
          style={`--ar: ${item.aspectRatio}; --ar-mobile: ${item.aspectRatioMobile}; --rf-span: ${cover.span};`}
          aria-label={label}
        >
          <div class={`rf-slide__frame${isAudio ? ' rf-slide__frame--audio' : ''}`}>
            {item.as === 'kinescope' ? (
              <iframe
                src={getKinescopeEmbedUrl(item.src)}
                title={item.alt || label}
                frameborder="0"
                allow="autoplay; fullscreen; picture-in-picture"
                allowfullscreen
              />
            ) : item.as === 'video' ? (
              <video
                src={mediaSrc}
                muted
                playsinline
                loop
                autoplay
                preload="metadata"
              />
            ) : isAudio ? (
              <div class="rf-slide__audio">
                <div class="rf-slide__audio-disc">
                  {mediaSrc || mediaSrcMobile ? (
                    <picture>
                      <source media="(max-width: 768px)" srcset={mediaSrcMobile} />
                      <img src={mediaSrc || mediaSrcMobile} alt={item.alt || label} draggable="false" />
                    </picture>
                  ) : (
                    <div class="rf-slide__audio-fallback" aria-hidden="true">♪</div>
                  )}
                  <button type="button" class="rf-blur rf-audio-play" aria-label="Play" data-playing="0">
                    <svg class="rf-audio-play__icon rf-audio-play__icon--play" viewBox="0 0 24 24" aria-hidden="true">
                      <path fill="currentColor" d="M9.15 6.35c0-1.02 1.08-1.66 1.95-1.15l8.2 4.85a1.32 1.32 0 0 1 0 2.3l-8.2 4.85c-.87.51-1.95-.13-1.95-1.15V6.35z" />
                    </svg>
                    <svg class="rf-audio-play__icon rf-audio-play__icon--pause" viewBox="0 0 24 24" aria-hidden="true" hidden>
                      <rect x="7" y="6" width="3.6" height="12" rx="1.6" fill="currentColor" />
                      <rect x="13.4" y="6" width="3.6" height="12" rx="1.6" fill="currentColor" />
                    </svg>
                  </button>
                </div>
                {item.audioSrc ? (
                  <audio src={resolveMediaSrc(item.audioSrc)} preload="metadata" loop></audio>
                ) : null}
              </div>
            ) : (
              <img src={mediaSrc} alt={item.alt || label} draggable="false" />
            )}
            {canOpen && (
              <button class="rf-slide__open" type="button" aria-label={`Open ${label}`}></button>
            )}
          </div>
        </article>
      );
    })}
  </div>

  <div class="rf-info">
    <div class="rf-info__stack" hidden>
      <div class="rf-info__row">
        <div class="rf-blur rf-info__chip rf-info__chip--name" hidden><span class="rf-info__label"></span></div>
        <div class="rf-blur rf-info__chip rf-info__chip--date" hidden><span class="rf-info__label"></span></div>
      </div>
      <div class="rf-blur rf-info__chip rf-info__chip--text" hidden><span class="rf-info__label"></span></div>
    </div>
    <button class="rf-blur rf-info__toggle" type="button" aria-label="Project info" aria-expanded="false">
      <span class="rf-info__plus" aria-hidden="true">
        <span class="rf-info__bar rf-info__bar--h"></span>
        <span class="rf-info__bar rf-info__bar--v"></span>
      </span>
    </button>
  </div>

  <div class="rf-inner" hidden>
    <div class="rf-inner__stage"></div>
  </div>

  <nav class="rf-nav" hidden>
    <button class="rf-blur rf-nav__btn rf-nav__btn--prev" type="button" aria-label="Previous">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M14.5 5.5 8 12l6.5 6.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <button class="rf-blur rf-nav__close" type="button" aria-label="Close">
      <span class="rf-nav__close-name"></span>
      <span class="rf-nav__close-x" aria-hidden="true">
        <span class="rf-nav__close-bar rf-nav__close-bar--h"></span>
        <span class="rf-nav__close-bar rf-nav__close-bar--v"></span>
      </span>
    </button>
    <button class="rf-blur rf-nav__btn rf-nav__btn--next" type="button" aria-label="Next">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M9.5 5.5 16 12l-6.5 6.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </nav>
</BaseLayout>

<script is:inline define:vars={{ payload }}>
  window.__RF_DATA__ = payload;
</script>

<style is:global>
  html:has(body.page-research),
  body.page-research {
    background: #000;
    --page-bg: #000;
    overflow: hidden;
    height: 100%;
    min-height: 100%;
    min-height: 100dvh;
    min-height: -webkit-fill-available;
    overscroll-behavior: none;
    scrollbar-width: none;
    -ms-overflow-style: none;
    touch-action: none;
  }

  html:has(body.page-research)::-webkit-scrollbar,
  body.page-research::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }

  body.page-research .page-backdrop {
    background: #000;
  }
</style>

<style is:global>
  .rf-stage,
  .rf-inner {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: 100dvh;
    min-height: -webkit-fill-available;
    z-index: 1;
    background: #000;
  }

  .rf-inner {
    z-index: 4;
    display: none;
  }

  .rf-inner.is-open {
    display: block;
  }

  .rf-slide,
  .rf-inner__screen {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(var(--grid-cols), minmax(0, 1fr));
    grid-template-rows: minmax(0, 1fr);
    column-gap: var(--grid-gutter);
    align-items: center;
    padding: 0 var(--grid-margin);
    box-sizing: border-box;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
  }

  .rf-slide:first-child {
    opacity: 1;
    visibility: visible;
  }

  .rf-slide__frame,
  .rf-inner__cell {
    position: relative;
    z-index: 1;
    line-height: 0;
    background: transparent;
  }

  .rf-slide__frame {
    grid-column: 1 / -1;
    grid-row: 1;
    justify-self: center;
    align-self: center;
  }

  .rf-slide[data-fit='height'] .rf-slide__frame,
  .rf-inner__cell[data-fit='height'] {
    height: 100%;
    width: auto;
    aspect-ratio: var(--ar);
  }

  .rf-slide[data-fit='cols'] .rf-slide__frame {
    width: min(
      calc(
        var(--rf-span, 4) * (100% - (var(--grid-cols) - 1) * var(--grid-gutter)) / var(--grid-cols)
        + (var(--rf-span, 4) - 1) * var(--grid-gutter)
      ),
      calc(100dvh * var(--ar))
    );
    max-width: 100%;
    max-height: 100%;
    aspect-ratio: var(--ar);
  }

  @media (max-width: 768px) {
    /* Feed covers: full-bleed — no side gutters / letterboxing into stage bg */
    .rf-slide {
      padding: 0;
    }

    .rf-slide[data-fit='cols'] .rf-slide__frame,
    .rf-slide[data-fit='height'] .rf-slide__frame {
      width: 100%;
      height: 100%;
      max-width: none;
      max-height: none;
      aspect-ratio: auto;
      justify-self: stretch;
      align-self: stretch;
      overflow: hidden;
    }

    .rf-slide__frame img,
    .rf-slide__frame video,
    .rf-slide__frame iframe {
      object-fit: cover;
    }

    .rf-slide[data-kind='audio'] {
      --ar: var(--ar-mobile, var(--ar));
    }
  }

  .rf-inner__cell[data-fit='cols'] {
    width: var(--rf-w);
    max-width: 100%;
    max-height: 100%;
    aspect-ratio: var(--ar);
  }

  @media (max-width: 768px) {
    /* Inner screens: fill content width between grid margins */
    .rf-inner__cell[data-fit='cols'],
    .rf-inner__cell[data-fit='height'] {
      width: 100%;
      max-width: 100%;
      height: auto;
      max-height: 100%;
      aspect-ratio: var(--ar);
    }

    .rf-inner__row:has(.rf-inner__cell:nth-child(2)) .rf-inner__cell {
      width: auto;
      flex: 1 1 0;
      min-width: 0;
    }

    .rf-audio-player[data-fit='cols'],
    .rf-audio-player[data-fit='height'] {
      width: 100%;
      max-width: 100%;
      height: auto;
      aspect-ratio: 1;
    }
  }

  .rf-slide__frame img,
  .rf-slide__frame video,
  .rf-slide__frame iframe,
  .rf-inner__cell img,
  .rf-inner__cell video,
  .rf-inner__cell iframe {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    border: 0;
    background: transparent;
    -webkit-user-drag: none;
    user-select: none;
  }

  .rf-slide__frame iframe,
  .rf-slide__frame video,
  .rf-inner__cell iframe,
  .rf-inner__cell video {
    position: absolute;
    inset: 0;
  }

  .rf-slide__frame iframe,
  .rf-slide__frame video {
    pointer-events: none;
  }

  .rf-slide__open {
    position: absolute;
    inset: 0;
    z-index: 3;
    border: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
  }

  .rf-slide__open:focus,
  .rf-slide__open:focus-visible {
    outline: none;
  }

  .rf-slide__audio {
    position: absolute;
    inset: 0;
  }

  .rf-slide__audio-disc {
    position: absolute;
    inset: 0;
    background: #151515;
  }

  .rf-slide__audio-disc picture {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .rf-slide__audio-disc img,
  .rf-audio-player__disc > img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
    will-change: transform;
  }

  /* Desktop: audio cover is a filled circle */
  @media (min-width: 769px) {
    .rf-slide[data-kind='audio'] .rf-slide__frame {
      aspect-ratio: 1;
      border-radius: 50%;
      overflow: hidden;
    }

    .rf-slide__audio,
    .rf-slide__audio-disc {
      border-radius: 50%;
      overflow: hidden;
    }

    .rf-slide__audio-disc img,
    .rf-slide__frame--audio img {
      object-fit: cover;
      border-radius: 50%;
    }

    .rf-audio-player__disc > img {
      object-fit: cover;
    }
  }

  /* Mobile: audio cover like other images — full-bleed, no circle */
  @media (max-width: 768px) {
    .rf-slide[data-kind='audio'] .rf-slide__frame--audio {
      border-radius: 0;
      overflow: hidden;
    }

    .rf-slide__audio,
    .rf-slide__audio-disc {
      border-radius: 0;
      overflow: hidden;
      background: transparent;
    }

    .rf-slide__audio-disc img {
      object-fit: cover;
      border-radius: 0;
    }
  }

  .rf-audio-player__disc.is-spinning > img,
  .rf-audio-player__disc.is-spinning .rf-audio-player__fallback {
    animation: rf-audio-spin 24s linear infinite;
  }

  @keyframes rf-audio-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .rf-audio-player__disc.is-spinning > img,
    .rf-audio-player__disc.is-spinning .rf-audio-player__fallback {
      animation: none;
    }
  }

  .rf-slide__audio-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.55);
    font-size: 28px;
    background: #151515;
  }

  .rf-slide__audio audio {
    display: none;
  }

  .rf-audio-ring,
  .rf-audio-ring-hit {
    position: absolute;
    inset: 5px;
    z-index: 2;
    pointer-events: none;
  }

  .rf-audio-ring-hit {
    z-index: 4;
  }

  .rf-audio-ring svg,
  .rf-audio-ring-hit svg {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
    pointer-events: none;
  }

  .rf-audio-ring__track {
    fill: none;
    stroke: rgba(255, 255, 255, 0.22);
    stroke-width: 2;
  }

  .rf-audio-ring__progress {
    fill: none;
    stroke: #fff;
    stroke-width: 1;
    stroke-linecap: round;
  }

  .rf-audio-ring-hit .rf-audio-ring__hit {
    fill: none;
    stroke: transparent;
    stroke-width: 16;
    pointer-events: stroke;
    cursor: pointer;
  }

  .rf-audio-play {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 5;
    width: 42px;
    height: 42px;
    padding: 0;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    color: #fff;
    cursor: pointer;
  }

  .rf-audio-play:hover {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.5);
  }

  .rf-audio-play__icon {
    width: 14px;
    height: 14px;
    display: none;
  }

  .rf-audio-play[data-playing='0'] .rf-audio-play__icon--play,
  .rf-audio-play:not([data-playing]) .rf-audio-play__icon--play {
    display: block;
    margin-left: 2px;
  }

  .rf-audio-play[data-playing='1'] .rf-audio-play__icon--pause {
    display: block;
  }

  .rf-audio-play:focus,
  .rf-audio-play:focus-visible {
    outline: none;
  }

  .rf-inner__screen--audio {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 var(--grid-margin);
  }

  .rf-audio-player {
    position: relative;
    justify-self: center;
    align-self: center;
    line-height: 0;
  }

  .rf-audio-player[data-fit='height'] {
    height: min(100%, 100dvh);
    width: auto;
    aspect-ratio: 1;
  }

  .rf-audio-player[data-fit='cols'] {
    width: min(
      var(--rf-w, 280px),
      calc(
        var(--rf-span, 4) * (100% - (var(--grid-cols) - 1) * var(--grid-gutter)) / var(--grid-cols)
        + (var(--rf-span, 4) - 1) * var(--grid-gutter)
      ),
      100dvh
    );
    max-width: 100%;
    max-height: 100%;
    aspect-ratio: 1;
  }

  .rf-audio-player__disc {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    background: #151515;
  }

  .rf-audio-player__disc > img,
  .rf-audio-player__fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: 50%;
    display: block;
    will-change: transform;
  }

  .rf-audio-player__fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.55);
    font-size: 28px;
    background: #151515;
  }

  .rf-inner__stage {
    position: absolute;
    inset: 0;
  }

  .rf-inner__screen {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 var(--grid-margin);
  }

  .rf-inner__row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--grid-gutter);
    height: 100%;
    width: 100%;
    max-width: 100%;
  }

  .rf-inner__cell {
    flex: 0 0 auto;
  }

  /* mouthwash.studio header buttons — текст свой */
  .rf-blur {
    appearance: none;
    -webkit-appearance: none;
    color: #fff;
    line-height: 0.9;
    letter-spacing: -0.03em;
    white-space: nowrap;
    text-box-trim: trim-both;
    text-box-edge: cap alphabetic;
    transition:
      color 0.25s,
      background-color 0.25s,
      border-color 0.25s;
    -webkit-backdrop-filter: blur(1rem);
    backdrop-filter: blur(1rem);
    background-color: rgba(255, 255, 255, 0.1);
    border-style: solid;
    border-color: transparent;
    border-width: 0.5px 0 0 0.5px;
    outline: none;
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .rf-blur:hover {
    border-color: rgba(255, 255, 255, 0.5);
  }

  .rf-info {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 30px;
    z-index: 7;
    width: max-content;
    max-width: calc(100vw - (var(--grid-margin) * 2));
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    pointer-events: none;
  }

  body.rf-inner-open .rf-info {
    display: none;
  }

  .rf-info__stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    pointer-events: none;
  }

  .rf-info__stack[hidden] {
    display: none;
  }

  .rf-info__row {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    gap: 10px;
  }

  .rf-info__chip {
    pointer-events: auto;
    box-sizing: border-box;
    max-width: calc(100vw - (var(--grid-margin) * 2));
    padding: 6px 12px;
    border-radius: 20px;
    text-align: center;
    text-decoration: none;
    color: inherit;
  }

  .rf-info__chip--name.is-link {
    cursor: pointer;
    border-color: rgba(255, 255, 255, 0.5);
  }

  .rf-info__chip[hidden] {
    display: none !important;
  }

  .rf-info__chip--text {
    --rf-text-span: 4;
    width: calc(
      var(--rf-text-span) * ((100vw - (var(--grid-margin) * 2) - ((var(--grid-cols) - 1) * var(--grid-gutter))) / var(--grid-cols))
      + (var(--rf-text-span) - 1) * var(--grid-gutter)
    );
    max-width: calc(100vw - (var(--grid-margin) * 2));
    text-align: center;
    white-space: normal;
  }

  .rf-info__chip--text .rf-info__label {
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    text-align: center;
    white-space: pre-wrap;
  }

  .rf-info__label {
    display: block;
    font-family: 'SuisseIntl', sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: #fff;
    opacity: 0.3;
    mix-blend-mode: soft-light;
    white-space: nowrap;
    transition: opacity 0.25s ease;
  }

  .rf-info__chip:hover .rf-info__label {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .rf-info {
      left: var(--grid-margin);
      right: var(--grid-margin);
      width: auto;
      max-width: none;
      margin-inline: 0;
      align-items: flex-start;
    }

    .rf-info__stack {
      align-items: flex-start;
      width: 100%;
    }

    .rf-info__row {
      flex-direction: row;
      align-items: center;
