---
const base = import.meta.env.BASE_URL;
const logoSrc = `${base}images/main/Vasilii%20Aleev.svg`;
const pathname = Astro.url.pathname;
const pathWithoutBase = pathname.replace(new RegExp('^' + base.replace(/\/$/, '') + '\\/?'), '') || '';
const currentPath = pathWithoutBase.replace(/^\/+|\/+$/g, '') || '/';

function isNavActive(page: 'index' | 'research' | 'info'): boolean {
  if (page === 'index') return currentPath === 'index' || currentPath.startsWith('index/');
  if (page === 'research') return currentPath === 'research' || currentPath.startsWith('research/');
  if (page === 'info') return currentPath === 'info';
  return false;
}
---

<div class="mobile-global-nav" data-mobile-global-nav>
  <a href={base === '/' ? '/' : base} class="mobile-global-nav__logo" aria-label="Vasilii Aleev">
    <img class="mobile-global-nav__logo-img" src={logoSrc} width="155" height="22" alt="" />
  </a>
  <button
    type="button"
    class="mobile-global-nav__toggle"
    id="mobileGlobalNavToggle"
    aria-controls="mobileGlobalNavOverlay"
    aria-expanded="false"
    aria-label="Open menu"
  >
    <span class="mobile-global-nav__line" aria-hidden="true"></span>
    <span class="mobile-global-nav__line" aria-hidden="true"></span>
  </button>
  <div class="mobile-global-nav__overlay" id="mobileGlobalNavOverlay" aria-hidden="true">
    <nav class="mobile-global-nav__menu" aria-label="Mobile navigation">
      <div class="mobile-global-nav__menu-row">
        <div class="mobile-global-nav__menu-side mobile-global-nav__menu-side--left">
          <a href={`${base}index/`} class:list={['mobile-global-nav__menu-link', isNavActive('index') && 'is-active']}>Index</a>
          <a href={`${base}research/`} class:list={['mobile-global-nav__menu-link', isNavActive('research') && 'is-active']}>Research</a>
        </div>
        <a href={base === '/' ? '/' : base} class="mobile-global-nav__menu-logo" aria-label="Vasilii Aleev">
          <img
            class="mobile-global-nav__menu-logo-img"
            src={logoSrc}
            width="155"
            height="22"
            alt=""
          />
        </a>
        <div class="mobile-global-nav__menu-side mobile-global-nav__menu-side--right">
          <a href={`${base}info/`} class:list={['mobile-global-nav__menu-link', isNavActive('info') && 'is-active']}>Info</a>
          <a
            href="https://t.me/schtab_kvartira"
            target="_blank"
            rel="noopener noreferrer"
            class="mobile-global-nav__menu-link mobile-global-nav__menu-link--schk"
          >schk</a>
        </div>
      </div>
    </nav>
  </div>
</div>

<style>
  .mobile-global-nav {
    display: none;
  }

  @media (max-width: 768px) {
    .mobile-global-nav {
      display: block;
      --mobile-nav-inset: var(--corner-control-inset);
      --mobile-logo-width: 155px;
      --mobile-logo-height: var(--corner-control-logo-height);
      --mobile-toggle-line-height: var(--corner-control-line-height);
      --mobile-toggle-line-gap: var(--corner-control-line-gap);
      --mobile-toggle-height: var(--corner-control-height);
    }

    :global(.home-mobile-toggle),
    :global(.home-mobile-overlay),
    :global(.index-mobile-toggle),
    :global(.index-mobile-overlay) {
      display: none !important;
    }

    :global(.page-header),
    :global(.site-header) {
      display: none !important;
    }

    :global(body.global-mobile-menu-open) {
      overflow: hidden;
    }

    .mobile-global-nav__logo {
      position: fixed;
      top: var(--mobile-nav-inset);
      left: var(--mobile-nav-inset);
      z-index: 2050;
      line-height: 0;
      text-decoration: none;
      color: inherit;
      mix-blend-mode: difference;
      transition: visibility 0.2s ease;
    }

    :global(body.global-mobile-menu-open) .mobile-global-nav__logo {
      visibility: hidden;
      pointer-events: none;
    }

    .mobile-global-nav__logo-img {
      display: block;
      width: var(--mobile-logo-width);
      height: var(--mobile-logo-height);
      max-width: none;
      filter: brightness(0) invert(1);
    }

    :global(body.is-home) .mobile-global-nav {
      display: none;
    }

    :global(body.is-home .home-hero) {
      display: flex !important;
    }

    .mobile-global-nav__toggle {
      position: fixed;
      top: var(--corner-control-top);
      right: var(--corner-control-inset);
      width: 24px;
      height: var(--mobile-toggle-height);
      padding: 0;
      border: none;
      border-radius: 0;
      background: transparent;
      cursor: pointer;
      z-index: 2400;
      appearance: none;
      -webkit-appearance: none;
      mix-blend-mode: difference;
    }

    .mobile-global-nav__toggle::before {
      content: '';
      position: absolute;
      inset: -16px;
    }

    .mobile-global-nav__line {
      position: absolute;
      left: 0;
      width: 24px;
      height: var(--mobile-toggle-line-height);
      border-radius: 0;
      background: #ffffff;
      transition: top 0.28s ease, transform 0.28s ease;
    }

    .mobile-global-nav__line:first-child {
      top: 0;
    }

    .mobile-global-nav__line:last-child {
      top: calc(var(--mobile-toggle-line-height) + var(--mobile-toggle-line-gap));
    }

    :global(body.global-mobile-menu-open) .mobile-global-nav__line:first-child,
    :global(body.global-mobile-menu-open) .mobile-global-nav__line:last-child {
      top: calc((var(--mobile-toggle-height) - var(--mobile-toggle-line-height)) / 2);
    }

    :global(body.global-mobile-menu-open) .mobile-global-nav__line:first-child {
      transform: rotate(45deg);
    }

    :global(body.global-mobile-menu-open) .mobile-global-nav__line:last-child {
      transform: rotate(-45deg);
    }

    .mobile-global-nav__overlay {
      position: fixed;
      inset: 0;
      z-index: 2350;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #FBFBFB;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.28s ease, visibility 0.28s ease;
    }

    :global(body.global-mobile-menu-open) .mobile-global-nav__overlay {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .mobile-global-nav__menu {
      width: 100%;
      padding: 0 var(--mobile-nav-inset);
      box-sizing: border-box;
      mix-blend-mode: difference;
      color: #ffffff;
    }

    .mobile-global-nav__menu-row {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: clamp(72px, 11vh, 110px);
      width: 100%;
    }

    .mobile-global-nav__menu-side {
      display: contents;
    }

    .mobile-global-nav__menu-link {
      font-family: 'SuisseIntl', sans-serif;
      font-weight: 500;
      font-size: 18px;
      line-height: 24px;
      color: rgba(255, 255, 255, 0.3);
      text-decoration: none;
      transition: color 0.2s;
    }

    .mobile-global-nav__menu-link:hover,
    .mobile-global-nav__menu-link.is-active {
      color: #ffffff;
    }

    .mobile-global-nav__menu-link--schk {
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    .mobile-global-nav__menu-logo {
      display: block;
      line-height: 0;
      text-decoration: none;
    }

    .mobile-global-nav__menu-logo-img {
      display: block;
      width: var(--mobile-logo-width);
      height: var(--mobile-logo-height);
      filter: brightness(0) invert(1);
    }
  }
</style>

<script>
  (function () {
    const root = document.querySelector('[data-mobile-global-nav]');
    if (!root) return;

    const toggle = document.getElementById('mobileGlobalNavToggle');
    const overlay = document.getElementById('mobileGlobalNavOverlay');
    if (!toggle || !overlay) return;

    function closeMenu() {
      document.body.classList.remove('global-mobile-menu-open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open menu');
      overlay.setAttribute('aria-hidden', 'true');
    }

    function openMenu() {
      document.body.classList.add('global-mobile-menu-open');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close menu');
      overlay.setAttribute('aria-hidden', 'false');
    }

    toggle.addEventListener('click', function () {
      if (document.body.classList.contains('global-mobile-menu-open')) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    overlay.querySelectorAll('a').forEach(function (link) {
      link.addEventListener('click', function () {
        closeMenu();
      });
    });

    window.addEventListener('resize', function () {
      if (window.innerWidth > 768) closeMenu();
    });
  })();
</script>
