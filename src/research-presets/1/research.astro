---
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerPageHeader from '../components/InnerPageHeader.astro';
import { getResearchCards } from '../lib/researchCards';

const researchItems = getResearchCards();
const base = import.meta.env.BASE_URL;

function resolveMediaSrc(src: string): string {
  const value = String(src || '').trim();
  if (!value || value.startsWith('http') || value.startsWith('<')) return value;
  return `${base}${value.replace(/^\//, '')}`;
}

function extractIframeSrc(raw: string): string {
  const s = String(raw || '').trim();
  const m = s.match(/<iframe[\s\S]*?src=["']([^"']+)["']/i);
  if (m && m[1]) return m[1].trim();
  return s;
}

function getKinescopeEmbedUrl(raw: string): string {
  const s = extractIframeSrc(raw);
  if (!s) return '';
  if (/kinescope\.(io|ru)\/embed\//.test(s)) return s;
  const m = s.match(/https?:\/\/(?:kinescope\.(?:io|ru))\/([^/?#]+)/);
  if (m && m[1]) return `https://kinescope.io/embed/${m[1]}?autoplay=1&muted=1`;
  return s;
}
---

<BaseLayout title="Research" variant="inner" hideHeader>
  <div class="inner-page">
    <div class="inner-page__grid">
      <InnerPageHeader activePage="research" />
      <main class="inner-page__main research-page research-stage">
        <div class="research-grid">
          {researchItems.map((item) => {
            const label = item.caption || item.alt || `Research ${item.number}`;
            const spanW = item.spanW === 4 ? 4 : 2;
            const spanH = item.spanH === 4 ? 4 : 2;
            const mediaSrc = resolveMediaSrc(item.src);
            return (
            <div
              class:list={[
                'research-card',
                spanW === 4 && 'research-card--w4',
                spanH === 4 && 'research-card--h4',
              ]}
              data-media-type={item.as || 'image'}
              data-media-src={mediaSrc}
              data-media-alt={item.alt || label}
              data-media-caption={item.caption || ''}
              data-media-date={item.date || ''}
            >
              <span class="research-card__name">{item.caption || ''}</span>
              <div class="research-card__image" style={`--research-ar: ${item.aspectRatio}`}>
                {item.as === 'kinescope' ? (
                  <iframe
                    src={getKinescopeEmbedUrl(item.src)}
                    title={item.alt || label}
                    loading="lazy"
                    frameborder="0"
                    allow="autoplay; fullscreen; picture-in-picture"
                    allowfullscreen
                  />
                ) : (
                  <img src={mediaSrc} alt={item.alt || label} />
                )}
                <button class="research-card__open" type="button" aria-label={`Open ${label}`} />
              </div>
              <span class="research-card__date">{item.date || ''}</span>
            </div>
            );
          })}
        </div>
      </main>
    </div>
  </div>
</BaseLayout>

<style>
  :global(.research-lightbox-open .page-header) {
    opacity: 0;
    visibility: hidden;
  }

  :global(.research-lightbox-open .research-stage) {
    filter: blur(15px);
    opacity: 0.5;
    pointer-events: none;
    user-select: none;
  }

  :global(.research-card__open) {
    position: absolute;
    inset: 0;
    z-index: 2;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  :global(.research-card__open:focus),
  :global(.research-card__open:focus-visible) {
    outline: none;
    box-shadow: none;
  }

  :global(.research-lightbox) {
    position: fixed;
    inset: 0;
    z-index: 1200;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0 40px;
  }

  :global(.research-lightbox.is-open) {
    display: flex;
  }

  :global(.research-lightbox__zone) {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    z-index: 1;
    border: 0;
    background: transparent;
  }

  :global(.research-lightbox__zone--left) {
    left: 0;
    cursor: pointer;
  }

  :global(.research-lightbox__zone--right) {
    right: 0;
    cursor: pointer;
  }

  :global(.research-lightbox__media-wrap) {
    position: relative;
    z-index: 3;
    max-width: min(90vw, 1400px);
    max-height: max(220px, calc(100vh - 300px));
    width: auto;
    height: auto;
    cursor: pointer;
  }

  :global(.research-lightbox__media-wrap img),
  :global(.research-lightbox__media-wrap iframe) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: max(220px, calc(100vh - 300px));
    margin: 0 auto;
  }

  :global(.research-lightbox__media-wrap),
  :global(.research-lightbox__media-wrap:focus),
  :global(.research-lightbox__media-wrap:focus-visible),
  :global(.research-lightbox__media-wrap img:focus),
  :global(.research-lightbox__media-wrap iframe:focus),
  :global(.research-lightbox__arrow:focus),
  :global(.research-lightbox__arrow:focus-visible),
  :global(.research-lightbox__zone:focus),
  :global(.research-lightbox__zone:focus-visible) {
    outline: none;
    box-shadow: none;
  }

  :global(.research-lightbox__media-wrap iframe) {
    width: min(90vw, 1400px);
    height: max(220px, calc(100vh - 300px));
    border: 0;
  }

  :global(.research-lightbox__meta) {
    position: fixed;
    bottom: 50px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 4;
    text-align: center;
    font-family: 'SuisseIntl', sans-serif;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.2;
    color: #000;
    white-space: nowrap;
  }

  :global(.research-lightbox__close) {
    position: fixed;
    top: 50px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 4;
    border: 0;
    background: transparent;
    text-align: center;
    font-family: 'SuisseIntl', sans-serif;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.2;
    color: #000;
    cursor: pointer;
  }

  :global(.research-lightbox__close:focus),
  :global(.research-lightbox__close:focus-visible) {
    outline: none;
    box-shadow: none;
  }

</style>

<script>
  (function () {
    function extractIframeSrc(raw) {
      const s = String(raw || '').trim();
      const m = s.match(/<iframe[\s\S]*?src=["']([^"']+)["']/i);
      if (m && m[1]) return m[1].trim();
      return s;
    }

    function getKinescopeEmbedUrl(raw, withSound) {
      const s = extractIframeSrc(raw);
      if (!s) return '';
      function tuneUrl(url) {
        try {
          const u = new URL(url);
          u.searchParams.set('autoplay', '1');
          if (withSound) {
            u.searchParams.delete('muted');
            u.searchParams.delete('mute');
            u.searchParams.set('muted', '0');
          } else {
            u.searchParams.set('muted', '1');
          }
          return u.toString();
        } catch (_) {
          return url;
        }
      }
      if (/kinescope\.(io|ru)\/embed\//.test(s)) {
        return tuneUrl(s);
      }
      const m = s.match(/https?:\/\/(?:kinescope\.(?:io|ru))\/([^/?#]+)/);
      if (m && m[1]) return tuneUrl('https://kinescope.io/embed/' + m[1]);
      return s;
    }

    const grid = document.querySelector('.research-grid');
    const sourceCards = Array.from(document.querySelectorAll('.research-card'));
    if (!grid || sourceCards.length === 0) return;

    const loopCount = sourceCards.length;
    sourceCards.forEach(function (card, i) {
      card.setAttribute('data-loop-index', String(i));
      card.setAttribute('data-loop-copy', '1');
    });

    const beforeFrag = document.createDocumentFragment();
    const afterFrag = document.createDocumentFragment();
    sourceCards.forEach(function (card, i) {
      const before = card.cloneNode(true);
      before.setAttribute('data-loop-copy', '0');
      beforeFrag.appendChild(before);
      const after = card.cloneNode(true);
      after.setAttribute('data-loop-copy', '2');
      afterFrag.appendChild(after);
    });
    grid.insertBefore(beforeFrag, sourceCards[0]);
    grid.appendChild(afterFrag);

    const cards = Array.from(grid.querySelectorAll('.research-card'));
    let activeIndex = -1;
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';

    const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const copyFirst = [0, 1, 2].map(function (copy) {
      return grid.querySelector('.research-card[data-loop-copy="' + copy + '"]');
    });

    let ticking = false;
    let isJumping = false;
    let didPlaceMiddle = false;

    function periodPx() {
      if (!copyFirst[0] || !copyFirst[1]) return 0;
      return copyFirst[1].offsetTop - copyFirst[0].offsetTop;
    }

    function applyScale() {
      if (reduceMotion) {
        cards.forEach(function (card) {
          const wrap = card.querySelector('.research-card__image');
          if (wrap) wrap.style.transform = 'none';
        });
        return;
      }
      const viewCenter = window.innerHeight / 2;
      const falloff = Math.max(180, window.innerHeight * 0.45);
      cards.forEach(function (card) {
        const wrap = card.querySelector('.research-card__image');
        if (!wrap) return;
        const rect = card.getBoundingClientRect();
        const mid = rect.top + rect.height / 2;
        const dist = (mid - viewCenter) / falloff;
        const t = Math.exp(-2.2 * dist * dist);
        wrap.style.transform = 'scale(' + (1 + t) + ')';
        wrap.style.zIndex = String(Math.round(2 + t * 10));
      });
    }

    function wrapLoop() {
      const period = periodPx();
      if (period < 80 || !copyFirst[1]) return;
      const y = window.scrollY;
      const view = y + window.innerHeight / 2;
      const copy1Top = copyFirst[1].getBoundingClientRect().top + y;
      const copy2Top = copy1Top + period;
      let next = y;
      if (view < copy1Top) next = y + period;
      else if (view >= copy2Top) next = y - period;
      if (next === y) return;
      isJumping = true;
      window.scrollTo(0, next);
      isJumping = false;
    }

    function placeMiddleCopy() {
      if (didPlaceMiddle || periodPx() < 80 || !copyFirst[1]) return;
      const top = copyFirst[1].getBoundingClientRect().top + window.scrollY;
      didPlaceMiddle = true;
      isJumping = true;
      window.scrollTo(0, Math.max(0, top - 300));
      isJumping = false;
    }

    function update() {
      if (document.body.classList.contains('research-lightbox-open')) return;
      if (!didPlaceMiddle) placeMiddleCopy();
      wrapLoop();
      applyScale();
    }

    function requestUpdate() {
      if (isJumping || ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        ticking = false;
        update();
      });
    }

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
    requestUpdate();

    const lightbox = document.createElement('div');
    lightbox.className = 'research-lightbox';
    lightbox.innerHTML =
      '<button class="research-lightbox__close" type="button" aria-label="Close">Close</button>' +
      '<button class="research-lightbox__zone research-lightbox__zone--left" type="button" aria-label="Previous slide"></button>' +
      '<button class="research-lightbox__zone research-lightbox__zone--right" type="button" aria-label="Next slide"></button>' +
      '<div class="research-lightbox__media-wrap"></div>' +
      '<div class="research-lightbox__meta" aria-live="polite"></div>';
    document.body.appendChild(lightbox);

    const closeBtn = lightbox.querySelector('.research-lightbox__close');
    const mediaWrap = lightbox.querySelector('.research-lightbox__media-wrap');
    const meta = lightbox.querySelector('.research-lightbox__meta');
    const leftZone = lightbox.querySelector('.research-lightbox__zone--left');
    const rightZone = lightbox.querySelector('.research-lightbox__zone--right');

    function closeLightbox() {
      lightbox.classList.remove('is-open');
      document.body.classList.remove('research-lightbox-open');
      mediaWrap.innerHTML = '';
      meta.textContent = '';
      activeIndex = -1;
      const focused = document.activeElement;
      if (focused && typeof focused.blur === 'function') focused.blur();
    }

    function renderLightboxByIndex(index) {
      const safeIndex = ((index % loopCount) + loopCount) % loopCount;
      const card = grid.querySelector('.research-card[data-loop-copy="1"][data-loop-index="' + safeIndex + '"]') || cards[safeIndex];
      const type = card.getAttribute('data-media-type') || 'image';
      const src = card.getAttribute('data-media-src') || '';
      const alt = card.getAttribute('data-media-alt') || '';
      const caption = card.getAttribute('data-media-caption') || '';
      const date = card.getAttribute('data-media-date') || '';

      if (!src) return;
      activeIndex = safeIndex;
      mediaWrap.innerHTML = '';

      if (type === 'kinescope') {
        const iframe = document.createElement('iframe');
        iframe.src = getKinescopeEmbedUrl(src, true);
        iframe.title = alt || 'Research video';
        iframe.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture');
        iframe.setAttribute('allowfullscreen', '');
        iframe.setAttribute('loading', 'lazy');
        mediaWrap.appendChild(iframe);
      } else {
        const img = document.createElement('img');
        img.src = src;
        img.alt = alt || 'Research image';
        img.loading = 'eager';
        mediaWrap.appendChild(img);
      }

      const metaParts = [caption, date].filter(Boolean);
      meta.textContent = metaParts.join(' — ');
    }

    function openLightbox(index) {
      renderLightboxByIndex(index);
      lightbox.classList.add('is-open');
      document.body.classList.add('research-lightbox-open');
    }

    function nextSlide() {
      if (activeIndex < 0) return;
      renderLightboxByIndex(activeIndex + 1);
    }

    function prevSlide() {
      if (activeIndex < 0) return;
      renderLightboxByIndex(activeIndex - 1);
    }

    cards.forEach(function (card) {
      const trigger = card.querySelector('.research-card__open');
      if (!trigger) return;
      trigger.addEventListener('click', function () {
        openLightbox(Number(card.getAttribute('data-loop-index')) || 0);
      });
    });

    mediaWrap.addEventListener('click', closeLightbox);
    closeBtn.addEventListener('click', closeLightbox);
    leftZone.addEventListener('click', prevSlide);
    rightZone.addEventListener('click', nextSlide);

    window.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeLightbox();
      if (!lightbox.classList.contains('is-open')) return;
      if (e.key === 'ArrowLeft') prevSlide();
      if (e.key === 'ArrowRight') nextSlide();
    });
  })();
</script>
