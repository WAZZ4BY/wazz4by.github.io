---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" href={base + 'images/icon/icon.webp'} />
    <link rel="icon" type="image/png" href={base + 'images/icon/icon.png'} />
    <title>{title}</title>
    <style is:global>
      .admin-page { min-height: 100vh; background: #f5f5f5; padding: 2rem; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
      .admin-page * { box-sizing: border-box; }
      .admin-page h1 { margin-top: 0; font-size: 1.5rem; }
      .admin-page a { color: #0066cc; text-decoration: none; }
      .admin-page a:hover { text-decoration: underline; }
      .admin-section { background: #fff; padding: 1.5rem; margin-bottom: 1.5rem; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); max-width: 720px; }
      .admin-section.admin-section--wide { max-width: none; width: 100%; }
      .admin-section h2 { margin: 0 0 1rem; font-size: 1.15rem; }
      .admin-page label { display: block; margin-bottom: 0.25rem; font-weight: 500; font-size: 0.9rem; }
      .admin-page input[type="text"], .admin-page input[type="password"], .admin-page input[type="url"], .admin-page input[type="date"], .admin-page textarea, .admin-page select { width: 100%; padding: 0.5rem 0.75rem; margin-bottom: 1rem; font-size: 1rem; border: 1px solid #ddd; border-radius: 4px; }
      .admin-page textarea { min-height: 80px; resize: vertical; }
      .admin-page button { padding: 0.5rem 1rem; font-size: 0.95rem; cursor: pointer; border-radius: 4px; border: none; }
      .admin-page button.primary { background: #000; color: #fff; }
      .admin-page button.primary:hover { background: #333; }
      .admin-page button.danger { background: #c00; color: #fff; }
      .admin-page button.danger:hover { background: #a00; }
      .admin-page button.secondary { background: #e0e0e0; color: #000; }
      .admin-page button.secondary:hover { background: #ccc; }
      .admin-page .gate { max-width: 360px; margin: 4rem auto; padding: 2rem; background: #fff; border-radius: 8px; box-shadow: 0 2px 12px rgba(0,0,0,0.1); }
      .admin-page .gate input { margin-bottom: 1rem; }
      .admin-page .gate .error { color: #c00; font-size: 0.9rem; margin-top: 0.5rem; }
      .admin-page .status { font-size: 0.9rem; margin-top: 0.5rem; }
      .admin-page .status.ok { color: #080; }
      .admin-page .status.err { color: #c00; }
      .admin-page .project-list { list-style: none; padding: 0; margin: 0; }
      .admin-page .project-list li { display: flex; align-items: center; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px solid #eee; gap: 0.75rem; }
      .admin-page .project-list li.project-list__item--hidden { opacity: 0.55; }
      .admin-page .project-list__title { display: flex; align-items: center; gap: 0.5rem; min-width: 0; }
      .admin-page .project-list__badge { flex-shrink: 0; font-size: 0.75rem; font-weight: 600; color: #666; background: #eee; padding: 0.15rem 0.45rem; border-radius: 999px; }
      .admin-page .project-list__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; justify-content: flex-end; }
      .admin-page .project-list li:last-child { border-bottom: none; }
      .admin-page .project-list a { margin-right: 0.5rem; }
      .admin-page .mb-2 { margin-bottom: 1.5rem; }
      .admin-page .images-grid-editor { margin-bottom: 1rem; }
      .admin-page .images-grid-editor__list { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 0.75rem; }
      .admin-page .image-row { display: flex; gap: 0.5rem; align-items: center; }
      .admin-page .image-row input { flex: 1; margin-bottom: 0; }
      .admin-page .image-row .remove-img { flex-shrink: 0; }
      .admin-page .img-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 0.75rem; }
      .admin-page .img-grid__item { position: relative; background: #eee; border-radius: 6px; overflow: hidden; aspect-ratio: 4/3; }
      .admin-page .img-grid__item img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .admin-page .img-grid__item .img-grid__url { position: absolute; bottom: 0; left: 0; right: 0; padding: 4px 6px; font-size: 0.75rem; background: rgba(0,0,0,0.6); color: #fff; border: none; width: 100%; }
      .admin-page .img-grid__item .img-grid__actions { position: absolute; top: 4px; right: 4px; display: flex; gap: 4px; }
      .admin-page .img-grid__item .img-grid__actions button { padding: 4px 8px; font-size: 0.8rem; min-width: auto; }
      .admin-page .img-grid__item.dragging { opacity: 0.5; }
      .admin-page .img-grid__item.drag-over { border: 2px dashed #000; }
      .admin-page .img-grid__placeholder { display: flex; align-items: center; justify-content: center; height: 100%; font-size: 0.8rem; color: #999; }
      .admin-page .img-grid__item.img-error img { opacity: 0.5; }
      .admin-page .admin-hint { font-size: 0.85rem; color: #666; margin: -0.5rem 0 0.75rem; }
      .admin-page .admin-color-row { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; }
      .admin-page .admin-color-row input[type="color"] { width: 48px; height: 38px; padding: 2px; cursor: pointer; border: 1px solid #ddd; border-radius: 4px; }
      .admin-page .admin-color-row input[type="text"] { flex: 1; margin-bottom: 0; }
      .admin-page .admin-checkbox-label { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem; font-weight: 500; font-size: 0.9rem; }
      .admin-page .admin-checkbox-label input[type="checkbox"] { width: auto; margin: 0; }
      .admin-page .content-blocks-list { display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 0.75rem; }
      .admin-page .content-blocks-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; }
      .admin-page .content-block-card { padding: 1rem; background: #f9f9f9; border: 1px solid #e0e0e0; border-radius: 6px; }
      .admin-page .content-block-card__row { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem; }
      .admin-page .content-block-card__type { font-weight: 600; font-size: 0.9rem; flex: 1; }
      .admin-page .content-block-card__textarea { width: 100%; margin-bottom: 0; min-height: 60px; }
      .admin-page .content-block-card__url { width: 100%; margin-bottom: 0.5rem; }
      .admin-page .content-block-card__url:last-of-type { margin-bottom: 0; }
      .admin-page .content-block-card__split-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
      .admin-page .content-block-card .move-up, .admin-page .content-block-card .move-down, .admin-page .content-block-card .remove-block { padding: 4px 8px; font-size: 0.8rem; min-width: auto; }
      .admin-page .content-block-card__preview { margin-top: 0.5rem; max-height: 200px; border-radius: 6px; overflow: hidden; background: #eee; display: flex; align-items: center; justify-content: center; min-height: 80px; }
      .admin-page .content-block-card__preview img { max-width: 100%; max-height: 200px; width: auto; height: auto; display: block; object-fit: contain; }
      .admin-page .content-block-card__preview-img--error { opacity: 0.4; }
      .admin-page .content-block-card__preview--split { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
      .admin-page .content-block-card__preview-item { max-height: 160px; background: #eee; border-radius: 6px; overflow: hidden; display: flex; align-items: center; justify-content: center; min-height: 60px; }
      .admin-page .content-block-card__preview-item img { max-width: 100%; max-height: 160px; width: auto; height: auto; object-fit: contain; }
      .admin-page .awards-list { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 0; }
      .admin-page .award-row { display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.5rem; }
      .admin-page .award-row .award-place { flex: 1; margin-bottom: 0; }
      .admin-page .award-row .award-festival { flex: 1; margin-bottom: 0; }
      .admin-page .award-row .award-nomination { flex: 1; margin-bottom: 0; }
      .admin-page .award-row .remove-award { flex-shrink: 0; padding: 4px 8px; font-size: 0.9rem; }
      .admin-page .links-list { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 0; }
      .admin-page .link-row { display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.5rem; }
      .admin-page .link-row .project-link-text { flex: 1; margin-bottom: 0; }
      .admin-page .link-row .project-link-url { flex: 1; margin-bottom: 0; }
      .admin-page .link-row .remove-link { flex-shrink: 0; padding: 4px 8px; font-size: 0.9rem; }
      .admin-page .credits-list { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 0; }
      .admin-page .credit-row { display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.5rem; }
      .admin-page .credit-row .credit-role { flex: 1; margin-bottom: 0; }
      .admin-page .credit-row .credit-name { flex: 1; margin-bottom: 0; }
      .admin-page .credit-row .credit-url { flex: 1; margin-bottom: 0; }
      .admin-page .credit-row .remove-credit { flex-shrink: 0; padding: 4px 8px; font-size: 0.9rem; }
      .research-admin-site-list { display: flex; flex-direction: column; gap: 1rem; max-width: 720px; margin: 0 auto; }
      .research-admin-site__row { border: 1px solid #ddd; border-radius: 8px; background: #fff; overflow: hidden; cursor: grab; }
      .research-admin-site__head { display: flex; align-items: center; gap: 0.65rem; padding: 0.55rem 0.85rem; border-bottom: 1px solid #ececec; font-size: 0.85rem; color: #444; }
      .research-admin-site { background: #000; min-height: 420px; }
      .research-admin-site__stage { position: relative; min-height: 420px; display: flex; align-items: center; justify-content: center; padding: 48px 24px 72px; box-sizing: border-box; }
      .research-admin-site__cover { overflow: hidden; background: #111; display: flex; align-items: center; justify-content: center; }
      .research-admin-site__cover--w2 { width: 22%; max-width: 160px; }
      .research-admin-site__cover--w4 { width: 42%; max-width: 280px; }
      .research-admin-site__cover--w6 { width: 58%; max-width: 380px; }
      .research-admin-site__cover--w8 { width: 72%; max-width: 480px; }
      .research-admin-site__cover--height { height: 320px; width: auto; max-width: 72%; }
      .research-admin-site__cover--height img, .research-admin-site__cover--height video { width: auto; height: 100%; max-width: 100%; display: block; }
      .research-admin-site__cover:not(.research-admin-site__cover--height) img,
      .research-admin-site__cover:not(.research-admin-site__cover--height) video { width: 100%; height: auto; display: block; }
      .research-admin-site__cover iframe { width: 100%; aspect-ratio: 16 / 9; display: block; border: 0; }
      .research-admin-site__cover--height iframe { width: auto; height: 100%; aspect-ratio: 16 / 9; max-width: 100%; }
      .research-admin-site__info { position: absolute; left: 50%; bottom: 18px; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 10px; width: min(420px, calc(100% - 32px)); pointer-events: none; }
      .research-admin-site__chips { display: flex; flex-direction: column; align-items: center; gap: 10px; width: 100%; }
      .research-admin-site__chip { appearance: none; color: #fff; line-height: 0.9; letter-spacing: -0.03em; white-space: nowrap; backdrop-filter: blur(1rem); -webkit-backdrop-filter: blur(1rem); background-color: rgba(255, 255, 255, 0.1); border: none; font-size: 14px; font-weight: 500; padding: 6px 12px; border-radius: 20px; text-align: center; max-width: 100%; display: flex; justify-content: center; align-items: center; }
      .research-admin-site__chip--text { font-size: 12px; line-height: 1; white-space: pre-wrap; width: min(100%, 280px); mix-blend-mode: soft-light; }
      .research-admin-site__plus { width: 42px; height: 42px; border-radius: 50%; appearance: none; color: #fff; backdrop-filter: blur(1rem); -webkit-backdrop-filter: blur(1rem); background-color: rgba(255, 255, 255, 0.1); border: none; display: flex; align-items: center; justify-content: center; font-size: 22px; line-height: 1; }
      .research-admin-site__meta { position: absolute; top: 12px; right: 12px; color: rgba(255,255,255,0.55); font-size: 11px; }
      .research-admin-site__inner-label { padding: 0.55rem 0.85rem; font-size: 0.78rem; font-weight: 600; color: #666; background: #f7f7f7; border-top: 1px solid #ececec; border-bottom: 1px solid #ececec; }
      .research-admin-site__screens { display: flex; flex-direction: column; gap: 0.75rem; padding: 0.85rem; background: #111; }
      .research-admin-site__screens-empty { padding: 1rem 0.85rem; color: #888; font-size: 0.85rem; background: #111; }
      .research-admin-site__screen { display: flex; flex-direction: column; gap: 0.35rem; }
      .research-admin-site__screen-label { color: rgba(255,255,255,0.55); font-size: 11px; }
      .research-admin-site__screen-row { display: flex; align-items: center; justify-content: center; gap: 10px; min-height: 160px; padding: 12px; box-sizing: border-box; background: #000; border: 1px solid #222; }
      .research-admin-site__cell { position: relative; flex: 0 0 auto; overflow: hidden; background: #151515; display: flex; align-items: center; justify-content: center; }
      .research-admin-site__cell--cols { width: calc(var(--rf-span, 4) * 7.2%); max-width: 72%; aspect-ratio: 4 / 3; }
      .research-admin-site__cell--w2.research-admin-site__cell--cols { width: 16%; }
      .research-admin-site__cell--w4.research-admin-site__cell--cols { width: 32%; }
      .research-admin-site__cell--w6.research-admin-site__cell--cols { width: 48%; }
      .research-admin-site__cell--w8.research-admin-site__cell--cols { width: 64%; }
      .research-admin-site__cell--height { height: 140px; width: auto; max-width: 72%; aspect-ratio: 3 / 4; }
      .research-admin-site__cell img, .research-admin-site__cell video { width: 100%; height: 100%; object-fit: contain; display: block; }
      .research-admin-site__cell--height img, .research-admin-site__cell--height video { width: auto; height: 100%; max-width: 100%; }
      .research-admin-site__cell-meta { position: absolute; left: 4px; bottom: 4px; font-size: 10px; color: rgba(255,255,255,0.7); background: rgba(0,0,0,0.45); padding: 1px 4px; border-radius: 3px; }
      .research-admin-site__cell-empty, .research-admin-site__cell-embed { color: #777; font-size: 11px; }
      .research-admin-site__screens-edit { padding: 0.75rem 0.85rem 1rem; background: #fff; border-top: 1px solid #ececec; }
      .research-admin-site__screens-edit .research-admin-list__screens-label { margin-bottom: 0.5rem; }
      .research-admin-list { display: flex; flex-direction: column; gap: 0.85rem; }
      .research-admin-list__card { padding: 1rem 1.15rem; border: 1px solid #ddd; border-radius: 8px; background: #fff; min-height: calc((100vh - 17rem) / 3); }
      .research-admin-list__inner { display: grid; grid-template-columns: 220px minmax(0, 1fr) auto; gap: 0.9rem 1.1rem; align-items: stretch; min-height: 220px; }
      .research-admin-list__thumb { width: 220px; height: 220px; border: 1px solid #eee; background: #f8f8f8; overflow: hidden; display: flex; align-items: center; justify-content: center; align-self: center; }
      .research-admin-list__thumb img, .research-admin-list__thumb iframe { width: 100%; height: 100%; object-fit: contain; display: block; border: 0; }
      .research-admin-list__fields { display: flex; flex-direction: column; gap: 0.65rem; min-width: 0; justify-content: center; }
      .research-admin-list__row { display: flex; flex-wrap: wrap; gap: 0.55rem 0.7rem; align-items: end; }
      .research-admin-list__row label { margin: 0; font-size: 0.8rem; font-weight: 500; color: #555; display: flex; flex-direction: column; gap: 0.2rem; }
      .research-admin-list__grow { flex: 1 1 160px; min-width: 0; }
      .research-admin-list__num { width: 5.2rem; flex: 0 0 5.2rem; }
      .research-admin-list__as { width: 8.4rem; flex: 0 0 8.4rem; }
      .research-admin-list__span { width: 8.2rem; flex: 0 0 8.2rem; }
      .research-admin-list__date { width: 7.2rem; flex: 0 0 7.2rem; }
      .research-admin-list input, .research-admin-list select, .research-admin-list textarea { margin-bottom: 0 !important; padding: 0.5rem 0.65rem !important; font-size: 0.95rem !important; }
      .research-admin-list textarea { min-height: 4.6rem !important; resize: vertical; }
      .research-admin-list__actions { display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; gap: 0.5rem; }
      .research-admin-list__actions button { padding: 0.4rem 0.7rem; font-size: 0.9rem; }
      .research-admin-list__screens-label { font-size: 0.8rem; font-weight: 500; color: #555; margin-top: 0.15rem; }
      .research-admin-extras { display: flex; flex-wrap: wrap; gap: 0.65rem; align-items: stretch; }
      .research-admin-screen { min-width: 220px; max-width: 100%; flex: 1 1 240px; display: flex; flex-direction: column; gap: 0.4rem; padding: 0.5rem; border: 1px solid #e5e5e5; border-radius: 8px; background: #fafafa; }
      .research-admin-screen__head { display: flex; align-items: center; justify-content: space-between; gap: 0.35rem; font-size: 0.75rem; font-weight: 600; color: #666; }
      .research-admin-screen__head button { padding: 0.1rem 0.4rem; font-size: 0.75rem; min-width: auto; }
      .research-admin-screen__items { display: flex; flex-wrap: wrap; gap: 0.4rem; }
      .research-admin-media { width: 128px; display: flex; flex-direction: column; gap: 0.25rem; }
      .research-admin-extra__thumb { width: 128px; height: 96px; border: 1px solid #eee; background: #f4f4f4; overflow: hidden; display: flex; align-items: center; justify-content: center; }
      .research-admin-extra__thumb img, .research-admin-extra__thumb video { width: 100%; height: 100%; object-fit: contain; display: block; background: #111; }
      .research-admin-media input[type="text"], .research-admin-media select { width: 100%; margin-bottom: 0 !important; padding: 0.25rem 0.35rem !important; font-size: 0.72rem !important; }
      .research-admin-extra__btns { display: flex; gap: 0.25rem; }
      .research-admin-extra__btns button { padding: 0.2rem 0.35rem; font-size: 0.72rem; flex: 1; }
      .research-admin-screen > .secondary { align-self: flex-start; padding: 0.25rem 0.5rem; font-size: 0.75rem; }
      .research-admin-extras__add { align-self: stretch; min-height: 140px; min-width: 112px; display: flex; align-items: center; justify-content: center; border: 1px dashed #bbb; background: #fafafa; color: #333; font-size: 0.85rem; }
      .home-admin-preview { background: #fbfbfb; border: 1px solid #e5e5e5; border-radius: 8px; overflow: hidden; margin-bottom: 1rem; }
      .home-admin-preview__label { padding: 0.65rem 1rem; font-size: 0.8rem; color: #666; border-bottom: 1px solid #ececec; background: #fff; }
      .home-admin-preview__stage { padding: 0; }
      .home-admin-preview__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 0; width: 100%; min-width: 0; }
      .home-admin-preview__item { min-width: 0; grid-column: var(--home-card-col, span 4); }
      .home-admin-preview__card { width: 100%; min-width: 0; }
      .home-admin-preview__thumb { position: relative; width: 100%; overflow: hidden; min-width: 0; background: #f3f3f3; }
      .home-admin-preview__thumb.aspect-16-9 { aspect-ratio: 16 / 9; }
      .home-admin-preview__thumb.aspect-4-5 { aspect-ratio: 4 / 5; }
      .home-admin-preview__thumb.aspect-3-4 { aspect-ratio: 3 / 4; }
      .home-admin-preview__thumb.aspect-1-1 { aspect-ratio: 1 / 1; }
      .home-admin-preview__thumb.aspect-original { aspect-ratio: auto; }
      .home-admin-preview__thumb.aspect-free { aspect-ratio: auto; }
      .home-admin-preview__media { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center; border: 0; }
      .home-admin-preview__thumb.aspect-original .home-admin-preview__media,
      .home-admin-preview__thumb.aspect-free .home-admin-preview__media { height: auto; object-fit: contain; }
      .home-admin-preview__embed { pointer-events: none; }
      .home-admin-preview__empty { padding: 2.5rem 1rem; text-align: center; color: #888; font-size: 0.9rem; }
      @media (max-width: 980px) {
        .home-admin-preview__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .home-admin-preview__item { grid-column: span 1 !important; }
      }
      @media (max-width: 640px) {
        .home-admin-preview__grid { grid-template-columns: 1fr; }
      }
      .home-admin-layout { background: #fbfbfb; border: 1px solid #e5e5e5; border-radius: 8px; overflow: hidden; margin-bottom: 1rem; }
      .home-admin-layout__label { padding: 0.65rem 1rem; font-size: 0.8rem; color: #666; border-bottom: 1px solid #ececec; background: #fff; line-height: 1.4; }
      .home-admin-layout__stage { position: relative; padding: 0; }
      .home-admin-layout__guides { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); pointer-events: none; z-index: 0; }
      .home-admin-layout__guide { border-right: 1px dashed rgba(0, 0, 0, 0.06); }
      .home-admin-layout__guide:first-child { border-left: 1px dashed rgba(0, 0, 0, 0.06); }
      .home-admin-layout__grid { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 0; width: 100%; min-width: 0; }
      .home-admin-layout__item { min-width: 0; grid-column: var(--home-card-col, span 4); transition: grid-column 0.15s ease, opacity 0.15s ease; }
      .home-admin-layout__item--dragging { opacity: 0.45; }
      .home-admin-layout__item--over { outline: 2px dashed #111; outline-offset: -2px; }
      .home-admin-layout__card { position: relative; background: #fff; border: 1px solid #ddd; margin: 2px; border-radius: 4px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
      .home-admin-layout__toolbar { display: flex; align-items: center; gap: 0.45rem; padding: 0.35rem 0.5rem; background: #fafafa; border-bottom: 1px solid #ececec; font-size: 0.78rem; min-width: 0; }
      .home-admin-layout__grip { cursor: grab; color: #888; font-size: 0.9rem; flex-shrink: 0; user-select: none; }
      .home-admin-layout__num { font-weight: 700; color: #333; flex-shrink: 0; }
      .home-admin-layout__meta { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #555; }
      .home-admin-layout__badge { flex-shrink: 0; font-size: 0.72rem; color: #666; background: #eee; padding: 0.1rem 0.35rem; border-radius: 999px; }
