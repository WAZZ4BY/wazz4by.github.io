---
import SiteHeader from '../components/SiteHeader.astro';
import MobileGlobalNav from '../components/MobileGlobalNav.astro';
import '../styles/global.css';

interface Props {
  title: string;
  variant?: 'home' | 'inner';
  bodyClass?: string;
  hideHeader?: boolean;
  themeColor?: string;
}

const { title, variant = 'inner', bodyClass, hideHeader, themeColor = '#FBFBFB' } = Astro.props;
const bodyClasses = [variant === 'home' ? 'is-home' : 'is-inner', bodyClass].filter(Boolean).join(' ');
const documentTitle = variant === 'home' || !title || title === 'Vasilii Aleev'
  ? 'Vasilii Aleev'
  : `${title} — Vasilii Aleev`;
---

<!doctype html>
<html lang="ru" style={`--page-bg: ${themeColor}; background-color: ${themeColor};`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Vasilii Aleev - Portfolio" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" type="image/webp" href={import.meta.env.BASE_URL + 'images/icon/icon.webp'} />
    <link rel="icon" type="image/png" href={import.meta.env.BASE_URL + 'images/icon/icon.png'} />
    <meta name="generator" content={Astro.generator} />
    <title>{documentTitle}</title>
  </head>
  <body class={bodyClasses} style={`--page-bg: ${themeColor}; background-color: ${themeColor};`}>
    <div class="page-backdrop" aria-hidden="true" style={`background-color: ${themeColor};`}></div>
    {!hideHeader && <SiteHeader variant={variant} />}
    <MobileGlobalNav />
    <slot />
  </body>
</html>
